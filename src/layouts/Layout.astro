---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "System Analyst Workstation | Windows XP Experience",
  description = "Interactive System Analyst portfolio featuring a retro 3D workstation, SDLC specifications, and an authentic Windows XP desktop."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0055ea" />

    <!-- Google Fonts for XP: Tahoma, Trebuchet MS, Segoe UI, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="w-screen h-screen m-0 p-0 overflow-hidden bg-black text-slate-900 select-none font-sans">
    <slot />
  </body>
</html>
