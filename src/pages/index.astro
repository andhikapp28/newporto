---
import Layout from '../layouts/Layout.astro';
import XpPreloader from '../components/XpPreloader.astro';
import ThreeComputerScene from '../components/ThreeComputerScene.astro';
import XpDesktop from '../components/XpDesktop.astro';
---

<Layout 
  title="System Analyst Workstation | Interactive 3D & Windows XD Experience"
  description="Interactive System Analyst portfolio featuring a retro 3D computer workstation, SDLC architecture specifications, and an authentic Windows XD draggable desktop."
>
  <main class="relative w-screen h-screen overflow-hidden bg-black select-none">
    <!-- Stage 1: Circular 0-100% Preloader (Image 1 style) -->
    <XpPreloader />

    <!-- Stage 2: 3D Retro Workstation with Three.js (Image 2 & Threejs Journey style) -->
    <ThreeComputerScene />

    <!-- Stage 3: Interactive Windows XP Draggable Desktop (Image 3 style) -->
    <XpDesktop />
  </main>
</Layout>
