---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SdlcLensWidget from '../components/SdlcLensWidget.astro';
import ThreePillars from '../components/ThreePillars.astro';
import InteractiveFlow from '../components/InteractiveFlow.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Methodology from '../components/Methodology.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main class="flex-grow">
    <Hero />
    <SdlcLensWidget />
    <ThreePillars />
    <InteractiveFlow />
    <CaseStudies />
    <Methodology />
    <ContactSection />
  </main>
  <Footer />
</Layout>
