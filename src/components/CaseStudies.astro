---
import { getCollection } from 'astro:content';
import { ArrowUpRight, CheckCircle, TrendingUp, Layers, FileSpreadsheet } from '@lucide/astro';

const allProjects = await getCollection('projects');
---

<section id="case-studies" class="py-16 md:py-24 border-t border-slate-800/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-cyan-500/30 bg-cyan-950/30 text-cyan-300 text-xs font-mono mb-4">
          <FileSpreadsheet class="w-3.5 h-3.5" />
          <span>Proven Impact & System Artifacts</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-bold text-slate-100 tracking-tight">
          Featured Architecture Case Studies
        </h2>
        <p class="text-slate-400 text-sm sm:text-base mt-2 max-w-2xl leading-relaxed">
          Real-world technical problem solving. Each case study documents the business requirements, architecture trade-offs, developer API contracts, and QA test matrices.
        </p>
      </div>

      <div class="text-xs font-mono text-slate-400 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span>{allProjects.length} Full Technical Specs Available</span>
      </div>
    </div>

    <!-- Grid of Projects -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allProjects.map((project) => (
        <article class="rounded-2xl border border-slate-800 bg-slate-900/40 hover:border-slate-700/80 transition-all duration-300 flex flex-col justify-between group hover:shadow-2xl hover:shadow-cyan-950/10 overflow-hidden">
          <div class="p-6 sm:p-7">
            <!-- Top meta -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-[11px] font-mono font-medium px-2.5 py-1 rounded-full bg-slate-800 border border-slate-700/80 text-cyan-300">
                {project.data.category}
              </span>
              <span class="text-xs font-mono text-slate-400">
                {project.data.period}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-lg sm:text-xl font-bold text-slate-100 group-hover:text-cyan-300 transition-colors leading-snug mb-2">
              <a href={`/projects/${project.id}`} class="focus:outline-none">
                {project.data.title}
              </a>
            </h3>

            <!-- Role & Client -->
            <div class="text-xs text-slate-400 mb-4 flex flex-wrap items-center gap-x-2 gap-y-1">
              <span class="text-slate-300 font-medium">Role: {project.data.role}</span>
              <span>•</span>
              <span>{project.data.client}</span>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6 line-clamp-3">
              {project.data.description}
            </p>

            <!-- Metrics Preview Row -->
            <div class="grid grid-cols-3 gap-2 py-3 px-3 rounded-xl bg-slate-950/80 border border-slate-800/80 mb-6">
              {project.data.metrics.map((metric) => (
                <div class="text-center">
                  <div class="text-xs sm:text-sm font-bold font-mono text-cyan-400">{metric.value}</div>
                  <div class="text-[10px] text-slate-400 truncate mt-0.5">{metric.label}</div>
                </div>
              ))}
            </div>

            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-1.5">
              {project.data.tags.slice(0, 4).map((tag) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800/60 text-slate-400 border border-slate-800">
                  {tag}
                </span>
              ))}
              {project.data.tags.length > 4 && (
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded text-slate-500">
                  +{project.data.tags.length - 4} more
                </span>
              )}
            </div>
          </div>

          <!-- Bottom Action Card link -->
          <div class="px-6 py-4 border-t border-slate-800/80 bg-slate-950/40 flex items-center justify-between">
            <span class="text-xs font-medium text-slate-400 group-hover:text-cyan-300 transition-colors">
              Read Specification & Architecture
            </span>
            <div class="w-8 h-8 rounded-lg bg-slate-800/80 border border-slate-700/80 flex items-center justify-center text-slate-300 group-hover:bg-cyan-500 group-hover:text-slate-950 transition-all">
              <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
