---
---

<div id="xp-preloader" class="fixed inset-0 z-[100] bg-black flex flex-col items-center justify-center select-none transition-opacity duration-700">
  <div class="flex flex-col items-center max-w-sm px-6 w-full text-center">
    
    <!-- Authentic Windows XP Logo & Wordmark (Zero AI Neon) -->
    <div class="flex items-center gap-3.5 mb-10">
      <!-- Windows 4-Color Flag -->
      <div class="relative w-12 h-12 shrink-0">
        <svg class="w-full h-full drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" viewBox="0 0 24 24">
          <path d="M2 3l9-1v9H2V3z" fill="#f44336" />
          <path d="M13 1.8l9-1.2v9.4h-9V1.8z" fill="#4caf50" />
          <path d="M2 13h9v9l-9-1.2V13z" fill="#2196f3" />
          <path d="M13 13h9v9.4l-9-1.2V13z" fill="#ffeb3b" />
        </svg>
      </div>

      <!-- Wordmark -->
      <div class="text-left font-sans">
        <div class="text-[11px] text-slate-400 font-semibold tracking-wide">Microcok&reg;</div>
        <div class="text-2xl sm:text-3xl font-bold tracking-tight text-white flex items-baseline gap-1 leading-none">
          Windows<span class="text-amber-500 text-xl italic font-black">xd</span>
        </div>
        <div class="text-[9px] text-[#2b79e0] tracking-[0.25em] font-mono font-bold uppercase mt-0.5">
          Professional
        </div>
      </div>
    </div>

    <!-- Authentic Windows XP Scrolling 3-Block Blue Progress Bar -->
    <div class="w-64 h-4 bg-[#0a0a0a] rounded-full p-0.5 border border-[#333333] shadow-[inset_0_1px_2px_rgba(0,0,0,0.9)] overflow-hidden relative mb-6">
      <div id="xp-boot-track" class="w-full h-full relative">
        <div class="xp-boot-blocks flex gap-1 h-full absolute top-0">
          <div class="w-3 h-full rounded-sm bg-gradient-to-b from-[#5999ec] via-[#245edb] to-[#143a8c] shadow-sm"></div>
          <div class="w-3 h-full rounded-sm bg-gradient-to-b from-[#5999ec] via-[#245edb] to-[#143a8c] shadow-sm"></div>
          <div class="w-3 h-full rounded-sm bg-gradient-to-b from-[#5999ec] via-[#245edb] to-[#143a8c] shadow-sm"></div>
        </div>
      </div>
    </div>

    <!-- Clean Status Text -->
    <div class="min-h-[30px] flex items-center justify-center">
      <span id="xp-preloader-text" class="font-sans text-xs text-slate-400 tracking-wider">
        Starting up...
      </span>
    </div>

    <div class="mt-8 text-[10px] font-sans text-slate-400">
      Andhika Putra Pratama &bull; System Analyst Portfolio &bull; 2026
    </div>
  </div>
</div>

<style>
  @keyframes xpProgressScroll {
    0% {
      left: -40px;
    }
    100% {
      left: 100%;
    }
  }
  .xp-boot-blocks {
    animation: xpProgressScroll 1.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>

<script>
  const preloader = document.getElementById('xp-preloader');
  const text = document.getElementById('xp-preloader-text');

  // Realistic Windows XP Boot sequence (runs 2.2s then auto-fades smoothly into 3D scene)
  setTimeout(() => {
    if (text) text.innerText = 'Loading personalized settings...';
  }, 1200);

  setTimeout(() => {
    window.dispatchEvent(new CustomEvent('xp:preloader-completed'));
    if (preloader) {
      preloader.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        preloader.classList.add('hidden');
      }, 700);
    }
  }, 2200);
</script>
