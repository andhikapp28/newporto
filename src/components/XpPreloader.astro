---
---

<div id="xp-preloader" class="fixed inset-0 z-[100] bg-[#07090e] flex flex-col items-center justify-center select-none transition-all duration-700">
  <!-- Subtle scanline background -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0)_50%,rgba(0,0,0,0.4)_50%)] bg-[length:100%_4px] opacity-40"></div>

  <div class="relative z-10 flex flex-col items-center max-w-sm px-6 w-full text-center">
    <!-- 3D Flipping Card Badge (Retro Flip Animation) -->
    <div class="flip-scene w-32 h-32 mb-8 cursor-pointer">
      <div id="flip-card" class="flip-card-inner relative w-full h-full text-center transition-transform duration-700 shadow-2xl">
        <!-- Front Side: Windows XP 4-Color Logo Emblem -->
        <div class="flip-card-front absolute inset-0 rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-black border-2 border-slate-700/80 flex flex-col items-center justify-center p-4">
          <svg class="w-14 h-14 drop-shadow-[0_0_12px_rgba(255,255,255,0.3)] animate-pulse" viewBox="0 0 24 24">
            <rect x="2" y="2" width="9" height="9" fill="#f44336" rx="2" />
            <rect x="13" y="2" width="9" height="9" fill="#4caf50" rx="2" />
            <rect x="2" y="13" width="9" height="9" fill="#2196f3" rx="2" />
            <rect x="13" y="13" width="9" height="9" fill="#ffeb3b" rx="2" />
          </svg>
          <span class="text-[10px] font-mono text-slate-400 mt-2 tracking-widest uppercase font-bold">
            OS / XP 2026
          </span>
        </div>

        <!-- Back Side: System Analyst Tech Core Badge -->
        <div class="flip-card-back absolute inset-0 rounded-2xl bg-gradient-to-br from-blue-950 via-indigo-950 to-slate-950 border-2 border-cyan-400/80 flex flex-col items-center justify-center p-3">
          <span class="text-xs font-mono font-black text-cyan-300 tracking-wider">SYSTEM</span>
          <span class="text-sm font-mono font-black text-white tracking-widest">ANALYST</span>
          <div class="w-10 h-0.5 bg-cyan-400 my-1"></div>
          <span class="text-[9px] font-mono text-emerald-400 tracking-tighter">SA &bull; DEV &bull; QA</span>
        </div>
      </div>
    </div>

    <!-- 3D Flip Counter Tiles (Split-Flap Style) -->
    <div class="flex items-center justify-center gap-2 mb-4">
      <div class="flip-tile flex flex-col items-center justify-center w-14 h-16 rounded-xl bg-slate-900 border-2 border-slate-700 text-white font-mono text-2xl font-black shadow-lg">
        <span id="flip-digit-1">0</span>
      </div>
      <div class="flip-tile flex flex-col items-center justify-center w-14 h-16 rounded-xl bg-slate-900 border-2 border-slate-700 text-white font-mono text-2xl font-black shadow-lg">
        <span id="flip-digit-2">0</span>
      </div>
      <div class="flip-tile flex flex-col items-center justify-center w-14 h-16 rounded-xl bg-slate-900 border-2 border-slate-700 text-white font-mono text-2xl font-black shadow-lg">
        <span id="flip-digit-3">%</span>
      </div>
    </div>

    <!-- Thin Progress Bar Line -->
    <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden mb-6 border border-slate-700/60">
      <div id="preloader-bar" class="h-full bg-gradient-to-r from-cyan-400 via-blue-500 to-emerald-400 w-0 transition-all duration-100"></div>
    </div>

    <!-- Live Status Log Line -->
    <div class="min-h-[50px] flex flex-col items-center justify-center">
      <div id="preloader-status" class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400 animate-pulse">
        CALIBRATING HARDWARE...
      </div>

      <!-- Action Button after 100% (Instant Click) -->
      <button
        id="preloader-start-btn"
        class="hidden px-8 py-3.5 rounded-xl border-2 border-cyan-400 bg-cyan-950/80 hover:bg-cyan-400 text-cyan-300 hover:text-black font-black font-mono text-xs sm:text-sm tracking-[0.2em] uppercase transition-all duration-300 shadow-[0_0_30px_rgba(6,182,212,0.4)] cursor-pointer active:scale-95"
      >
        PRESS TO ENTER WORKSTATION &rarr;
      </button>
    </div>

    <!-- Subtle Footer Tagline -->
    <div class="mt-8 text-[11px] font-mono text-slate-600 tracking-widest uppercase">
      MICROSOFT WINDOWS XP &bull; ARCHITECTURE EDITION
    </div>
  </div>
</div>

<style>
  .flip-scene {
    perspective: 1000px;
  }
  .flip-card-inner {
    transform-style: preserve-3d;
  }
  .flip-card-front, .flip-card-back {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-card-back {
    transform: rotateY(180deg);
  }
  .flipped {
    transform: rotateY(180deg);
  }
  .flip-tick {
    animation: tileFlip 0.25s ease-in-out;
  }
  @keyframes tileFlip {
    0% { transform: scale(1); }
    50% { transform: scale(1.15) rotateX(15deg); }
    100% { transform: scale(1); }
  }
</style>

<script>
  const card = document.getElementById('flip-card');
  const d1 = document.getElementById('flip-digit-1');
  const d2 = document.getElementById('flip-digit-2');
  const bar = document.getElementById('preloader-bar');
  const statusText = document.getElementById('preloader-status');
  const startBtn = document.getElementById('preloader-start-btn');
  const preloader = document.getElementById('xp-preloader');

  // Automatic periodic 3D card flip
  let isCardFlipped = false;
  const cardFlipInterval = setInterval(() => {
    isCardFlipped = !isCardFlipped;
    if (card) {
      if (isCardFlipped) {
        card.classList.add('flipped');
      } else {
        card.classList.remove('flipped');
      }
    }
  }, 1200);

  let progress = 0;
  const statusMessages = [
    'INITIALIZING BIOS 2026...',
    'MOUNTING SYSTEM BLUEPRINTS...',
    'CONFIGURING WINDOWS XP SUBSYSTEM...',
    'LOADING CASE STUDIES...',
    'ALL ARTIFACTS VERIFIED'
  ];

  const interval = setInterval(() => {
    const inc = Math.floor(Math.random() * 5) + 3;
    progress = Math.min(100, progress + inc);

    // Update digits
    if (progress < 10) {
      if (d1) d1.innerText = '0';
      if (d2) d2.innerText = progress.toString();
    } else if (progress < 100) {
      const s = progress.toString();
      if (d1) d1.innerText = s[0];
      if (d2) d2.innerText = s[1];
    } else {
      if (d1) d1.innerText = '9';
      if (d2) d2.innerText = '9';
    }

    // Trigger flip animation tick on digits
    d2?.parentElement?.classList.add('flip-tick');
    setTimeout(() => {
      d2?.parentElement?.classList.remove('flip-tick');
    }, 200);

    if (bar) bar.style.width = `${progress}%`;

    const statusIdx = Math.min(statusMessages.length - 1, Math.floor((progress / 100) * statusMessages.length));
    if (statusText && statusMessages[statusIdx]) {
      statusText.innerText = statusMessages[statusIdx];
    }

    if (progress >= 100) {
      clearInterval(interval);
      if (d1) d1.innerText = '1';
      if (d2) d2.innerText = '0';
      const d3 = document.getElementById('flip-digit-3');
      if (d3) d3.innerText = '0';

      setTimeout(() => {
        if (statusText) statusText.classList.add('hidden');
        if (startBtn) {
          startBtn.classList.remove('hidden');
          startBtn.classList.add('inline-flex');
        }
      }, 300);
    }
  }, 40);

  startBtn?.addEventListener('click', () => {
    clearInterval(cardFlipInterval);
    window.dispatchEvent(new CustomEvent('xp:preloader-completed'));

    if (preloader) {
      preloader.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        preloader.classList.add('hidden');
      }, 700);
    }
  });
</script>
