---
import { Monitor } from '@lucide/astro';
---

<div id="three-computer-stage" class="fixed inset-0 z-40 bg-[#05080c] flex flex-col justify-between select-none overflow-hidden transition-opacity duration-700">
  <!-- Three.js Canvas Container -->
  <div id="webgl-container" class="absolute inset-0 z-0 cursor-grab active:cursor-grabbing"></div>

  <!-- CRT Vignette -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(0,0,0,0.85)_100%)] z-10"></div>

  <!-- Top Header (No "Retro Workstation" badge as requested) -->
  <div class="relative z-20 pt-8 px-6 flex flex-col items-center text-center pointer-events-none">
    <h1 class="text-2xl sm:text-4xl font-black font-mono tracking-wider text-emerald-400 drop-shadow-[0_0_20px_rgba(52,211,153,0.5)]">
      SYSTEM ANALYST &bull; WORKSTATION
    </h1>
    <p class="text-[11px] sm:text-xs font-mono tracking-[0.25em] text-emerald-500/80 mt-1 uppercase font-semibold">
      BRD &bull; ARCHITECTURE &bull; DEV FEASIBILITY &bull; QA RIGOR
    </p>
  </div>

  <!-- Bottom Empty Space (Bottom button removed as requested) -->
  <div class="relative z-20 pb-4 px-6"></div>
</div>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('webgl-container');
  const stage = document.getElementById('three-computer-stage');

  if (container) {
    // 1. Scene, Camera & Optimized Renderer (Silky 60 FPS)
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x05080c, 0.04);

    const camera = new THREE.PerspectiveCamera(
      42,
      window.innerWidth / window.innerHeight,
      0.1,
      60
    );
    camera.position.set(0, 1.2, 5.0);

    const renderer = new THREE.WebGLRenderer({ 
      antialias: true, 
      alpha: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.25));
    renderer.shadowMap.enabled = false;
    container.appendChild(renderer.domElement);

    // 2. Phosphor Green Lighting (Matches Image 2)
    const ambientLight = new THREE.AmbientLight(0x102018, 2.0);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xe6fff2, 2.2);
    keyLight.position.set(3, 5, 4);
    scene.add(keyLight);

    // CRT Screen Phosphor Green Glow
    const crtGlow = new THREE.PointLight(0x10b981, 3.2, 6);
    crtGlow.position.set(0, 0.5, 1.2);
    scene.add(crtGlow);

    // 3. Background Animated Scrolling Perspective Grid (Motion in Background!)
    const gridHelper = new THREE.GridHelper(40, 40, 0x10b981, 0x064e3b);
    gridHelper.position.y = -1.1;
    scene.add(gridHelper);

    // Animated Floating Matrix Dust Particles
    const particleCount = 150;
    const particleGeometry = new THREE.BufferGeometry();
    const particlePositions = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount * 3; i += 3) {
      particlePositions[i] = (Math.random() - 0.5) * 18;
      particlePositions[i + 1] = Math.random() * 8 - 1;
      particlePositions[i + 2] = (Math.random() - 0.5) * 14;
    }
    particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));

    const particleMaterial = new THREE.PointsMaterial({
      color: 0x34d399,
      size: 0.045,
      transparent: true,
      opacity: 0.45
    });
    const dustParticles = new THREE.Points(particleGeometry, particleMaterial);
    scene.add(dustParticles);

    // 4. CRT Screen Canvas Texture (Image 2 Green Phosphor Boot Screen)
    const screenCanvas = document.createElement('canvas');
    screenCanvas.width = 512;
    screenCanvas.height = 384;
    const ctx = screenCanvas.getContext('2d');
    if (ctx) {
      // CRT dark green gradient
      const grad = ctx.createLinearGradient(0, 0, 0, screenCanvas.height);
      grad.addColorStop(0, '#03170c');
      grad.addColorStop(1, '#020b06');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, screenCanvas.width, screenCanvas.height);

      // CRT Scanlines
      ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';
      for (let y = 0; y < screenCanvas.height; y += 4) {
        ctx.fillRect(0, y, screenCanvas.width, 2);
      }

      // Phosphor Green Terminal Boot Text (Exact wording from Image 2)
      ctx.fillStyle = '#34d399';
      ctx.font = 'bold 22px "Courier New", monospace';
      ctx.fillText('MICROSOFT (R) WINDOWS XP', 40, 55);

      ctx.fillStyle = '#10b981';
      ctx.font = '15px "Courier New", monospace';
      ctx.fillText('System Analyst Architecture Build 2600', 40, 85);

      ctx.fillStyle = '#6ee7b7';
      ctx.fillText('Hardware Verification: PASSED', 40, 145);
      ctx.fillText('Memory Cache: 512 MB SDRAM OK', 40, 175);
      ctx.fillText('Roles: [SA] [DEV] [QA] LOADED', 40, 205);

      // Click to Power On Box
      ctx.fillStyle = 'rgba(16, 185, 129, 0.2)';
      ctx.fillRect(40, 255, 432, 50);
      ctx.strokeStyle = '#34d399';
      ctx.lineWidth = 2;
      ctx.strokeRect(40, 255, 432, 50);

      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 18px "Courier New", monospace';
      ctx.fillText('> CLICK MONITOR TO POWER ON <', 70, 287);
    }
    const screenTexture = new THREE.CanvasTexture(screenCanvas);

    // 5. Workstation 3D Models (Kept identical to Image 2)
    const workstation = new THREE.Group();
    scene.add(workstation);

    // Materials
    const retroPlastic = new THREE.MeshLambertMaterial({ color: 0xd2cbbb });
    const retroPlasticDark = new THREE.MeshLambertMaterial({ color: 0x9b9485 });
    const deskBlack = new THREE.MeshLambertMaterial({ color: 0x181a1f });
    const screenMat = new THREE.MeshBasicMaterial({ map: screenTexture });
    const keybDark = new THREE.MeshLambertMaterial({ color: 0x1f2228 });
    const greenLed = new THREE.MeshBasicMaterial({ color: 0x10b981 });
    const badgeGold = new THREE.MeshLambertMaterial({ color: 0xc49b38 });

    // Desktop
    const desk = new THREE.Mesh(
      new THREE.BoxGeometry(7.0, 0.15, 3.5),
      deskBlack
    );
    desk.position.set(0, -1.05, 0.5);
    workstation.add(desk);

    // Monitor Group (Centered)
    const monitorGroup = new THREE.Group();
    monitorGroup.position.set(0, 0.25, 0);
    workstation.add(monitorGroup);

    // Monitor Body
    const monitorBody = new THREE.Mesh(
      new THREE.BoxGeometry(2.3, 1.85, 1.6),
      retroPlastic
    );
    monitorGroup.add(monitorBody);

    const crtCone = new THREE.Mesh(
      new THREE.BoxGeometry(1.6, 1.3, 0.9),
      retroPlasticDark
    );
    crtCone.position.set(0, 0, -1.0);
    monitorGroup.add(crtCone);

    // Monitor Front Bezel
    const monitorBezel = new THREE.Mesh(
      new THREE.BoxGeometry(2.2, 1.75, 0.15),
      retroPlastic
    );
    monitorBezel.position.set(0, 0.05, 0.82);
    monitorGroup.add(monitorBezel);

    // CRT Screen Face (Click Target)
    const crtScreen = new THREE.Mesh(
      new THREE.PlaneGeometry(1.85, 1.35),
      screenMat
    );
    crtScreen.position.set(0, 0.12, 0.91);
    monitorGroup.add(crtScreen);

    // Badge Plate
    const badge = new THREE.Mesh(
      new THREE.BoxGeometry(0.32, 0.07, 0.02),
      badgeGold
    );
    badge.position.set(0, -0.68, 0.9);
    monitorGroup.add(badge);

    // Power Switch & LED
    const pwrBtn = new THREE.Mesh(
      new THREE.BoxGeometry(0.14, 0.08, 0.04),
      keybDark
    );
    pwrBtn.position.set(0.85, -0.68, 0.9);
    monitorGroup.add(pwrBtn);

    const pwrLed = new THREE.Mesh(
      new THREE.SphereGeometry(0.025, 8, 8),
      greenLed
    );
    pwrLed.position.set(0.72, -0.68, 0.91);
    monitorGroup.add(pwrLed);

    // Stand
    const standNeck = new THREE.Mesh(
      new THREE.CylinderGeometry(0.22, 0.26, 0.35, 12),
      retroPlasticDark
    );
    standNeck.position.set(0, -1.0, 0);
    monitorGroup.add(standNeck);

    const standBase = new THREE.Mesh(
      new THREE.BoxGeometry(1.5, 0.08, 1.3),
      retroPlastic
    );
    standBase.position.set(0, -1.18, 0.1);
    monitorGroup.add(standBase);

    // PC Tower
    const towerGroup = new THREE.Group();
    towerGroup.position.set(1.9, -0.15, 0.2);
    workstation.add(towerGroup);

    const towerCase = new THREE.Mesh(
      new THREE.BoxGeometry(1.0, 2.0, 2.2),
      retroPlastic
    );
    towerGroup.add(towerCase);

    const cdDrive = new THREE.Mesh(
      new THREE.BoxGeometry(0.85, 0.18, 0.05),
      retroPlasticDark
    );
    cdDrive.position.set(0, 0.72, 1.11);
    towerGroup.add(cdDrive);

    const floppyDrive = new THREE.Mesh(
      new THREE.BoxGeometry(0.85, 0.14, 0.05),
      retroPlasticDark
    );
    floppyDrive.position.set(0, 0.45, 1.11);
    towerGroup.add(floppyDrive);

    const floppyLed = new THREE.Mesh(
      new THREE.BoxGeometry(0.04, 0.04, 0.02),
      greenLed
    );
    floppyLed.position.set(-0.3, 0.45, 1.14);
    towerGroup.add(floppyLed);

    // Keyboard & Mouse
    const kbGroup = new THREE.Group();
    kbGroup.position.set(0, -0.92, 1.4);
    kbGroup.rotation.x = 0.1;
    workstation.add(kbGroup);

    const kbBase = new THREE.Mesh(
      new THREE.BoxGeometry(2.3, 0.08, 0.8),
      retroPlastic
    );
    kbGroup.add(kbBase);

    const kbKeys = new THREE.Mesh(
      new THREE.BoxGeometry(2.1, 0.06, 0.65),
      keybDark
    );
    kbKeys.position.set(0, 0.05, 0);
    kbGroup.add(kbKeys);

    const mousePad = new THREE.Mesh(
      new THREE.BoxGeometry(0.9, 0.02, 1.1),
      new THREE.MeshLambertMaterial({ color: 0x1e3a8a })
    );
    mousePad.position.set(1.5, -0.96, 1.4);
    workstation.add(mousePad);

    const mouseMesh = new THREE.Mesh(
      new THREE.BoxGeometry(0.32, 0.12, 0.5),
      retroPlastic
    );
    mouseMesh.position.set(1.5, -0.91, 1.4);
    workstation.add(mouseMesh);

    // 6. Strict Drag vs Click Logic
    // DRAG = ROTATION ONLY. RELEASING AFTER DRAGGING NEVER POWERS ON!
    let isMouseDown = false;
    let hasDragged = false;
    let startMousePos = { x: 0, y: 0 };
    let rotY = 0;
    let rotX = 0;
    const raycaster = new THREE.Raycaster();
    const mouseVector = new THREE.Vector2();

    renderer.domElement.addEventListener('pointerdown', (e: PointerEvent) => {
      isMouseDown = true;
      hasDragged = false;
      startMousePos = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('pointermove', (e: PointerEvent) => {
      if (isMouseDown) {
        const dx = e.clientX - startMousePos.x;
        const dy = e.clientY - startMousePos.y;
        const dist = Math.hypot(dx, dy);

        if (dist > 6) {
          hasDragged = true; // User is rotating the 3D PC!
        }

        rotY += (e.clientX - startMousePos.x) * 0.005;
        rotX += (e.clientY - startMousePos.y) * 0.003;
        rotX = Math.max(-0.25, Math.min(0.25, rotX));
        startMousePos = { x: e.clientX, y: e.clientY };
      } else {
        // Idle hover cursor check
        const nx = (e.clientX / window.innerWidth) * 2 - 1;
        const ny = -(e.clientY / window.innerHeight) * 2 + 1;
        camera.position.x += (nx * 0.25 - camera.position.x) * 0.04;
        camera.position.y += (1.2 + ny * 0.15 - camera.position.y) * 0.04;
        camera.lookAt(0, 0.1, 0);

        mouseVector.x = nx;
        mouseVector.y = ny;
        raycaster.setFromCamera(mouseVector, camera);
        const hits = raycaster.intersectObjects(workstation.children, true);
        if (hits.length > 0) {
          renderer.domElement.style.cursor = 'pointer';
        } else {
          renderer.domElement.style.cursor = 'grab';
        }
      }
    });

    window.addEventListener('pointerup', (e: PointerEvent) => {
      if (!isMouseDown) return;
      isMouseDown = false;

      // CRITICAL FIX: If user moved mouse while holding down, it was a DRAG.
      // Releasing the mouse MUST NOT BOOT!
      if (hasDragged) {
        return;
      }

      // If user performed a clean, short click without dragging:
      // Verify they clicked on the computer / monitor setup!
      mouseVector.x = (e.clientX / window.innerWidth) * 2 - 1;
      mouseVector.y = -(e.clientY / window.innerHeight) * 2 + 1;
      raycaster.setFromCamera(mouseVector, camera);
      const hits = raycaster.intersectObjects(workstation.children, true);

      if (hits.length > 0) {
        triggerBoot();
      }
    });

    // 7. Boot Sequence: Zoom into CRT & Play Real Windows XP Audio
    let isBooting = false;
    let animFrameId: number;

    function triggerBoot() {
      if (isBooting) return;
      isBooting = true;

      playRealXpSound('/sounds/xp-startup.wav');

      const startPos = { ...camera.position };
      const targetPos = { x: 0, y: 0.37, z: 1.15 };
      const duration = 1200;
      const startTime = performance.now();

      function animateZoom(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const ease = progress < 0.5
          ? 4 * progress * progress * progress
          : 1 - Math.pow(-2 * progress + 2, 3) / 2;

        camera.position.x = startPos.x + (targetPos.x - startPos.x) * ease;
        camera.position.y = startPos.y + (targetPos.y - startPos.y) * ease;
        camera.position.z = startPos.z + (targetPos.z - startPos.z) * ease;
        camera.lookAt(0, 0.37, 0.91);

        if (progress < 1) {
          requestAnimationFrame(animateZoom);
        } else {
          window.dispatchEvent(new CustomEvent('xp:boot-desktop'));
          cancelAnimationFrame(animFrameId);

          if (stage) {
            stage.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
              stage.classList.add('hidden');
            }, 700);
          }
        }
      }
      requestAnimationFrame(animateZoom);
    }

    function playRealXpSound(soundPath: string) {
      try {
        const audio = new Audio(soundPath);
        audio.volume = 0.85;
        audio.play().catch(e => console.warn('Audio blocked:', e));
      } catch (e) {
        console.error(e);
      }
    }

    // 8. 60 FPS Render Loop (Grid glides continuously forward!)
    function renderLoop() {
      animFrameId = requestAnimationFrame(renderLoop);

      if (!isBooting) {
        workstation.rotation.y += (rotY - workstation.rotation.y) * 0.08;
        workstation.rotation.x += (rotX - workstation.rotation.x) * 0.08;

        // Background Animation: Grid moves forward infinitely!
        gridHelper.position.z = (gridHelper.position.z + 0.015) % 1;

        // Floating particles drift
        dustParticles.rotation.y += 0.0008;
      }

      renderer.render(scene, camera);
    }
    renderLoop();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    window.addEventListener('xp:shutdown-to-3d', () => {
      isBooting = false;
      camera.position.set(0, 1.2, 5.0);
      camera.lookAt(0, 0.1, 0);

      if (stage) {
        stage.classList.remove('hidden');
        setTimeout(() => {
          stage.classList.remove('opacity-0', 'pointer-events-none');
          renderLoop();
        }, 50);
      }
    });
  }
</script>
