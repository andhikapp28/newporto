---
import { Monitor, MousePointer } from '@lucide/astro';
---

<div id="three-computer-stage" class="fixed inset-0 z-40 bg-[#0d1117] flex flex-col justify-between select-none overflow-hidden transition-opacity duration-700">
  <!-- Three.js Canvas Container -->
  <div id="webgl-container" class="absolute inset-0 z-0 cursor-grab active:cursor-grabbing"></div>

  <!-- Clean, Non-Neon Top Bar -->
  <div class="relative z-20 pt-6 px-6 flex flex-col items-center text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-slate-200 text-xs font-sans tracking-wide">
      <Monitor class="w-3.5 h-3.5 text-blue-400" />
      <span>System Analyst Workstation &bull; 3D Setup</span>
    </div>
  </div>

  <!-- Bottom Hint (Clean, no big button) -->
  <div class="relative z-20 pb-6 px-6 flex justify-center pointer-events-none">
    <div class="inline-flex items-center gap-2 text-xs font-sans text-slate-300 bg-black/60 px-4 py-2 rounded-full border border-white/20 backdrop-blur-md shadow-lg">
      <MousePointer class="w-3.5 h-3.5 text-blue-400" />
      <span>Drag mouse to rotate &bull; Click monitor screen to boot Windows XP</span>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('webgl-container');
  const stage = document.getElementById('three-computer-stage');

  if (container) {
    // 1. Scene, Camera & Optimized Renderer (No Lag)
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x0d1117, 0.045);

    const camera = new THREE.PerspectiveCamera(
      42,
      window.innerWidth / window.innerHeight,
      0.1,
      50
    );
    camera.position.set(0, 1.2, 5.0);

    const renderer = new THREE.WebGLRenderer({ 
      antialias: true, 
      alpha: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.25));
    renderer.shadowMap.enabled = false; // NO laggy shadows
    container.appendChild(renderer.domElement);

    // 2. Realistic Warm Ambient & Desk Lighting
    const ambientLight = new THREE.AmbientLight(0x4a5568, 1.8);
    scene.add(ambientLight);

    const deskLamp = new THREE.DirectionalLight(0xffeedd, 2.2);
    deskLamp.position.set(3, 5, 4);
    scene.add(deskLamp);

    const softFill = new THREE.PointLight(0x93c5fd, 1.5, 8);
    softFill.position.set(-3, 2, 2);
    scene.add(softFill);

    // 3. Background Atmospheric Floating Dust Particles (Warm Cozy Office Room)
    const particleCount = 200;
    const particleGeometry = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount * 3; i += 3) {
      positions[i] = (Math.random() - 0.5) * 16;
      positions[i + 1] = Math.random() * 8 - 1;
      positions[i + 2] = (Math.random() - 0.5) * 12;
    }
    particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    const particleMaterial = new THREE.PointsMaterial({
      color: 0x94a3b8,
      size: 0.05,
      transparent: true,
      opacity: 0.5
    });
    const dustParticles = new THREE.Points(particleGeometry, particleMaterial);
    scene.add(dustParticles);

    // 4. CRT Screen Canvas Texture (Windows XP Starting Screen)
    const screenCanvas = document.createElement('canvas');
    screenCanvas.width = 512;
    screenCanvas.height = 384;
    const ctx = screenCanvas.getContext('2d');
    if (ctx) {
      // Dark navy Windows XP boot background
      ctx.fillStyle = '#08111e';
      ctx.fillRect(0, 0, screenCanvas.width, screenCanvas.height);

      // Windows XP small logo on CRT screen
      ctx.fillStyle = '#f44336';
      ctx.fillRect(200, 100, 24, 24);
      ctx.fillStyle = '#4caf50';
      ctx.fillRect(230, 96, 24, 24);
      ctx.fillStyle = '#2196f3';
      ctx.fillRect(200, 130, 24, 24);
      ctx.fillStyle = '#ffeb3b';
      ctx.fillRect(230, 126, 24, 24);

      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 22px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Windows XP', 230, 185);

      ctx.fillStyle = '#94a3b8';
      ctx.font = '13px sans-serif';
      ctx.fillText('Perum DAMRI System Analyst Workstation', 230, 210);

      // Click to Turn On prompt box
      ctx.fillStyle = '#2563eb';
      ctx.fillRect(100, 260, 260, 42);
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 14px sans-serif';
      ctx.fillText('CLICK TO POWER ON', 230, 287);
    }
    const screenTexture = new THREE.CanvasTexture(screenCanvas);

    // 5. Workstation 3D Model
    const workstation = new THREE.Group();
    scene.add(workstation);

    // Materials
    const retroPlastic = new THREE.MeshLambertMaterial({ color: 0xd6cfc0 });
    const retroPlasticDark = new THREE.MeshLambertMaterial({ color: 0xbdb4a3 });
    const deskWood = new THREE.MeshLambertMaterial({ color: 0x2e1d15 });
    const screenMat = new THREE.MeshBasicMaterial({ map: screenTexture });
    const keybDark = new THREE.MeshLambertMaterial({ color: 0x26282e });
    const greenLed = new THREE.MeshBasicMaterial({ color: 0x22c55e });

    // Desk
    const desk = new THREE.Mesh(
      new THREE.BoxGeometry(7.0, 0.15, 3.5),
      deskWood
    );
    desk.position.set(0, -1.05, 0.5);
    workstation.add(desk);

    // Monitor Group (Centered)
    const monitorGroup = new THREE.Group();
    monitorGroup.position.set(0, 0.25, 0);
    workstation.add(monitorGroup);

    // CRT Housing
    const monitorBody = new THREE.Mesh(
      new THREE.BoxGeometry(2.3, 1.85, 1.6),
      retroPlastic
    );
    monitorGroup.add(monitorBody);

    const crtCone = new THREE.Mesh(
      new THREE.BoxGeometry(1.6, 1.3, 0.9),
      retroPlasticDark
    );
    crtCone.position.set(0, 0, -1.0);
    monitorGroup.add(crtCone);

    // Front Bezel
    const monitorBezel = new THREE.Mesh(
      new THREE.BoxGeometry(2.2, 1.75, 0.15),
      retroPlastic
    );
    monitorBezel.position.set(0, 0.05, 0.82);
    monitorGroup.add(monitorBezel);

    // CRT Screen (Target for Raycaster click!)
    const crtScreen = new THREE.Mesh(
      new THREE.PlaneGeometry(1.85, 1.35),
      screenMat
    );
    crtScreen.position.set(0, 0.12, 0.91);
    crtScreen.name = 'crt_screen';
    monitorGroup.add(crtScreen);

    // Power LED & Button
    const pwrLed = new THREE.Mesh(
      new THREE.SphereGeometry(0.025, 8, 8),
      greenLed
    );
    pwrLed.position.set(0.75, -0.68, 0.91);
    monitorGroup.add(pwrLed);

    // Stand
    const standNeck = new THREE.Mesh(
      new THREE.CylinderGeometry(0.22, 0.26, 0.35, 12),
      retroPlasticDark
    );
    standNeck.position.set(0, -1.0, 0);
    monitorGroup.add(standNeck);

    const standBase = new THREE.Mesh(
      new THREE.BoxGeometry(1.5, 0.08, 1.3),
      retroPlastic
    );
    standBase.position.set(0, -1.18, 0.1);
    monitorGroup.add(standBase);

    // PC Tower
    const towerGroup = new THREE.Group();
    towerGroup.position.set(1.9, -0.15, 0.2);
    workstation.add(towerGroup);

    const towerCase = new THREE.Mesh(
      new THREE.BoxGeometry(1.0, 2.0, 2.2),
      retroPlastic
    );
    towerGroup.add(towerCase);

    const cdDrive = new THREE.Mesh(
      new THREE.BoxGeometry(0.85, 0.18, 0.05),
      retroPlasticDark
    );
    cdDrive.position.set(0, 0.72, 1.11);
    towerGroup.add(cdDrive);

    const floppyDrive = new THREE.Mesh(
      new THREE.BoxGeometry(0.85, 0.14, 0.05),
      retroPlasticDark
    );
    floppyDrive.position.set(0, 0.45, 1.11);
    towerGroup.add(floppyDrive);

    // Keyboard & Mouse
    const kbGroup = new THREE.Group();
    kbGroup.position.set(0, -0.92, 1.4);
    kbGroup.rotation.x = 0.1;
    workstation.add(kbGroup);

    const kbBase = new THREE.Mesh(
      new THREE.BoxGeometry(2.3, 0.08, 0.8),
      retroPlastic
    );
    kbGroup.add(kbBase);

    const kbKeys = new THREE.Mesh(
      new THREE.BoxGeometry(2.1, 0.06, 0.65),
      keybDark
    );
    kbKeys.position.set(0, 0.05, 0);
    kbGroup.add(kbKeys);

    const mousePad = new THREE.Mesh(
      new THREE.BoxGeometry(0.9, 0.02, 1.1),
      new THREE.MeshLambertMaterial({ color: 0x1e3a8a })
    );
    mousePad.position.set(1.5, -0.96, 1.4);
    workstation.add(mousePad);

    const mouseMesh = new THREE.Mesh(
      new THREE.BoxGeometry(0.32, 0.12, 0.5),
      retroPlastic
    );
    mouseMesh.position.set(1.5, -0.91, 1.4);
    workstation.add(mouseMesh);

    // 6. Strict Drag vs Click Logic (User only powers on by CLICKING MONITOR)
    let isDragging = false;
    let mouseDownPos = { x: 0, y: 0 };
    let rotY = 0;
    let rotX = 0;
    const raycaster = new THREE.Raycaster();
    const mouseVector = new THREE.Vector2();

    renderer.domElement.addEventListener('pointerdown', (e: PointerEvent) => {
      isDragging = true;
      mouseDownPos = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('pointerup', (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;

      const dist = Math.hypot(e.clientX - mouseDownPos.x, e.clientY - mouseDownPos.y);

      // If user dragged more than 8px, it was a rotation drag — DO NOT BOOT!
      if (dist > 8) return;

      // Click detected without dragging: trigger boot!
      triggerBoot();
    });

    window.addEventListener('pointermove', (e: PointerEvent) => {
      if (isDragging) {
        const dx = e.clientX - mouseDownPos.x;
        const dy = e.clientY - mouseDownPos.y;
        rotY += dx * 0.005;
        rotX += dy * 0.003;
        rotX = Math.max(-0.25, Math.min(0.25, rotX));
        mouseDownPos = { x: e.clientX, y: e.clientY };
      } else {
        // Subtle mouse parallax
        const nx = (e.clientX / window.innerWidth) * 2 - 1;
        const ny = -(e.clientY / window.innerHeight) * 2 + 1;
        camera.position.x += (nx * 0.25 - camera.position.x) * 0.04;
        camera.position.y += (1.2 + ny * 0.15 - camera.position.y) * 0.04;
        camera.lookAt(0, 0.1, 0);

        // Hover cursor detection
        mouseVector.x = nx;
        mouseVector.y = ny;
        raycaster.setFromCamera(mouseVector, camera);
        const hits = raycaster.intersectObjects(workstation.children, true);
        if (hits.length > 0) {
          renderer.domElement.style.cursor = 'pointer';
        } else {
          renderer.domElement.style.cursor = 'grab';
        }
      }
    });

    // Touch handling
    container.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        mouseDownPos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      }
    }, { passive: true });

    container.addEventListener('touchmove', (e) => {
      if (isDragging && e.touches.length === 1) {
        const dx = e.touches[0].clientX - mouseDownPos.x;
        rotY += dx * 0.006;
        mouseDownPos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      }
    }, { passive: true });

    container.addEventListener('touchend', (e) => {
      isDragging = false;
      if (e.changedTouches.length === 1) {
        const dist = Math.hypot(e.changedTouches[0].clientX - mouseDownPos.x, e.changedTouches[0].clientY - mouseDownPos.y);
        if (dist <= 6) {
          triggerBoot();
        }
      }
    });

    // 7. Boot Sequence into Windows XP
    let isBooting = false;
    let animFrameId: number;

    function triggerBoot() {
      if (isBooting) return;
      isBooting = true;

      playRealXpSound('/sounds/xp-startup.wav');

      const startPos = { ...camera.position };
      const targetPos = { x: 0, y: 0.37, z: 1.15 };
      const duration = 1200;
      const startTime = performance.now();

      function animateZoom(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const ease = progress < 0.5
          ? 4 * progress * progress * progress
          : 1 - Math.pow(-2 * progress + 2, 3) / 2;

        camera.position.x = startPos.x + (targetPos.x - startPos.x) * ease;
        camera.position.y = startPos.y + (targetPos.y - startPos.y) * ease;
        camera.position.z = startPos.z + (targetPos.z - startPos.z) * ease;
        camera.lookAt(0, 0.37, 0.91);

        if (progress < 1) {
          requestAnimationFrame(animateZoom);
        } else {
          window.dispatchEvent(new CustomEvent('xp:boot-desktop'));
          cancelAnimationFrame(animFrameId); // Freeze Three.js to eliminate lag

          if (stage) {
            stage.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
              stage.classList.add('hidden');
            }, 700);
          }
        }
      }
      requestAnimationFrame(animateZoom);
    }

    function playRealXpSound(soundPath: string) {
      try {
        const audio = new Audio(soundPath);
        audio.volume = 0.85;
        audio.play().catch(e => console.warn('Audio blocked:', e));
      } catch (e) {
        console.error(e);
      }
    }

    // 8. 60 FPS Render Loop (With floating dust particles)
    function renderLoop() {
      animFrameId = requestAnimationFrame(renderLoop);

      if (!isBooting) {
        workstation.rotation.y += (rotY - workstation.rotation.y) * 0.08;
        workstation.rotation.x += (rotX - workstation.rotation.x) * 0.08;

        // Subtle drifting dust
        dustParticles.rotation.y += 0.0006;
      }

      renderer.render(scene, camera);
    }
    renderLoop();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    window.addEventListener('xp:shutdown-to-3d', () => {
      isBooting = false;
      camera.position.set(0, 1.2, 5.0);
      camera.lookAt(0, 0.1, 0);

      if (stage) {
        stage.classList.remove('hidden');
        setTimeout(() => {
          stage.classList.remove('opacity-0', 'pointer-events-none');
          renderLoop();
        }, 50);
      }
    });
  }
</script>
