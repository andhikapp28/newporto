---
import { Power, Sparkles, Monitor, MousePointer } from '@lucide/astro';
---

<div id="three-computer-stage" class="fixed inset-0 z-40 bg-[#080b11] flex flex-col justify-between select-none overflow-hidden transition-opacity duration-700">
  <!-- Three.js Canvas Container -->
  <div id="webgl-container" class="absolute inset-0 z-0 cursor-grab active:cursor-grabbing"></div>

  <!-- CRT Vignette & Subtle Scanlines -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_45%,rgba(0,0,0,0.85)_100%)] z-10"></div>
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[length:100%_4px] opacity-35 z-10"></div>

  <!-- Top Retro Neon Header -->
  <div class="relative z-20 pt-6 px-6 flex flex-col items-center text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-950/40 text-emerald-400 text-xs font-mono mb-2 tracking-widest uppercase">
      <Sparkles class="w-3.5 h-3.5" />
      <span>Retro Workstation 3D</span>
    </div>

    <h1 class="text-2xl sm:text-4xl font-black font-mono tracking-wider text-emerald-400 drop-shadow-[0_0_20px_rgba(52,211,153,0.4)]">
      SYSTEM ANALYST &bull; WORKSTATION
    </h1>
    <p class="text-[11px] sm:text-xs font-mono tracking-[0.25em] text-slate-400 mt-1 uppercase">
      BRD &bull; ARCHITECTURE &bull; DEV FEASIBILITY &bull; QA RIGOR
    </p>
  </div>

  <!-- Bottom Action Bar & Boot Button -->
  <div class="relative z-20 pb-8 px-6 max-w-lg mx-auto w-full flex flex-col items-center gap-3.5">
    <div class="flex items-center gap-2 text-[11px] font-mono text-slate-400 bg-black/75 px-4 py-1.5 rounded-full border border-slate-800 backdrop-blur-md">
      <MousePointer class="w-3 h-3 text-emerald-400" />
      <span>Drag to orbit &bull; Click monitor or press button below</span>
    </div>

    <button
      id="power-on-btn"
      class="group relative w-full sm:w-auto px-8 py-3.5 rounded-xl border-2 border-emerald-400 bg-emerald-950/90 hover:bg-emerald-400 text-emerald-300 hover:text-black font-black font-mono text-xs sm:text-sm tracking-[0.2em] uppercase transition-all duration-300 shadow-[0_0_25px_rgba(16,185,129,0.35)] hover:shadow-[0_0_40px_rgba(16,185,129,0.7)] flex items-center justify-center gap-3 cursor-pointer active:scale-95"
    >
      <Power class="w-4 h-4 text-emerald-400 group-hover:text-black transition-colors" />
      <span>POWER ON WORKSTATION (BOOT XP)</span>
    </button>
  </div>
</div>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('webgl-container');
  const powerBtn = document.getElementById('power-on-btn');
  const stage = document.getElementById('three-computer-stage');

  if (container) {
    // 1. Scene & Performance-Optimized Setup
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x080b11, 0.04);

    const camera = new THREE.PerspectiveCamera(
      42,
      window.innerWidth / window.innerHeight,
      0.1,
      60
    );
    camera.position.set(0, 1.4, 5.2);

    const renderer = new THREE.WebGLRenderer({ 
      antialias: true, 
      alpha: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    // Clamped pixel ratio to 1.25 to prevent any GPU stall / lag
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.25));
    // NO heavy shadow maps to ensure ultra-smooth 60 FPS
    renderer.shadowMap.enabled = false;
    container.appendChild(renderer.domElement);

    // 2. Beautiful Balanced Lighting
    const ambientLight = new THREE.AmbientLight(0x334455, 1.5);
    scene.add(ambientLight);

    // Warm overhead desk spotlight
    const deskSpot = new THREE.SpotLight(0xfff3d6, 3.5);
    deskSpot.position.set(-2, 5, 3);
    deskSpot.angle = Math.PI / 4;
    deskSpot.penumbra = 0.6;
    scene.add(deskSpot);

    // Emerald accent glow from the monitor
    const crtGlow = new THREE.PointLight(0x10b981, 2.5, 5);
    crtGlow.position.set(0, 0.9, 1.2);
    scene.add(crtGlow);

    // Cool cyan rim light from rear-right
    const rimLight = new THREE.DirectionalLight(0x38bdf8, 1.2);
    rimLight.position.set(4, 2, -3);
    scene.add(rimLight);

    // 3. Grid Floor
    const gridHelper = new THREE.GridHelper(30, 30, 0x10b981, 0x1e293b);
    gridHelper.position.y = -1.1;
    scene.add(gridHelper);

    // 4. CRT Screen Texture (Rendered once, zero overhead)
    const screenCanvas = document.createElement('canvas');
    screenCanvas.width = 512;
    screenCanvas.height = 384;
    const ctx = screenCanvas.getContext('2d');
    if (ctx) {
      // CRT glass scanline gradient
      const grad = ctx.createLinearGradient(0, 0, 0, screenCanvas.height);
      grad.addColorStop(0, '#04170d');
      grad.addColorStop(1, '#020b06');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, screenCanvas.width, screenCanvas.height);

      // Scanlines
      ctx.fillStyle = 'rgba(0, 0, 0, 0.28)';
      for (let y = 0; y < screenCanvas.height; y += 4) {
        ctx.fillRect(0, y, screenCanvas.width, 2);
      }

      // Windows XP / System Analyst boot graphics
      ctx.fillStyle = '#34d399';
      ctx.font = 'bold 22px "Courier New", monospace';
      ctx.fillText('MICROSOFT(R) WINDOWS XP', 35, 50);
      ctx.font = '16px "Courier New", monospace';
      ctx.fillStyle = '#10b981';
      ctx.fillText('System Analyst Architecture Build 2600', 35, 80);

      ctx.fillStyle = '#6ee7b7';
      ctx.fillText('Hardware Verification: PASSED', 35, 140);
      ctx.fillText('Memory Cache: 512 MB SDRAM OK', 35, 170);
      ctx.fillText('Roles: [SA] [DEV] [QA] LOADED', 35, 200);

      // Flashing boot prompt box
      ctx.fillStyle = 'rgba(16, 185, 129, 0.2)';
      ctx.fillRect(35, 250, 440, 50);
      ctx.strokeStyle = '#34d399';
      ctx.strokeRect(35, 250, 440, 50);

      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 18px "Courier New", monospace';
      ctx.fillText('> CLICK MONITOR TO POWER ON <', 65, 282);
    }
    const screenTexture = new THREE.CanvasTexture(screenCanvas);

    // 5. Workstation Construction (Rich details, lightweight meshes)
    const workstation = new THREE.Group();
    scene.add(workstation);

    // Color Palette
    const retroBeige = new THREE.MeshLambertMaterial({ color: 0xd8d1c2 });
    const retroBeigeDark = new THREE.MeshLambertMaterial({ color: 0xb5ad9e });
    const deskWood = new THREE.MeshLambertMaterial({ color: 0x332219 });
    const darkCharcoal = new THREE.MeshLambertMaterial({ color: 0x1c1e24 });
    const screenGlassMat = new THREE.MeshBasicMaterial({ map: screenTexture });
    const greenLedMat = new THREE.MeshBasicMaterial({ color: 0x22c55e });
    const goldBadgeMat = new THREE.MeshLambertMaterial({ color: 0xd4af37 });

    // A. Desktop Wooden Surface
    const desk = new THREE.Mesh(
      new THREE.BoxGeometry(7.0, 0.15, 3.5),
      deskWood
    );
    desk.position.set(0, -1.05, 0.5);
    workstation.add(desk);

    // B. CRT Monitor Unit
    const monitorGroup = new THREE.Group();
    monitorGroup.position.set(-0.3, 0.25, 0);
    workstation.add(monitorGroup);

    // Monitor Main Housing (Tapered back)
    const monitorBody = new THREE.Mesh(
      new THREE.BoxGeometry(2.3, 1.85, 1.6),
      retroBeige
    );
    monitorGroup.add(monitorBody);

    // Back CRT Bulb cone
    const crtBackCone = new THREE.Mesh(
      new THREE.BoxGeometry(1.6, 1.3, 0.8),
      retroBeigeDark
    );
    crtBackCone.position.set(0, 0, -1.0);
    monitorGroup.add(crtBackCone);

    // Monitor Front Bezel
    const monitorBezel = new THREE.Mesh(
      new THREE.BoxGeometry(2.2, 1.75, 0.15),
      retroBeige
    );
    monitorBezel.position.set(0, 0.05, 0.82);
    monitorGroup.add(monitorBezel);

    // Curved CRT Screen Face
    const crtScreen = new THREE.Mesh(
      new THREE.PlaneGeometry(1.85, 1.35),
      screenGlassMat
    );
    crtScreen.position.set(0, 0.12, 0.91);
    monitorGroup.add(crtScreen);

    // Gold/Silver Brand Badge on bottom bezel
    const brandBadge = new THREE.Mesh(
      new THREE.BoxGeometry(0.3, 0.06, 0.02),
      goldBadgeMat
    );
    brandBadge.position.set(0, -0.68, 0.9);
    monitorGroup.add(brandBadge);

    // Power Button on Monitor with glowing LED
    const monPowerBtn = new THREE.Mesh(
      new THREE.BoxGeometry(0.12, 0.08, 0.04),
      darkCharcoal
    );
    monPowerBtn.position.set(0.85, -0.68, 0.9);
    monitorGroup.add(monPowerBtn);

    const monPowerLed = new THREE.Mesh(
      new THREE.SphereGeometry(0.025, 8, 8),
      greenLedMat
    );
    monPowerLed.position.set(0.72, -0.68, 0.91);
    monitorGroup.add(monPowerLed);

    // Monitor Stand Base & Swivel Neck
    const standNeck = new THREE.Mesh(
      new THREE.CylinderGeometry(0.22, 0.28, 0.35, 12),
      retroBeigeDark
    );
    standNeck.position.set(0, -1.0, 0);
    monitorGroup.add(standNeck);

    const standBase = new THREE.Mesh(
      new THREE.BoxGeometry(1.5, 0.08, 1.3),
      retroBeige
    );
    standBase.position.set(0, -1.18, 0.1);
    monitorGroup.add(standBase);

    // C. Computer Tower (Tower Case beside monitor)
    const towerGroup = new THREE.Group();
    towerGroup.position.set(1.7, -0.15, 0.2);
    workstation.add(towerGroup);

    const towerCase = new THREE.Mesh(
      new THREE.BoxGeometry(1.0, 2.0, 2.2),
      retroBeige
    );
    towerGroup.add(towerCase);

    // 5.25" CD-ROM Drive Bay
    const cdDrive = new THREE.Mesh(
      new THREE.BoxGeometry(0.85, 0.18, 0.05),
      retroBeigeDark
    );
    cdDrive.position.set(0, 0.72, 1.11);
    towerGroup.add(cdDrive);

    // 3.5" Floppy Disk Drive
    const floppyDrive = new THREE.Mesh(
      new THREE.BoxGeometry(0.85, 0.14, 0.05),
      retroBeigeDark
    );
    floppyDrive.position.set(0, 0.45, 1.11);
    towerGroup.add(floppyDrive);

    // Floppy activity green LED
    const floppyLed = new THREE.Mesh(
      new THREE.BoxGeometry(0.04, 0.04, 0.02),
      greenLedMat
    );
    floppyLed.position.set(-0.3, 0.45, 1.14);
    towerGroup.add(floppyLed);

    // Tower Power Switch & LED
    const towerPowerBtn = new THREE.Mesh(
      new THREE.CylinderGeometry(0.06, 0.06, 0.04, 12),
      darkCharcoal
    );
    towerPowerBtn.rotation.x = Math.PI / 2;
    towerPowerBtn.position.set(-0.25, 0.05, 1.11);
    towerGroup.add(towerPowerBtn);

    const towerPowerLed = new THREE.Mesh(
      new THREE.SphereGeometry(0.03, 8, 8),
      greenLedMat
    );
    towerPowerLed.position.set(0.25, 0.05, 1.12);
    towerGroup.add(towerPowerLed);

    // Bottom Air Intake Slits
    const ventGrill = new THREE.Mesh(
      new THREE.BoxGeometry(0.7, 0.35, 0.04),
      darkCharcoal
    );
    ventGrill.position.set(0, -0.55, 1.11);
    towerGroup.add(ventGrill);

    // D. Mechanical Keyboard
    const kbGroup = new THREE.Group();
    kbGroup.position.set(-0.3, -0.92, 1.4);
    kbGroup.rotation.x = 0.1;
    workstation.add(kbGroup);

    const kbBase = new THREE.Mesh(
      new THREE.BoxGeometry(2.3, 0.08, 0.8),
      retroBeige
    );
    kbGroup.add(kbBase);

    const kbKeys = new THREE.Mesh(
      new THREE.BoxGeometry(2.1, 0.06, 0.65),
      darkCharcoal
    );
    kbKeys.position.set(0, 0.05, 0);
    kbGroup.add(kbKeys);

    // E. Retro Mouse & Mousepad
    const mousePad = new THREE.Mesh(
      new THREE.BoxGeometry(0.9, 0.02, 1.1),
      new THREE.MeshLambertMaterial({ color: 0x1d4ed8 }) // Classic Blue Mousepad
    );
    mousePad.position.set(1.4, -0.96, 1.4);
    workstation.add(mousePad);

    const mouseMesh = new THREE.Mesh(
      new THREE.BoxGeometry(0.32, 0.12, 0.5),
      retroBeige
    );
    mouseMesh.position.set(1.4, -0.91, 1.4);
    workstation.add(mouseMesh);

    // 6. Smooth Mouse Orbit & Parallax (Silky 60fps)
    let isDragging = false;
    let prevMouseX = 0;
    let prevMouseY = 0;
    let rotY = 0;
    let rotX = 0;

    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      prevMouseX = e.clientX;
      prevMouseY = e.clientY;
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    window.addEventListener('mousemove', (e) => {
      if (isDragging) {
        const dx = e.clientX - prevMouseX;
        const dy = e.clientY - prevMouseY;
        rotY += dx * 0.005;
        rotX += dy * 0.003;
        rotX = Math.max(-0.25, Math.min(0.25, rotX));
        prevMouseX = e.clientX;
        prevMouseY = e.clientY;
      } else {
        const nx = (e.clientX / window.innerWidth) * 2 - 1;
        const ny = -(e.clientY / window.innerHeight) * 2 + 1;
        camera.position.x += (nx * 0.35 - camera.position.x) * 0.04;
        camera.position.y += (1.4 + ny * 0.2 - camera.position.y) * 0.04;
        camera.lookAt(0, 0.1, 0);
      }
    });

    // Touch support for mobile
    container.addEventListener('touchmove', (e) => {
      if (e.touches.length === 1) {
        const t = e.touches[0];
        const nx = (t.clientX / window.innerWidth) * 2 - 1;
        rotY = nx * 0.45;
      }
    }, { passive: true });

    // Boot trigger on click
    container.addEventListener('click', () => {
      triggerBoot();
    });
    powerBtn?.addEventListener('click', () => {
      triggerBoot();
    });

    // 7. Boot Sequence: Zoom into CRT & Play Real Windows XP Audio
    let isBooting = false;
    let animFrameId: number;

    function triggerBoot() {
      if (isBooting) return;
      isBooting = true;

      // Play the authentic Windows XP Startup sound!
      playRealXpSound('/sounds/xp-startup.wav');

      const startPos = { ...camera.position };
      const targetPos = { x: -0.3, y: 0.38, z: 1.15 };
      const duration = 1200;
      const startTime = performance.now();

      function animateZoom(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const ease = progress < 0.5
          ? 4 * progress * progress * progress
          : 1 - Math.pow(-2 * progress + 2, 3) / 2;

        camera.position.x = startPos.x + (targetPos.x - startPos.x) * ease;
        camera.position.y = startPos.y + (targetPos.y - startPos.y) * ease;
        camera.position.z = startPos.z + (targetPos.z - startPos.z) * ease;
        camera.lookAt(-0.3, 0.38, 0.91);

        if (progress < 1) {
          requestAnimationFrame(animateZoom);
        } else {
          // Transition to Windows XP Desktop
          window.dispatchEvent(new CustomEvent('xp:boot-desktop'));

          // CRITICAL LAG FIX: Cancel Three.js render loop while in Desktop!
          cancelAnimationFrame(animFrameId);

          if (stage) {
            stage.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
              stage.classList.add('hidden');
            }, 700);
          }
        }
      }
      requestAnimationFrame(animateZoom);
    }

    // Play authentic audio file
    function playRealXpSound(soundPath: string) {
      try {
        const audio = new Audio(soundPath);
        audio.volume = 0.85;
        audio.play().catch(err => {
          console.warn('Audio autoplay blocked by browser gesture policy:', err);
        });
      } catch (e) {
        console.error('Audio playback error:', e);
      }
    }

    // 8. 60 FPS Render Loop with Zero Lag
    function renderLoop() {
      animFrameId = requestAnimationFrame(renderLoop);

      if (!isBooting) {
        workstation.rotation.y += (rotY - workstation.rotation.y) * 0.08;
        workstation.rotation.x += (rotX - workstation.rotation.x) * 0.08;
      }

      renderer.render(scene, camera);
    }
    renderLoop();

    // Resize
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // Restore 3D workstation when user clicks "Turn Off Computer" in Windows XP
    window.addEventListener('xp:shutdown-to-3d', () => {
      isBooting = false;
      playRealXpSound('/sounds/xp-shutdown.wav');
      camera.position.set(0, 1.4, 5.2);
      camera.lookAt(0, 0.1, 0);

      if (stage) {
        stage.classList.remove('hidden');
        setTimeout(() => {
          stage.classList.remove('opacity-0', 'pointer-events-none');
          // Resume Three.js render loop
          renderLoop();
        }, 50);
      }
    });
  }
</script>
