  function updateNotepadStatus() {
    if (!notepadTextarea || !notepadStatus) return;
    const text = notepadTextarea.value;
    const lines = text.substr(0, notepadTextarea.selectionStart).split('\n');
    const line = lines.length;
    const col = lines[lines.length - 1].length + 1;
    notepadStatus.innerText = `Ln ${line}, Col ${col}`;
  }

  function loadNotepadNotes() {
    if (!notepadTextarea) return;
    try {
      const saved = localStorage.getItem('xp-notepad-notes');
      if (saved !== null) {
        notepadTextarea.value = saved;
      }
    } catch (e) {
      console.warn('localStorage not available for notepad');
    }
    updateNotepadStatus();
  }

  notepadTextarea?.addEventListener('input', () => {
    try {
      localStorage.setItem('xp-notepad-notes', notepadTextarea.value);
    } catch (e) {
      // ignore storage errors
    }
    updateNotepadStatus();
  });

  notepadTextarea?.addEventListener('keyup', updateNotepadStatus);
