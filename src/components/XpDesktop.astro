            <pre class="font-mono text-[11px] bg-slate-950 text-indigo-300 p-3 rounded overflow-x-auto">// Implementasi di MitraController.php
DB::transaction(function() use ($request) &#123;
    $last = RefMitra::whereYear('created_at', now()->year)
        ->lockForUpdate() // Kunci baris hingga transaksi commit
        ->latest('id')
        ->first();

    $urutan = $last ? ($last->urutan + 1) : 1;
    $kode = sprintf('PUMK-%s-%03d', now()->year, $urutan);

    return RefMitra::create(array_merge($request->validated(), [
        'kode_mitra' => $kode,
        'urutan' => $urutan,
