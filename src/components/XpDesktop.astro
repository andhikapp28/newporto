        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      }
    };

    if (runActions[cmd]) {
      runActions[cmd]();
    } else {
      // Unknown command: shake the dialog and keep it open briefly
      if (runWin) {
        runWin.classList.add('xp-shake');
        setTimeout(() => runWin?.classList.remove('xp-shake'), 300);
      }
    }
  }

  runOkBtn?.addEventListener('click', () => executeRunCommand(runInput?.value || ''));
  runCancelBtn?.addEventListener('click', () => {
    const runWin = document.getElementById('win-run');
    if (runWin) closeWindow(runWin);
  });
  runInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') executeRunCommand(runInput.value);
    if (e.key === 'Escape') {
      const runWin = document.getElementById('win-run');
      if (runWin) closeWindow(runWin);
    }
  });

  // 11. Command Prompt (cmd.exe)
  const cmdInput = document.getElementById('cmd-input') as HTMLInputElement;
  const cmdOutput = document.getElementById('cmd-output');
  const cmdScreen = document.getElementById('cmd-screen');

  cmdInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const val = cmdInput.value.trim().toLowerCase();
      if (!val) return;

      const line = document.createElement('div');
      line.innerHTML = `<span class="text-slate-400">C:\\Users\\Andhika&gt;</span> <span class="text-white">${cmdInput.value}</span>`;
      cmdOutput?.appendChild(line);

      const resp = document.createElement('div');
      resp.className = 'text-emerald-300 pl-2';

      if (val === 'help') {
        resp.innerHTML = `
          Perintah yang tersedia:<br/>
          &bull; <span class="text-yellow-300">andhika</span>  - Profil Andhika Putra Pratama<br/>
          &bull; <span class="text-yellow-300">skills</span>   - Matriks keahlian SA, Dev &amp; QA<br/>
          &bull; <span class="text-yellow-300">contact</span>  - Email &amp; saluran komunikasi<br/>
          &bull; <span class="text-yellow-300">projects</span> - Daftar studi kasus portofolio<br/>
          &bull; <span class="text-yellow-300">resume</span>   - Buka CV / Resume<br/>
          &bull; <span class="text-yellow-300">gallery</span>  - Buka galeri sertifikat<br/>
          &bull; <span class="text-yellow-300">media</span>    - Buka Windows Media Player<br/>
          &bull; <span class="text-yellow-300">sdlc</span>     - Buka SDLC Lens<br/>
          &bull; <span class="text-yellow-300">notepad</span>  - Buka Notepad<br/>
          &bull; <span class="text-yellow-300">search</span>   - Buka Search Companion<br/>
          &bull; <span class="text-yellow-300">shutdown</span> - Matikan komputer<br/>
          &bull; <span class="text-yellow-300">clear</span>    - Bersihkan layar terminal
        `;
      } else if (val === 'andhika') {
        resp.innerHTML = `
          Andhika Putra Pratama, S.Kom. (Dipa) - System Analyst &amp; Solution Architect<br/>
          Lulusan S1 Teknik Informatika ITERA (IPK: 3.73 / TOEFL: 640)<br/>
          Email: andhikapp28@gmail.com | GitHub: github.com/andhikapp28
        `;
      } else if (val === 'projects') {
        resp.innerHTML = `
          Studi kasus portofolio tersedia di desktop:<br/>
          &bull; Aplikasi PUMK - TJSL Perum DAMRI<br/>
          &bull; Push Request Tracker - Audit &amp; Deployment IT DAMRI<br/>
          Klik ikon Case Studies (E:) atau buka lewat Start Menu.
        `;
      } else if (val === 'skills') {
        resp.innerHTML = `
          [SA]: BRD/SRS, BPMN 2.0, Kamus Data, Skema Relasional ERD 3NF, SSO Auth<br/>
          [DEV]: Laravel 12, PostgreSQL, Concurrency Locks, GitHub API, REST<br/>
          [QA]: Boundary Testing, Test Cases Matrix, Postman API Testing
        `;
      } else if (val === 'contact') {
        resp.innerHTML = `Email: andhikapp28@gmail.com | GitHub: andhikapp28`;
      } else if (val === 'resume') {
        (window as any).openWindow('win-resume');
        resp.innerHTML = 'Membuka Resume.doc...';
      } else if (val === 'projects') {
        (window as any).openWindow('win-projects');
        resp.innerHTML = 'Membuka daftar studi kasus...';
      } else if (val === 'gallery') {
        (window as any).openWindow('win-gallery');
        resp.innerHTML = 'Membuka galeri sertifikat...';
      } else if (val === 'media') {
        (window as any).openWindow('win-media-player');
        resp.innerHTML = 'Membuka Windows Media Player...';
      } else if (val === 'sdlc') {
        (window as any).openWindow('win-sdlc');
        resp.innerHTML = 'Membuka SDLC_Lens.exe...';
      } else if (val === 'notepad') {
        (window as any).openWindow('win-notepad');
        resp.innerHTML = 'Membuka Notepad...';
      } else if (val === 'search') {
        (window as any).openWindow('win-search');
        resp.innerHTML = 'Membuka Search Companion...';
      } else if (val === 'shutdown') {
        const modal = document.getElementById('xp-shutdown-modal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
        resp.innerHTML = 'Membuka dialog shutdown...';
      } else if (val === 'clear') {
        if (cmdOutput) cmdOutput.innerHTML = '';
        cmdInput.value = '';
        return;
      } else {
        resp.innerHTML = `'${val}' tidak dikenali. Ketik 'help' untuk panduan.`;
      }

      cmdOutput?.appendChild(resp);
      cmdInput.value = '';
      if (cmdScreen) cmdScreen.scrollTop = cmdScreen.scrollHeight;
    }
  });

  // 11b. Recycle Bin
  const recycleItemsList = document.getElementById('recycle-items-list');

  function addToRecycleBin(winId: string) {
    const win = document.getElementById(winId);
    if (!win) return;
    const title = win.querySelector('.xp-titlebar span')?.textContent || winId;
    if (!Array.isArray(recycleBinItems)) recycleBinItems = [];
    recycleBinItems = recycleBinItems.filter(i => i.id !== winId);
    recycleBinItems.unshift({ id: winId, title, closedAt: new Date().toLocaleTimeString() });
    if (recycleBinItems.length > 10) recycleBinItems = recycleBinItems.slice(0, 10);
    renderRecycleBin();
  }

  function renderRecycleBin() {
    if (!recycleItemsList) return;
    if (recycleBinItems.length === 0) {
      recycleItemsList.innerHTML = `<div class="p-3 text-[11px] text-slate-500 italic i18n" data-en="The Recycle Bin is empty." data-id="Tempat Sampah kosong.">Tempat Sampah kosong.</div>`;
      return;
    }
    recycleItemsList.innerHTML = recycleBinItems.map((item, idx) => `
      <div class="p-2 rounded border border-slate-200 bg-slate-50 flex items-center justify-between gap-2 group hover:border-blue-300">
        <div class="flex items-center gap-2 min-w-0">
          <svg class="w-4 h-4 text-slate-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          <div class="truncate text-xs text-slate-800 font-semibold">${item.title}</div>
          <div class="text-[10px] text-slate-500 shrink-0">${item.closedAt}</div>
        </div>
        <button
          class="px-2 py-0.5 rounded bg-[#ece9d8] border border-[#7f9db9] text-[10px] font-bold hover:bg-white cursor-pointer shrink-0 i18n"
          data-en="Restore"
          data-id="Pulihkan"
          onclick="window.openWindow('${item.id}')"
        >Pulihkan</button>
      </div>
    `).join('');
  }

  renderRecycleBin();

  // 12. Shutdown Dialog

  const openShutdownBtn = document.getElementById('xp-open-shutdown-btn');
  const shutdownModal = document.getElementById('xp-shutdown-modal');
  const modalTurnOff = document.getElementById('modal-btn-turn-off');
  const shutdownScreen = document.getElementById('xp-shutdown-screen');

  openShutdownBtn?.addEventListener('click', () => {
    startMenu?.classList.add('hidden');
    if (shutdownModal) {
      shutdownModal.classList.remove('hidden');
      shutdownModal.classList.add('flex');
    }
  });

  modalTurnOff?.addEventListener('click', () => {
    shutdownModal?.classList.add('hidden');
    shutdownModal?.classList.remove('flex');

    if (shutdownScreen) {
      shutdownScreen.classList.remove('hidden');
      shutdownScreen.classList.add('flex');
    }

    try {
      const assetBase = document.getElementById('xp-desktop-container')?.dataset.baseUrl || '';
      const audio = new Audio(`${assetBase}/sounds/xp-shutdown.wav`);
      audio.play().catch(e => console.warn(e));
    } catch (e) {
      console.error(e);
    }

    setTimeout(() => {
      if (shutdownScreen) {
        shutdownScreen.classList.add('hidden');
        shutdownScreen.classList.remove('flex');
      }
      const desktop = document.getElementById('xp-desktop-container');
      if (desktop) {
        desktop.classList.add('hidden');
        desktop.classList.remove('flex');
      }
      window.dispatchEvent(new CustomEvent('xp:shutdown-to-3d'));
    }, 2500);
  });

  // 13. Copy Email
  const copyBtn = document.getElementById('xp-copy-email-btn');
  const copyIcon = document.getElementById('xp-copy-icon');
  const copiedIcon = document.getElementById('xp-copied-icon');
  const copyText = document.getElementById('xp-copy-text');

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText('andhikapp28@gmail.com').then(() => {
      copyIcon?.classList.add('hidden');
      copiedIcon?.classList.remove('hidden');
      if (copyText) copyText.innerText = 'Tersalin!';
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        copiedIcon?.classList.add('hidden');
        if (copyText) copyText.innerText = 'Salin Email';
      }, 2000);
    });
  });
</script>
