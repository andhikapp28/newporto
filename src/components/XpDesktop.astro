        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Work Docs" data-id="Dokumen Kerja">
          Dokumen Kerja
        </span>
