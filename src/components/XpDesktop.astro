          <span class="truncate">${t.title}</span>
        </div>
        <span class="text-[9px] text-slate-400 font-mono shrink-0">Lo-Fi</span>
      </div>
    `).join('');
  }

  // Initialize YouTube IFrame API
  (window as any).onYouTubeIframeAPIReady = function() {
    try {
      ytPlayerInstance = new (window as any).YT.Player('wmp-yt-iframe', {
        height: '0',
        width: '0',
        videoId: lofiPlaylist[0].id,
        playerVars: {
          autoplay: 0,
          controls: 0,
          disablekb: 1,
          fs: 0
        },
        events: {
          onStateChange: (event: any) => {
            if (event.data === (window as any).YT.PlayerState.PLAYING) {
              setWmpPlayingState(true);
            } else if (event.data === (window as any).YT.PlayerState.PAUSED || event.data === (window as any).YT.PlayerState.ENDED) {
              setWmpPlayingState(false);
              if (event.data === (window as any).YT.PlayerState.ENDED) {
                playTrack((currentTrackIdx + 1) % lofiPlaylist.length);
              }
            }
          }
        }
      });
    } catch (e) {
      console.warn('YouTube API init fallback:', e);
    }
  };

  function setWmpPlayingState(playing: boolean) {
    isWmpPlaying = playing;
    const playIcon = document.getElementById('wmp-play-icon');
    const pauseIcon = document.getElementById('wmp-pause-icon');
    const statusText = document.getElementById('wmp-status-text');
    const statusDot = document.getElementById('wmp-status-dot');

    if (playing) {
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');
      if (statusText) statusText.innerText = '► Playing';
      if (statusDot) statusDot.className = 'w-2 h-2 rounded-xs bg-emerald-400 animate-pulse';

      // Scrubber timer
      clearInterval(wmpScrubInterval);
      wmpScrubInterval = setInterval(() => {
        if (ytPlayerInstance && ytPlayerInstance.getCurrentTime) {
          const cur = ytPlayerInstance.getCurrentTime() || 0;
          const dur = ytPlayerInstance.getDuration() || 180;
          const pct = Math.min(100, (cur / dur) * 100);
          const bar = document.getElementById('wmp-progress-bar');
          if (bar) bar.style.width = `${pct}%`;
          const timeEl = document.getElementById('wmp-time-display');
          if (timeEl) {
            const m = Math.floor(cur / 60);
            const s = Math.floor(cur % 60).toString().padStart(2, '0');
            timeEl.innerText = `${m}:${s}`;
          }
        }
      }, 500);
    } else {
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');
      if (statusText) statusText.innerText = '■ Stopped';
      if (statusDot) statusDot.className = 'w-2 h-2 rounded-xs bg-lime-400';
      clearInterval(wmpScrubInterval);
    }
  }

  function playTrack(idx: number) {
    currentTrackIdx = idx;
    const t = lofiPlaylist[idx];
    const titleEl = document.getElementById('wmp-track-title');
    const artistEl = document.getElementById('wmp-artist');
    if (titleEl) titleEl.innerText = t.title;
    if (artistEl) artistEl.innerText = `${t.artist} • YouTube LoFi`;

    // Highlight row in playlist
    document.querySelectorAll('.wmp-track-row').forEach((r, rIdx) => {
      if (rIdx === idx) {
        r.classList.add('bg-blue-50', 'font-bold', 'text-blue-900');
      } else {
        r.classList.remove('bg-blue-50', 'font-bold', 'text-blue-900');
      }
    });

    if (ytPlayerInstance && ytPlayerInstance.loadVideoById) {
      ytPlayerInstance.loadVideoById(t.id);
      ytPlayerInstance.playVideo();
    } else {
      // Fallback to local audio
      if (!localAudioFallback) {
        const assetBase = document.getElementById('xp-desktop-container')?.dataset.baseUrl || '';
        localAudioFallback = new Audio(`${assetBase}/sounds/xp-startup.wav`);
      }
      localAudioFallback.play().catch(e => console.warn(e));
      setWmpPlayingState(true);
    }
  }

  document.querySelectorAll('.wmp-track-row').forEach(row => {
    row.addEventListener('click', () => {
      const idx = parseInt(row.getAttribute('data-track-idx') || '0', 10);
      playTrack(idx);
    });
  });

  document.getElementById('wmp-play-toggle')?.addEventListener('click', () => {
    if (!isWmpPlaying) {
      if (ytPlayerInstance && ytPlayerInstance.playVideo) {
        ytPlayerInstance.playVideo();
      } else {
        playTrack(currentTrackIdx);
      }
    } else {
      if (ytPlayerInstance && ytPlayerInstance.pauseVideo) {
        ytPlayerInstance.pauseVideo();
      } else if (localAudioFallback) {
        localAudioFallback.pause();
        setWmpPlayingState(false);
      }
    }
  });

  document.getElementById('wmp-stop-btn')?.addEventListener('click', () => {
    if (ytPlayerInstance && ytPlayerInstance.stopVideo) {
      ytPlayerInstance.stopVideo();
    }
    if (localAudioFallback) {
      localAudioFallback.pause();
      localAudioFallback.currentTime = 0;
    }
    setWmpPlayingState(false);
    const bar = document.getElementById('wmp-progress-bar');
    if (bar) bar.style.width = '0%';
  });

  document.getElementById('wmp-prev-btn')?.addEventListener('click', () => {
    const prev = (currentTrackIdx - 1 + lofiPlaylist.length) % lofiPlaylist.length;
    playTrack(prev);
  });

  document.getElementById('wmp-next-btn')?.addEventListener('click', () => {
    const next = (currentTrackIdx + 1) % lofiPlaylist.length;
    playTrack(next);
  });

  // 9. Rover Search Companion
  const roverInput = document.getElementById('rover-search-input') as HTMLInputElement;
  const roverBtn = document.getElementById('rover-search-btn');
  const roverSpeech = document.getElementById('rover-speech');
  const roverResults = document.getElementById('rover-results-list');

  function runRoverSearch() {
    const q = roverInput?.value.trim().toLowerCase();
    if (!roverResults) return;

    if (!q) {
      if (roverSpeech) roverSpeech.innerText = 'Tulis kata kunci pencarian, saya akan mencarikannya untukmu!';
      return;
    }

    if (roverSpeech) {
      roverSpeech.innerText = `Woof! Menemukan dokumen & proyek terkait "${q}"!`;
    }

    const items = roverResults.querySelectorAll('div.p-2\\.5');
    items.forEach(item => {
      const text = (item as HTMLElement).innerText.toLowerCase();
      if (text.includes(q)) {
        (item as HTMLElement).style.display = 'block';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  }

  roverBtn?.addEventListener('click', runRoverSearch);
  roverInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') runRoverSearch();
  });

  // 10. SDLC Lens Tabs
  const sdlcSelect = document.getElementById('sdlc-feature-select') as HTMLSelectElement;
  const sdlcTabs = document.querySelectorAll('.xp-lens-tab');

  sdlcSelect?.addEventListener('change', () => {
    const val = sdlcSelect.value;
    if (val === 'pumk') {
      document.getElementById('sdlc-content-pumk')?.classList.remove('hidden');
      document.getElementById('sdlc-content-push')?.classList.add('hidden');
    } else {
      document.getElementById('sdlc-content-pumk')?.classList.add('hidden');
      document.getElementById('sdlc-content-push')?.classList.remove('hidden');
    }
  });

  sdlcTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const view = tab.getAttribute('data-view');
      sdlcTabs.forEach((t) => {
        t.classList.remove('active', 'bg-white', 'border-t-2', 'border-l-2', 'border-r-2', 'text-blue-900');
        t.classList.add('bg-[#ece9d8]', 'text-slate-700');
      });
      tab.classList.add('active', 'bg-white', 'border-t-2', 'border-l-2', 'border-r-2', 'text-blue-900');
      tab.classList.remove('bg-[#ece9d8]', 'text-slate-700');

      document.getElementById('xp-view-analyst')?.classList.add('hidden');
      document.getElementById('xp-view-dev')?.classList.add('hidden');
      document.getElementById('xp-view-qa')?.classList.add('hidden');

      if (view === 'analyst') document.getElementById('xp-view-analyst')?.classList.remove('hidden');
      if (view === 'dev') document.getElementById('xp-view-dev')?.classList.remove('hidden');
      if (view === 'qa') document.getElementById('xp-view-qa')?.classList.remove('hidden');
    });
  });

  // 11. Command Prompt (cmd.exe)
  const cmdInput = document.getElementById('cmd-input') as HTMLInputElement;
  const cmdOutput = document.getElementById('cmd-output');
  const cmdScreen = document.getElementById('cmd-screen');

  cmdInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const val = cmdInput.value.trim().toLowerCase();
      if (!val) return;

      const line = document.createElement('div');
      line.innerHTML = `<span class="text-slate-400">C:\\Users\\Andhika&gt;</span> <span class="text-white">${cmdInput.value}</span>`;
      cmdOutput?.appendChild(line);

      const resp = document.createElement('div');
      resp.className = 'text-emerald-300 pl-2';

      if (val === 'help') {
        resp.innerHTML = `
          Perintah yang tersedia:<br/>
          &bull; <span class="text-yellow-300">andhika</span>  - Profil Andhika Putra Pratama<br/>
          &bull; <span class="text-yellow-300">pumk</span>     - Detail arsitektur aplikasi PUMK<br/>
          &bull; <span class="text-yellow-300">push</span>     - Detail aplikasi Push Request Tracker<br/>
          &bull; <span class="text-yellow-300">skills</span>   - Matriks keahlian SA, Dev &amp; QA<br/>
          &bull; <span class="text-yellow-300">contact</span>  - Email &amp; saluran komunikasi<br/>
          &bull; <span class="text-yellow-300">clear</span>    - Bersihkan layar terminal
        `;
      } else if (val === 'andhika') {
        resp.innerHTML = `
          Andhika Putra Pratama, S.Kom. (Dipa) - System Analyst &amp; Solution Architect<br/>
          Lulusan S1 Teknik Informatika ITERA (IPK: 3.73 / TOEFL: 640)<br/>
          Email: andhikapp28@gmail.com | GitHub: github.com/andhikapp28
        `;
      } else if (val === 'pumk') {
        resp.innerHTML = `
          [PUMK DAMRI]: Sistem Pembinaan &amp; Pembiayaan UMKM BUMN.<br/>
          - Validasi NIK 16 digit &amp; penomoran unik via lockForUpdate<br/>
          - Integrasi Shadow User ke database SSO DAMRI<br/>
          - Kamus data teknis 32KB
        `;
      } else if (val === 'push') {
        resp.innerHTML = `
          [PUSH REQUEST DAMRI]: Sistem Audit Commit &amp; Manajemen Proyek IT.<br/>
          - Webhook GitHub API &amp; diff audit status pull ke production<br/>
          - Kanban board task &amp; milestone checklist
        `;
      } else if (val === 'skills') {
        resp.innerHTML = `
          [SA]: BRD/SRS, BPMN 2.0, Kamus Data, Skema Relasional ERD 3NF, SSO Auth<br/>
          [DEV]: Laravel 12, PostgreSQL, Concurrency Locks, GitHub API, REST<br/>
          [QA]: Boundary Testing, Test Cases Matrix, Postman API Testing
        `;
      } else if (val === 'contact') {
        resp.innerHTML = `Email: andhikapp28@gmail.com | GitHub: andhikapp28`;
      } else if (val === 'clear') {
        if (cmdOutput) cmdOutput.innerHTML = '';
        cmdInput.value = '';
        return;
      } else {
        resp.innerHTML = `'${val}' tidak dikenali. Ketik 'help' untuk panduan.`;
      }

      cmdOutput?.appendChild(resp);
      cmdInput.value = '';
      if (cmdScreen) cmdScreen.scrollTop = cmdScreen.scrollHeight;
    }
  });

  // 12. Shutdown Dialog
  const openShutdownBtn = document.getElementById('xp-open-shutdown-btn');
  const shutdownModal = document.getElementById('xp-shutdown-modal');
  const modalTurnOff = document.getElementById('modal-btn-turn-off');
  const shutdownScreen = document.getElementById('xp-shutdown-screen');

  openShutdownBtn?.addEventListener('click', () => {
    startMenu?.classList.add('hidden');
    if (shutdownModal) {
      shutdownModal.classList.remove('hidden');
      shutdownModal.classList.add('flex');
    }
  });

  modalTurnOff?.addEventListener('click', () => {
    shutdownModal?.classList.add('hidden');
    shutdownModal?.classList.remove('flex');

    if (shutdownScreen) {
      shutdownScreen.classList.remove('hidden');
      shutdownScreen.classList.add('flex');
    }

    try {
      const assetBase = document.getElementById('xp-desktop-container')?.dataset.baseUrl || '';
      const audio = new Audio(`${assetBase}/sounds/xp-shutdown.wav`);
      audio.play().catch(e => console.warn(e));
    } catch (e) {
      console.error(e);
    }

    setTimeout(() => {
      if (shutdownScreen) {
        shutdownScreen.classList.add('hidden');
        shutdownScreen.classList.remove('flex');
      }
      const desktop = document.getElementById('xp-desktop-container');
      if (desktop) {
        desktop.classList.add('hidden');
        desktop.classList.remove('flex');
      }
      window.dispatchEvent(new CustomEvent('xp:shutdown-to-3d'));
    }, 2500);
  });

  // 13. Copy Email
  const copyBtn = document.getElementById('xp-copy-email-btn');
  const copyIcon = document.getElementById('xp-copy-icon');
  const copiedIcon = document.getElementById('xp-copied-icon');
  const copyText = document.getElementById('xp-copy-text');

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText('andhikapp28@gmail.com').then(() => {
      copyIcon?.classList.add('hidden');
      copiedIcon?.classList.remove('hidden');
      if (copyText) copyText.innerText = 'Tersalin!';
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        copiedIcon?.classList.add('hidden');
        if (copyText) copyText.innerText = 'Salin Email';
      }, 2000);
    });
  });
</script>
