      <!-- Right Column -->
      <div class="w-1/2 p-2 space-y-1 text-slate-700">
        <div class="p-1.5 font-bold hover:bg-blue-200/50 rounded cursor-pointer" onclick="document.querySelector('[data-open=\'win-explorer\']').click(); document.getElementById('xp-start-menu').classList.add('hidden');">
          My Computer
        </div>
        <div class="p-1.5 font-bold hover:bg-blue-200/50 rounded cursor-pointer" onclick="document.querySelector('[data-open=\'win-sdlc\']').click(); document.getElementById('xp-start-menu').classList.add('hidden');">
          SDLC Lens
        </div>
        <div class="p-1.5 font-bold hover:bg-blue-200/50 rounded cursor-pointer" onclick="document.querySelector('[data-open=\'win-contact\']').click(); document.getElementById('xp-start-menu').classList.add('hidden');">
          Outlook Express
        </div>
      </div>
    </div>

    <!-- Footer Turn Off Computer -->
    <div class="h-9 px-3 flex items-center justify-end gap-3 bg-gradient-to-r from-[#0058ee] to-[#3593ff] text-white select-none">
      <button
        id="xp-open-shutdown-btn"
        class="flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-[#c75050] hover:bg-[#e04343] border border-white/50 text-xs font-bold shadow cursor-pointer active:scale-95"
      >
        <Power class="w-3 h-3" />
        <span class="i18n" data-en="Turn Off Computer" data-id="Matikan Komputer">Turn Off Computer</span>
      </button>
    </div>
  </div>

  <!-- ==================== TASKBAR (PINNED AT BOTTOM) ==================== -->
  <div 
    id="xp-taskbar" 
    class="relative z-[9999] h-[30px] w-full bg-gradient-to-b from-[#245edb] via-[#3f8cf3] to-[#1941a5] border-t border-[#468df2] flex items-center justify-between select-none shadow-lg shrink-0"
  >
    <!-- Start Button -->
    <div class="flex items-center h-full">
      <button
        id="xp-start-btn"
        class="h-full px-3.5 rounded-r-xl bg-gradient-to-b from-[#388e3c] via-[#4caf50] to-[#2e7d32] hover:brightness-110 active:brightness-90 border-r border-[#1b5e20] shadow-[inset_1px_1px_1px_rgba(255,255,255,0.7)] flex items-center gap-1.5 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 drop-shadow" viewBox="0 0 24 24">
          <rect x="2" y="2" width="9" height="9" fill="#f44336" rx="1" />
          <rect x="13" y="2" width="9" height="9" fill="#4caf50" rx="1" />
          <rect x="2" y="13" width="9" height="9" fill="#2196f3" rx="1" />
          <rect x="13" y="13" width="9" height="9" fill="#ffeb3b" rx="1" />
        </svg>
        <span class="font-black italic text-white text-xs drop-shadow-[1px_1px_2px_rgba(0,0,0,0.8)] i18n" data-en="start" data-id="mulai">
          start
        </span>
      </button>

      <!-- Taskbar Open Window Tabs (Dynamic Sync: Only open windows appear!) -->
      <div id="xp-taskbar-items" class="flex items-center gap-1 px-1.5 h-full overflow-x-auto">
      </div>
    </div>

    <!-- System Tray (Notification Area & Language Switcher) -->
    <div class="h-full px-2.5 bg-gradient-to-b from-[#0f388a] via-[#16439e] to-[#0d2f78] border-l border-[#194bb5] shadow-inner flex items-center gap-2.5 text-xs text-white font-mono">
      <!-- Language Switcher Button [ ID | EN ] -->
      <button 
        id="lang-toggle-btn"
        class="px-1.5 py-0.5 rounded bg-blue-950/80 border border-blue-400/40 text-[10px] font-bold text-amber-300 hover:bg-blue-900 cursor-pointer"
        title="Switch Language (ID / EN)"
      >
        ID &bull; EN
      </button>

      <Volume2 class="w-3 h-3 text-blue-200" />
      <span id="xp-clock" class="text-[11px]">12:00 PM</span>
    </div>
  </div>
</div>

<style>
  @keyframes tailWag {
    0% { transform: rotate(0deg); }
    50% { transform: rotate(18deg); }
    100% { transform: rotate(0deg); }
  }
  .rover-tail {
    animation: tailWag 0.6s ease-in-out infinite;
    transform-origin: 74px 65px;
  }
</style>

<script>
  // 1. Boot event listener from 3D stage
  window.addEventListener('xp:boot-desktop', () => {
    const desktop = document.getElementById('xp-desktop-container');
    if (desktop) {
      desktop.classList.remove('hidden');
      desktop.classList.add('flex');
    }
    const welcome = document.getElementById('win-welcome');
    if (welcome) {
      welcome.classList.remove('hidden');
      welcome.style.display = 'flex';
      bringToFront(welcome);
    }
    updateTaskbar();
  });

  // 2. Language Switcher (ID <-> EN)
  let currentLang = 'id';
  const langBtn = document.getElementById('lang-toggle-btn');

  function applyLanguage(lang: string) {
    currentLang = lang;
    const elements = document.querySelectorAll<HTMLElement>('.i18n');
    elements.forEach(el => {
      const text = el.getAttribute(`data-${lang}`);
      if (text) el.innerHTML = text;
    });
    if (langBtn) {
      langBtn.innerText = lang.toUpperCase();
    }
  }

  langBtn?.addEventListener('click', () => {
    const nextLang = currentLang === 'id' ? 'en' : 'id';
    applyLanguage(nextLang);
  });
  applyLanguage('id');

  // 3. Start Menu Toggle
  const startBtn = document.getElementById('xp-start-btn');
  const startMenu = document.getElementById('xp-start-menu');

  startBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    startMenu?.classList.toggle('hidden');
    startMenu?.classList.toggle('flex');
  });

  document.addEventListener('click', (e) => {
    if (startMenu && !startMenu.contains(e.target as Node) && e.target !== startBtn) {
      startMenu.classList.add('hidden');
      startMenu.classList.remove('flex');
    }
  });

  // 4. System Tray Clock
  function updateClock() {
    const clockEl = document.getElementById('xp-clock');
    if (!clockEl) return;
    const now = new Date();
    let hours = now.getHours();
    const minutes = now.getMinutes().toString().padStart(2, '0');
    const ampm = hours >= 12 ? 'PM' : 'AM';
    hours = hours % 12 || 12;
    clockEl.innerText = `${hours}:${minutes} ${ampm}`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // 5. Draggable & Resizable Windows Logic
  let highestZIndex = 30;

  function bringToFront(win: HTMLElement) {
    highestZIndex += 1;
    win.style.zIndex = highestZIndex.toString();
  }

  const windows = document.querySelectorAll<HTMLElement>('.xp-window');
  windows.forEach((win) => {
    win.addEventListener('mousedown', () => bringToFront(win));

    // Titlebar drag
    const titlebar = win.querySelector<HTMLElement>('.xp-titlebar');
    if (titlebar) {
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let initialLeft = 0;
      let initialTop = 0;

      titlebar.addEventListener('mousedown', (e) => {
        isDragging = true;
        bringToFront(win);
        startX = e.clientX;
        startY = e.clientY;
        initialLeft = win.offsetLeft;
        initialTop = win.offsetTop;

        function onMouseMove(moveEvent: MouseEvent) {
          if (!isDragging) return;
          const dx = moveEvent.clientX - startX;
          const dy = moveEvent.clientY - startY;
          win.style.left = `${Math.max(0, initialLeft + dx)}px`;
          win.style.top = `${Math.max(0, initialTop + dy)}px`;
        }

        function onMouseUp() {
          isDragging = false;
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
        }

        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      });
    }

    // Window Resizing via bottom-right grip handle
    const resizeHandle = win.querySelector<HTMLElement>('.win-resize-handle');
    if (resizeHandle) {
      let isResizing = false;
      let startW = 0;
      let startH = 0;
      let startX = 0;
      let startY = 0;

      resizeHandle.addEventListener('mousedown', (e) => {
        e.stopPropagation();
        isResizing = true;
        bringToFront(win);
        startX = e.clientX;
        startY = e.clientY;
        startW = win.offsetWidth;
        startH = win.offsetHeight;

        function onResizeMove(moveEvent: MouseEvent) {
          if (!isResizing) return;
          const dw = moveEvent.clientX - startX;
          const dh = moveEvent.clientY - startY;
          win.style.width = `${Math.max(320, startW + dw)}px`;
          win.style.height = `${Math.max(220, startH + dh)}px`;
        }

        function onResizeUp() {
          isResizing = false;
          window.removeEventListener('mousemove', onResizeMove);
          window.removeEventListener('mouseup', onResizeUp);
        }

        window.addEventListener('mousemove', onResizeMove);
        window.addEventListener('mouseup', onResizeUp);
      });
    }

    // Window controls
    const btnClose = win.querySelector('.win-btn-close');
    btnClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      win.classList.add('hidden');
      win.style.display = 'none';
      updateTaskbar();
    });

    const btnMinimize = win.querySelector('.win-btn-minimize');
    btnMinimize?.addEventListener('click', (e) => {
      e.stopPropagation();
      win.classList.add('hidden');
      win.style.display = 'none';
      updateTaskbar();
    });

    const btnMaximize = win.querySelector('.win-btn-maximize');
    btnMaximize?.addEventListener('click', () => {
      if (win.dataset.maximized === 'true') {
        win.style.width = win.dataset.prevWidth || '580px';
        win.style.height = win.dataset.prevHeight || 'auto';
        win.style.top = win.dataset.prevTop || '40px';
        win.style.left = win.dataset.prevLeft || '80px';
        win.dataset.maximized = 'false';
      } else {
        win.dataset.prevWidth = win.style.width || `${win.offsetWidth}px`;
        win.dataset.prevHeight = win.style.height || `${win.offsetHeight}px`;
        win.dataset.prevTop = `${win.offsetTop}px`;
        win.dataset.prevLeft = `${win.offsetLeft}px`;
        win.style.width = '100vw';
        win.style.height = 'calc(100vh - 30px)';
        win.style.top = '0px';
        win.style.left = '0px';
        win.dataset.maximized = 'true';
      }
    });
  });

  // 6. Desktop Icons Opening Windows
  const desktopIcons = document.querySelectorAll('.xp-desktop-icon');
  desktopIcons.forEach((icon) => {
    icon.addEventListener('click', () => {
      const targetId = icon.getAttribute('data-open');
      if (targetId) {
        const targetWin = document.getElementById(targetId);
        if (targetWin) {
          targetWin.classList.remove('hidden');
          targetWin.style.display = 'flex';
          bringToFront(targetWin);
          updateTaskbar();
        }
      }
    });
  });

  // 7. Case Study Explorer -> Open in Internet Explorer 6 Window!
  const projectRows = document.querySelectorAll('.xp-project-row');
  const ieReader = document.getElementById('win-ie-reader');
  const ieAddressBar = document.getElementById('ie-address-bar');
  const ieTitlebar = document.getElementById('ie-titlebar-text');

  projectRows.forEach((row) => {
    row.addEventListener('click', () => {
      const projectId = row.getAttribute('data-project-id');
      if (!projectId || !ieReader) return;

      document.querySelectorAll('.ie-case-study-article').forEach(art => art.classList.add('hidden'));
      const targetArt = document.getElementById(`ie-article-${projectId}`);
      if (targetArt) {
        targetArt.classList.remove('hidden');
      }

      if (ieAddressBar) {
        ieAddressBar.innerText = `http://internal.damri.co.id/specs/${projectId}.html`;
      }
      if (ieTitlebar) {
        const title = row.querySelector('span')?.textContent || 'Case Study';
        ieTitlebar.innerText = `Microsoft Internet Explorer - ${title}`;
      }

      ieReader.classList.remove('hidden');
      ieReader.style.display = 'flex';
      bringToFront(ieReader);
      updateTaskbar();
    });
  });

  // 8. Strict Taskbar Sync: ONLY OPEN WINDOWS ARE DISPLAYED!
  function updateTaskbar() {
    const taskbarContainer = document.getElementById('xp-taskbar-items');
    if (!taskbarContainer) return;
    taskbarContainer.innerHTML = '';

    windows.forEach((win) => {
      const isVisible = win.style.display === 'flex' || (!win.classList.contains('hidden') && win.style.display !== 'none');
      if (!isVisible) return; // Only show currently open windows!

      const title = win.querySelector('.xp-titlebar span')?.textContent || 'Window';

      const btn = document.createElement('button');
      btn.className = 'h-6 px-2.5 rounded text-[11px] font-bold flex items-center gap-1.5 cursor-pointer max-w-[150px] truncate shadow-inner bg-[#1b3f94] text-white border border-[#0d2358]';
      btn.innerText = title.split(' - ')[0];

      btn.addEventListener('click', () => {
        if (win.style.display === 'none' || win.classList.contains('hidden')) {
          win.classList.remove('hidden');
          win.style.display = 'flex';
          bringToFront(win);
        } else {
          win.classList.add('hidden');
          win.style.display = 'none';
        }
        updateTaskbar();
      });

      taskbarContainer.appendChild(btn);
    });
  }

  // 9. Windows Media Player Logic (Classic Image 3 Style)
  const wmpPlayBtn = document.getElementById('wmp-play-toggle');
  const wmpStopBtn = document.getElementById('wmp-stop-btn');
  const wmpPlayIcon = document.getElementById('wmp-play-icon');
  const wmpPauseIcon = document.getElementById('wmp-pause-icon');
  const wmpProgressBar = document.getElementById('wmp-progress-bar');
  const wmpTimeDisplay = document.getElementById('wmp-time-display');
  const wmpStatusText = document.getElementById('wmp-status-text');
  const wmpStatusDot = document.getElementById('wmp-status-dot');
  let isPlaying = false;
  let wmpAudio: HTMLAudioElement | null = null;
  let wmpInterval: any = null;

  wmpPlayBtn?.addEventListener('click', () => {
    if (!isPlaying) {
      isPlaying = true;
      wmpPlayIcon?.classList.add('hidden');
      wmpPauseIcon?.classList.remove('hidden');
      if (wmpStatusText) wmpStatusText.innerText = '► Playing';
      if (wmpStatusDot) wmpStatusDot.className = 'w-2 h-2 rounded-xs bg-emerald-400 animate-pulse';

      if (!wmpAudio) {
        const assetBase = document.getElementById('xp-desktop-container')?.dataset.baseUrl || '';
        wmpAudio = new Audio(`${assetBase}/sounds/xp-startup.wav`);
        wmpAudio.addEventListener('ended', () => {
          stopWmp();
        });
      }
      wmpAudio.play().catch(e => console.warn(e));

      wmpInterval = setInterval(() => {
        if (wmpAudio && wmpAudio.duration) {
          const pct = (wmpAudio.currentTime / wmpAudio.duration) * 100;
          if (wmpProgressBar) wmpProgressBar.style.width = `${pct}%`;
          if (wmpTimeDisplay) {
            const cur = Math.floor(wmpAudio.currentTime);
            const dur = Math.floor(wmpAudio.duration);
            wmpTimeDisplay.innerText = `0:0${cur} / 0:0${dur}`;
          }
        }
      }, 100);
    } else {
      stopWmp();
    }
  });

  function stopWmp() {
    isPlaying = false;
    wmpPlayIcon?.classList.remove('hidden');
    wmpPauseIcon?.classList.add('hidden');
    if (wmpStatusText) wmpStatusText.innerText = '■ Stopped';
    if (wmpStatusDot) wmpStatusDot.className = 'w-2 h-2 rounded-xs bg-lime-400';
    if (wmpAudio) {
      wmpAudio.pause();
      wmpAudio.currentTime = 0;
    }
    if (wmpProgressBar) wmpProgressBar.style.width = '0%';
    if (wmpTimeDisplay) wmpTimeDisplay.innerText = '0:00 / 0:04';
    clearInterval(wmpInterval);
  }

  wmpStopBtn?.addEventListener('click', stopWmp);

  // 10. Rover the Search Dog Companion Logic
  const roverInput = document.getElementById('rover-search-input') as HTMLInputElement;
  const roverBtn = document.getElementById('rover-search-btn');
  const roverSpeech = document.getElementById('rover-speech');
  const roverResults = document.getElementById('rover-results-list');

  function runRoverSearch() {
    const q = roverInput?.value.trim().toLowerCase();
    if (!roverResults) return;

    if (!q) {
      if (roverSpeech) roverSpeech.innerText = 'Tulis kata kunci pencarian, saya akan mencarikannya untukmu!';
      return;
    }

    if (roverSpeech) {
      roverSpeech.innerText = `Woof! Menemukan dokumen & proyek terkait "${q}"!`;
    }

    const items = roverResults.querySelectorAll('div.p-2\\.5');
    items.forEach(item => {
      const text = (item as HTMLElement).innerText.toLowerCase();
      if (text.includes(q)) {
        (item as HTMLElement).style.display = 'block';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  }

  roverBtn?.addEventListener('click', runRoverSearch);
  roverInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') runRoverSearch();
  });

  // 11. SDLC Lens Switcher & Feature Selector Logic
  const sdlcSelect = document.getElementById('sdlc-feature-select') as HTMLSelectElement;
  const sdlcTabs = document.querySelectorAll('.xp-lens-tab');

  sdlcSelect?.addEventListener('change', () => {
    const val = sdlcSelect.value;
    if (val === 'pumk') {
      document.getElementById('sdlc-content-pumk')?.classList.remove('hidden');
      document.getElementById('sdlc-content-push')?.classList.add('hidden');
    } else {
      document.getElementById('sdlc-content-pumk')?.classList.add('hidden');
      document.getElementById('sdlc-content-push')?.classList.remove('hidden');
    }
  });

  sdlcTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const view = tab.getAttribute('data-view');
      sdlcTabs.forEach((t) => {
        t.classList.remove('active', 'bg-white', 'border-t-2', 'border-l-2', 'border-r-2', 'text-blue-900');
        t.classList.add('bg-[#ece9d8]', 'text-slate-700');
      });
      tab.classList.add('active', 'bg-white', 'border-t-2', 'border-l-2', 'border-r-2', 'text-blue-900');
      tab.classList.remove('bg-[#ece9d8]', 'text-slate-700');

      document.getElementById('xp-view-analyst')?.classList.add('hidden');
      document.getElementById('xp-view-dev')?.classList.add('hidden');
      document.getElementById('xp-view-qa')?.classList.add('hidden');

      if (view === 'analyst') document.getElementById('xp-view-analyst')?.classList.remove('hidden');
      if (view === 'dev') document.getElementById('xp-view-dev')?.classList.remove('hidden');
      if (view === 'qa') document.getElementById('xp-view-qa')?.classList.remove('hidden');
    });
  });

  // 12. Authentic Windows XP Shutdown Dialog
  const openShutdownBtn = document.getElementById('xp-open-shutdown-btn');
  const shutdownModal = document.getElementById('xp-shutdown-modal');
  const modalTurnOff = document.getElementById('modal-btn-turn-off');
  const shutdownScreen = document.getElementById('xp-shutdown-screen');

  openShutdownBtn?.addEventListener('click', () => {
    startMenu?.classList.add('hidden');
    if (shutdownModal) {
      shutdownModal.classList.remove('hidden');
      shutdownModal.classList.add('flex');
    }
  });

  modalTurnOff?.addEventListener('click', () => {
    shutdownModal?.classList.add('hidden');
    shutdownModal?.classList.remove('flex');

    if (shutdownScreen) {
      shutdownScreen.classList.remove('hidden');
      shutdownScreen.classList.add('flex');
    }

    try {
      const assetBase = document.getElementById('xp-desktop-container')?.dataset.baseUrl || '';
      const audio = new Audio(`${assetBase}/sounds/xp-shutdown.wav`);
      audio.play().catch(e => console.warn(e));
    } catch (e) {
      console.error(e);
    }

    setTimeout(() => {
      if (shutdownScreen) {
        shutdownScreen.classList.add('hidden');
        shutdownScreen.classList.remove('flex');
      }
      const desktop = document.getElementById('xp-desktop-container');
      if (desktop) {
        desktop.classList.add('hidden');
        desktop.classList.remove('flex');
      }
      window.dispatchEvent(new CustomEvent('xp:shutdown-to-3d'));
    }, 2500);
  });

  // 13. Command Prompt
  const cmdInput = document.getElementById('cmd-input') as HTMLInputElement;
  const cmdOutput = document.getElementById('cmd-output');
  const cmdScreen = document.getElementById('cmd-screen');

  cmdInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const val = cmdInput.value.trim().toLowerCase();
      if (!val) return;

      const line = document.createElement('div');
      line.innerHTML = `<span class="text-slate-400">C:\\Users\\Andhika&gt;</span> <span class="text-white">${cmdInput.value}</span>`;
      cmdOutput?.appendChild(line);

      const resp = document.createElement('div');
      resp.className = 'text-emerald-300 pl-2';

      if (val === 'help') {
        resp.innerHTML = `
          Perintah yang tersedia:<br/>
          &bull; <span class="text-yellow-300">andhika</span>  - Profil Andhika Putra Pratama<br/>
          &bull; <span class="text-yellow-300">pumk</span>     - Detail arsitektur aplikasi PUMK<br/>
          &bull; <span class="text-yellow-300">push</span>     - Detail aplikasi Push Request Tracker<br/>
          &bull; <span class="text-yellow-300">skills</span>   - Matriks keahlian SA, Dev &amp; QA<br/>
          &bull; <span class="text-yellow-300">contact</span>  - Email &amp; saluran komunikasi<br/>
          &bull; <span class="text-yellow-300">clear</span>    - Bersihkan layar terminal
        `;
      } else if (val === 'andhika') {
        resp.innerHTML = `
          Andhika Putra Pratama (Dipa) - System Analyst &amp; Technical Architect<br/>
          Email: andhikapp28@gmail.com | GitHub: github.com/andhikapp28
        `;
      } else if (val === 'pumk') {
        resp.innerHTML = `
          [PUMK DAMRI]: Sistem Pembinaan &amp; Pembiayaan UMKM BUMN.<br/>
          - Validasi NIK 16 digit &amp; penomoran unik via lockForUpdate<br/>
          - Integrasi Shadow User ke database SSO DAMRI<br/>
          - Kamus data teknis 32KB
        `;
      } else if (val === 'push') {
        resp.innerHTML = `
          [PUSH REQUEST DAMRI]: Sistem Audit Commit &amp; Manajemen Proyek IT.<br/>
          - Webhook GitHub API &amp; diff audit status pull ke production<br/>
          - Kanban board task &amp; milestone checklist
        `;
      } else if (val === 'skills') {
        resp.innerHTML = `
          [SA]: BRD/SRS, BPMN 2.0, Kamus Data, Skema Relasional ERD 3NF, SSO Auth<br/>
          [DEV]: Laravel 12, PostgreSQL, Concurrency Locks, GitHub API, REST<br/>
          [QA]: Boundary Testing, Test Cases Matrix, Postman API Testing
        `;
      } else if (val === 'contact') {
        resp.innerHTML = `Email: andhikapp28@gmail.com | GitHub: andhikapp28`;
      } else if (val === 'clear') {
        if (cmdOutput) cmdOutput.innerHTML = '';
        cmdInput.value = '';
        return;
      } else {
        resp.innerHTML = `'${val}' tidak dikenali. Ketik 'help' untuk panduan.`;
      }

      cmdOutput?.appendChild(resp);
      cmdInput.value = '';
      if (cmdScreen) cmdScreen.scrollTop = cmdScreen.scrollHeight;
    }
  });

  // 14. Copy Email
  const copyBtn = document.getElementById('xp-copy-email-btn');
  const copyIcon = document.getElementById('xp-copy-icon');
  const copiedIcon = document.getElementById('xp-copied-icon');
  const copyText = document.getElementById('xp-copy-text');

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText('andhikapp28@gmail.com').then(() => {
      copyIcon?.classList.add('hidden');
      copiedIcon?.classList.remove('hidden');
      if (copyText) copyText.innerText = 'Tersalin!';
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        copiedIcon?.classList.add('hidden');
        if (copyText) copyText.innerText = 'Salin Email';
      }, 2000);
    });
  });
</script>
