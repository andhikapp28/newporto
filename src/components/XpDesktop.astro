<script>
  // 1. Window Management & Taskbar Sync
  let highestZIndex = 30;

  function bringToFront(win: HTMLElement) {
    highestZIndex += 1;
    win.style.zIndex = highestZIndex.toString();
  }

  // Expose openWindow to window so inline onclick handlers work without fail
  (window as any).openWindow = function(winId: string) {
    const win = document.getElementById(winId);
    if (!win) return;
    win.classList.remove('hidden');
    win.style.display = 'flex';
    bringToFront(win);
    updateTaskbar();

    // If opening cmd, focus the input
    if (winId === 'win-cmd') {
      setTimeout(() => {
        document.getElementById('cmd-input')?.focus();
      }, 100);
    }
  };

  const windows = document.querySelectorAll<HTMLElement>('.xp-window');
  windows.forEach((win) => {
    win.addEventListener('mousedown', () => bringToFront(win));

    // Titlebar drag
    const titlebar = win.querySelector<HTMLElement>('.xp-titlebar');
    if (titlebar) {
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let initialLeft = 0;
      let initialTop = 0;

      titlebar.addEventListener('mousedown', (e) => {
        isDragging = true;
        bringToFront(win);
        startX = e.clientX;
        startY = e.clientY;
        initialLeft = win.offsetLeft;
        initialTop = win.offsetTop;

        function onMouseMove(moveEvent: MouseEvent) {
          if (!isDragging) return;
          const dx = moveEvent.clientX - startX;
          const dy = moveEvent.clientY - startY;
          win.style.left = `${Math.max(0, initialLeft + dx)}px`;
          win.style.top = `${Math.max(0, initialTop + dy)}px`;
        }

        function onMouseUp() {
          isDragging = false;
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
        }

        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      });
    }

    // Window Resizing via bottom-right grip handle
    const resizeHandle = win.querySelector<HTMLElement>('.win-resize-handle');
    if (resizeHandle) {
      let isResizing = false;
      let startW = 0;
      let startH = 0;
      let startX = 0;
      let startY = 0;

      resizeHandle.addEventListener('mousedown', (e) => {
        e.stopPropagation();
        isResizing = true;
        bringToFront(win);
        startX = e.clientX;
        startY = e.clientY;
        startW = win.offsetWidth;
        startH = win.offsetHeight;

        function onResizeMove(moveEvent: MouseEvent) {
          if (!isResizing) return;
          const dw = moveEvent.clientX - startX;
          const dh = moveEvent.clientY - startY;
          win.style.width = `${Math.max(300, startW + dw)}px`;
          win.style.height = `${Math.max(200, startH + dh)}px`;
        }

        function onResizeUp() {
          isResizing = false;
          window.removeEventListener('mousemove', onResizeMove);
          window.removeEventListener('mouseup', onResizeUp);
        }

        window.addEventListener('mousemove', onResizeMove);
        window.addEventListener('mouseup', onResizeUp);
      });
    }

    // Window controls
    const btnClose = win.querySelector('.win-btn-close');
    btnClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      win.classList.add('hidden');
      win.style.display = 'none';
      updateTaskbar();
    });

    const btnMinimize = win.querySelector('.win-btn-minimize');
    btnMinimize?.addEventListener('click', (e) => {
      e.stopPropagation();
      win.classList.add('hidden');
      win.style.display = 'none';
      updateTaskbar();
    });

    const btnMaximize = win.querySelector('.win-btn-maximize');
    btnMaximize?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (win.dataset.maximized === 'true') {
        win.style.width = win.dataset.prevWidth || '580px';
        win.style.height = win.dataset.prevHeight || 'auto';
        win.style.top = win.dataset.prevTop || '40px';
        win.style.left = win.dataset.prevLeft || '80px';
        win.dataset.maximized = 'false';
      } else {
        win.dataset.prevWidth = win.style.width || `${win.offsetWidth}px`;
        win.dataset.prevHeight = win.style.height || `${win.offsetHeight}px`;
        win.dataset.prevTop = `${win.offsetTop}px`;
        win.dataset.prevLeft = `${win.offsetLeft}px`;
        win.style.width = '100vw';
        win.style.height = 'calc(100vh - 30px)';
        win.style.top = '0px';
        win.style.left = '0px';
        win.dataset.maximized = 'true';
      }
    });
  });

  // Desktop Icons Opening Windows
  const desktopIcons = document.querySelectorAll('.xp-desktop-icon');
  desktopIcons.forEach((icon) => {
    icon.addEventListener('click', () => {
      const targetId = icon.getAttribute('data-open');
      if (targetId) {
        (window as any).openWindow(targetId);
      }
    });
  });

  // Strict Taskbar Sync: ONLY OPEN WINDOWS APPEAR!
  function updateTaskbar() {
    const taskbarContainer = document.getElementById('xp-taskbar-items');
    if (!taskbarContainer) return;
    taskbarContainer.innerHTML = '';

    windows.forEach((win) => {
      const isVisible = win.style.display === 'flex' || (!win.classList.contains('hidden') && win.style.display !== 'none');
      if (!isVisible) return;

      const title = win.querySelector('.xp-titlebar span')?.textContent || 'Window';

      const btn = document.createElement('button');
      btn.className = 'h-6 px-2.5 rounded text-[11px] font-bold flex items-center gap-1.5 cursor-pointer max-w-[140px] truncate shadow-inner bg-[#1b3f94] text-white border border-[#0d2358]';
      btn.innerText = title.split(' - ')[0];

      btn.addEventListener('click', () => {
        if (win.style.display === 'none' || win.classList.contains('hidden')) {
          win.classList.remove('hidden');
          win.style.display = 'flex';
          bringToFront(win);
        } else {
          win.classList.add('hidden');
          win.style.display = 'none';
        }
        updateTaskbar();
      });

      taskbarContainer.appendChild(btn);
    });
  }

  // Boot event listener from 3D stage
  window.addEventListener('xp:boot-desktop', () => {
    const desktop = document.getElementById('xp-desktop-container');
    if (desktop) {
      desktop.classList.remove('hidden');
      desktop.classList.add('flex');
    }
    const welcome = document.getElementById('win-welcome');
    if (welcome) {
      welcome.classList.remove('hidden');
      welcome.style.display = 'flex';
      bringToFront(welcome);
    }
    updateTaskbar();
  });

  // 2. Language Switcher (ID <-> EN)
  let currentLang = 'id';
  const langBtn = document.getElementById('lang-toggle-btn');

  function applyLanguage(lang: string) {
    currentLang = lang;
    const elements = document.querySelectorAll<HTMLElement>('.i18n');
    elements.forEach(el => {
      const text = el.getAttribute(`data-${lang}`);
      if (text) el.innerHTML = text;
    });
    if (langBtn) {
      langBtn.innerText = lang.toUpperCase();
    }
  }

  langBtn?.addEventListener('click', () => {
    const nextLang = currentLang === 'id' ? 'en' : 'id';
    applyLanguage(nextLang);
  });
  applyLanguage('id');

  // 3. Start Menu Toggle
  const startBtn = document.getElementById('xp-start-btn');
  const startMenu = document.getElementById('xp-start-menu');

  startBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    startMenu?.classList.toggle('hidden');
    startMenu?.classList.toggle('flex');
  });

  document.addEventListener('click', (e) => {
    if (startMenu && !startMenu.contains(e.target as Node) && e.target !== startBtn) {
      startMenu.classList.add('hidden');
      startMenu.classList.remove('flex');
    }
  });

  // 4. System Tray Clock
  function updateClock() {
    const clockEl = document.getElementById('xp-clock');
    if (!clockEl) return;
    const now = new Date();
    let hours = now.getHours();
    const minutes = now.getMinutes().toString().padStart(2, '0');
    const ampm = hours >= 12 ? 'PM' : 'AM';
    hours = hours % 12 || 12;
    clockEl.innerText = `${hours}:${minutes} ${ampm}`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // 5. Case Study Explorer -> Open in Internet Explorer 6 Window
  const projectRows = document.querySelectorAll('.xp-project-row');
  const ieAddressBar = document.getElementById('ie-address-bar');
  const ieTitlebar = document.getElementById('ie-titlebar-text');

  projectRows.forEach((row) => {
    row.addEventListener('click', () => {
      const projectId = row.getAttribute('data-project-id');
      if (!projectId) return;

      document.querySelectorAll('.ie-case-study-article').forEach(art => art.classList.add('hidden'));
      const targetArt = document.getElementById(`ie-article-${projectId}`);
      if (targetArt) {
        targetArt.classList.remove('hidden');
      }

      if (ieAddressBar) {
        ieAddressBar.innerText = `http://internal.damri.co.id/specs/${projectId}.html`;
      }
      if (ieTitlebar) {
        const title = row.querySelector('span')?.textContent || 'Case Study';
        ieTitlebar.innerText = `Microsoft Internet Explorer - ${title}`;
      }

      (window as any).openWindow('win-ie-reader');
    });
  });

  // 6. Sample Work Documents Viewer
  const sampleDocsData: Record<string, { title: string; snippet: string }> = {
    "srs-pumk": {
      title: "SRS_PUMK_Spesifikasi_Kebutuhan.doc",
      snippet: `DOKUMEN SOFTWARE REQUIREMENTS SPECIFICATION (SRS)\nPROYEK: APLIKASI PUMK - PERUM DAMRI\nNOMOR DOKUMEN: SRS-PUMK-2024-V1.2\n\n1. PENDAHULUAN\nSistem PUMK (Program Usaha Mikro Kecil) dirancang untuk mengelola tata kelola pembiayaan kemitraan BUMN di lingkungan Perum DAMRI.\n\n2. KEBUTUHAN FUNGSIONAL UTAMA\n- FR-01: Verifikasi NIK Pemilik Usaha 16 Digit numerik valid.\n- FR-02: Auto-Generate Kode Mitra format PUMK-{tahun}-{urutan 3 digit} dengan Pessimistic Concurrency Lock (lockForUpdate).\n- FR-03: Otentikasi Shadow User terintegrasi SSO DAMRI tanpa penyimpanan plaintext password.\n- FR-04: Modul monitoring cicilan dan restrukturisasi pinjaman TJSL triwulanan (TW1 - TW4).`
    },
    "kamus-data": {
      title: "Kamus_Data_Teknis_Aplikasi_PUMK.doc",
      snippet: `KAMUS DATA TEKNIS — SISTEM PUMK DAMRI (32 KB)\nVERSI: 1.0\n\n[TABEL: ref_mitra]\n- id (bigserial, PK)\n- kode_mitra (varchar 20, UNIQUE, Format PUMK-YYYY-XXX)\n- nama_usaha (varchar 150)\n- nama_pemilik (varchar 100)\n- nik_pemilik (char 16, Validasi Dukcapil)\n- id_bu (int, Foreign Key unit bisnis SSO)\n\n[TABEL: tr_tjsl_pembayaran]\n- id (bigserial, PK)\n- id_mitra (bigint, FK ref_mitra.id)\n- nominal_angsuran (decimal 15,2)\n- tanggal_bayar (date)\n- status_verifikasi (enum: DRAFT, APPROVED, REJECTED)`
    },
    "audit-push": {
      title: "SOP_Audit_Deployment_PushRequest.doc",
      snippet: `STANDAR OPERASIONAL PROSEDUR (SOP) AUDIT DEPLOYMENT\nSISTEM INFORMASI IT — PERUM DAMRI\n\n1. TUJUAN\nMenjamin seluruh baris kode yang dirilis ke server production telah melalui tahapan review System Analyst dan Tech Lead.\n\n2. ALUR AUDIT GITHUB PUSH\n- Webhook GitHub mengirimkan payload event push ke endpoint /api/webhook/github-push.\n- Sistem memvalidasi X-Hub-Signature-256 menggunakan secret key rahasia.\n- Commit hash, author, dan diff file tercatat otomatis ke tabel audit_pushes.\n- Go-Live Checklist ditandatangani digital sebelum proses 'git pull' dieksekusi di server live.`
    },
    "qa-matrix": {
      title: "Matriks_Skenario_Uji_QA_Boundary.doc",
      snippet: `MATRIKS SKENARIO PENGUJIAN QUALITY ASSURANCE (QA)\n\nTC-01: Concurrency Race Condition Registrasi Mitra\n- Given: 20 request POST registrasi mitra binaan dikirim simultan pada milidetik yang sama.\n- Expected: Seluruh 20 mitra mendapatkan nomor urut berurutan tanpa satu pun duplikasi nomor PUMK-2026-XXX.\n- Result: PASS (PostgreSQL lockForUpdate berhasil mengantrikan transaksi).\n\nTC-02: Boundary NIK Invalid (15 dan 17 digit)\n- Input: NIK string '157107280200006' (15 digit) atau '15710728020000611' (17 digit).\n- Expected: HTTP 422 Unprocessable Entity dengan error message presisi.\n- Result: PASS.`
    }
  };

  (window as any).openSampleDoc = function(docKey: string) {
    const data = sampleDocsData[docKey];
    if (!data) return;
    const titleEl = document.getElementById('doc-viewer-title');
    const contentEl = document.getElementById('doc-viewer-content');
    if (titleEl) titleEl.innerText = data.title;
    if (contentEl) contentEl.innerText = data.snippet;
    (window as any).openWindow('win-doc-viewer');
  };

  // 7. Galeri Sertifikat (Windows Picture and Fax Viewer)
  const certsList = [
    {
      title: "Ijazah Sarjana Komputer (S.Kom.)",
