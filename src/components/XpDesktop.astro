           title="Certificates"
           data-tooltip-title="Certificates / Sertifikat"
           data-tooltip-desc="Lihat dan unduh sertifikat akademik (ITERA S.Kom), TOEFL 640 & kompetensi internasional. | View and download academic & competency certificates.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-gradient-to-br from-emerald-100 to-teal-200 border border-teal-400 shadow-md group-hover:scale-105 transition-transform">
          <Award class="w-6 h-6 text-teal-700" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Certificates" data-id="Sertifikat">Certificates</span>
      </div>

      <!-- Icon 5: Games (Folder containing Minesweeper) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-games-folder"
           title="Games"
           data-tooltip-title="Games (Folder)"
           data-tooltip-desc="Folder game klasik Windows XP: Minesweeper (winmine.exe), 3D Pinball, dan Solitaire. | Classic Windows XP games: Minesweeper (winmine.exe), 3D Pinball, and Solitaire.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-gradient-to-br from-amber-100 to-yellow-200 border border-amber-400 shadow-md group-hover:scale-105 transition-transform relative">
          <Folder class="w-6 h-6 text-amber-500 fill-amber-400" />
          <Bomb class="w-3.5 h-3.5 text-red-600 absolute bottom-1 right-1 drop-shadow" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Games" data-id="Games">Games</span>
      </div>

      <!-- Icon 6: Welcome.doc (Panduan & Profil) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-welcome"
