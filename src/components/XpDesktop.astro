    azul: `${assetBase}/wallpapers/azul.svg`,
    redmoon: `${assetBase}/wallpapers/redmoon.svg`,
    classic: `${assetBase}/wallpapers/classic.svg`
  };

  function updateThemePreview(theme: string) {
    if (!dispPreviewTitlebar || !dispPreviewTaskbar || !dispPreviewText) return;
    if (theme === 'olive') {
      dispPreviewTitlebar.style.background = 'linear-gradient(180deg, #9db476 0%, #5d723d 100%)';
      dispPreviewTaskbar.style.background = '#6c824c';
      dispPreviewText.innerText = 'Windows XP Olive Green';
    } else if (theme === 'silver') {
      dispPreviewTitlebar.style.background = 'linear-gradient(180deg, #d3d8e5 0%, #7c8292 100%)';
      dispPreviewTaskbar.style.background = '#b8bdcd';
      dispPreviewText.innerText = 'Windows XP Metallic Silver';
    } else {
      dispPreviewTitlebar.style.background = 'linear-gradient(180deg, #0a66f0 0%, #004ddb 100%)';
      dispPreviewTaskbar.style.background = '#245edb';
      dispPreviewText.innerText = 'Windows XP Luna Blue';
    }
  }

  function applyTheme(theme: string) {
    if (!desktopContainer) return;
    desktopContainer.setAttribute('data-xp-theme', theme);
    localStorage.setItem('xp_porto_theme', theme);
  }

  function applyWallpaper(wpKey: string) {
    if (!desktopContainer) return;
    const url = wallpaperUrls[wpKey] || wallpaperUrls.bliss;
    desktopContainer.style.backgroundImage = `url('${url}')`;
    if (dispWallpaperPreview) {
      dispWallpaperPreview.style.backgroundImage = `url('${url}')`;
    }
    localStorage.setItem('xp_porto_wallpaper', wpKey);
  }

  // Load saved theme & wallpaper
  const savedTheme = localStorage.getItem('xp_porto_theme') || 'blue';
  if (savedTheme !== 'blue') {
    applyTheme(savedTheme);
    if (dispThemeSelect) dispThemeSelect.value = savedTheme;
    updateThemePreview(savedTheme);
  }

  const savedWp = localStorage.getItem('xp_porto_wallpaper') || 'bliss';
  if (savedWp !== 'bliss' && wallpaperUrls[savedWp]) {
    applyWallpaper(savedWp);
    if (dispWallpaperSelect) dispWallpaperSelect.value = savedWp;
  }

  dispTabTheme?.addEventListener('click', () => {
    dispTabTheme.classList.add('active');
    dispTabDesktop?.classList.remove('active');
    dispContentTheme?.classList.remove('hidden');
    dispContentDesktop?.classList.add('hidden');
  });

  dispTabDesktop?.addEventListener('click', () => {
    dispTabDesktop.classList.add('active');
    dispTabTheme?.classList.remove('active');
    dispContentDesktop?.classList.remove('hidden');
    dispContentTheme?.classList.add('hidden');
  });

  dispThemeSelect?.addEventListener('change', () => {
    updateThemePreview(dispThemeSelect.value);
  });

  dispWallpaperSelect?.addEventListener('change', () => {
    const url = wallpaperUrls[dispWallpaperSelect.value] || wallpaperUrls.bliss;
    if (dispWallpaperPreview) dispWallpaperPreview.style.backgroundImage = `url('${url}')`;
  });

  dispBtnApply?.addEventListener('click', () => {
    if (dispThemeSelect) applyTheme(dispThemeSelect.value);
    if (dispWallpaperSelect) applyWallpaper(dispWallpaperSelect.value);
    playXpSound('click');
  });

  dispBtnOk?.addEventListener('click', () => {
    if (dispThemeSelect) applyTheme(dispThemeSelect.value);
    if (dispWallpaperSelect) applyWallpaper(dispWallpaperSelect.value);
    playXpSound('click');
    const win = document.getElementById('win-display-props');
    if (win) closeWindow(win);
