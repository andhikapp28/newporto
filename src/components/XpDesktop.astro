  // ==========================================================================
  // 16. WINDOWS TASK MANAGER (taskmgr.exe)
  // ==========================================================================
  const tabTaskmgrApps = document.getElementById('tab-taskmgr-apps');
  const tabTaskmgrPerf = document.getElementById('tab-taskmgr-perf');
  const taskmgrContentApps = document.getElementById('taskmgr-content-apps');
  const taskmgrContentPerf = document.getElementById('taskmgr-content-perf');
  const taskmgrAppRows = document.getElementById('taskmgr-app-rows');
  const taskmgrBtnEnd = document.getElementById('taskmgr-btn-endtask');
  const taskmgrBtnSwitch = document.getElementById('taskmgr-btn-switch');
  const taskmgrBtnNew = document.getElementById('taskmgr-btn-newtask');
  let selectedTaskmgrWinId = '';

  tabTaskmgrApps?.addEventListener('click', () => {
    tabTaskmgrApps.classList.add('active');
    tabTaskmgrPerf?.classList.remove('active');
    taskmgrContentApps?.classList.remove('hidden');
    taskmgrContentPerf?.classList.add('hidden');
