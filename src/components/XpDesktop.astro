  function renderRoverResults(results: typeof roverIndex) {
    if (!roverResults) return;
    roverResults.innerHTML = '';
    if (results.length === 0) {
      roverResults.innerHTML = `<div class="text-[11px] text-slate-500 italic i18n" data-en="No results found." data-id="Tidak ditemukan hasil.">No results found.</div>`;
      return;
    }
    results.forEach((item) => {
      const div = document.createElement('div');
      div.className = 'p-2.5 rounded border border-slate-200 hover:bg-blue-50 hover:border-blue-300 cursor-pointer group transition-all';
      const title = currentLang === 'id' && item.titleId ? item.titleId : item.title;
      const desc = currentLang === 'id' && item.descId ? item.descId : item.desc;
      div.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="px-1.5 py-0.5 rounded bg-slate-200 text-[9px] font-bold uppercase text-slate-700">${item.type}</span>
          <span class="font-bold text-blue-900 text-xs group-hover:underline">${title}</span>
        </div>
        <div class="text-[10px] text-slate-600 mt-0.5">${desc}</div>
      `;
      div.addEventListener('click', () => {
        item.action();
        const searchWin = document.getElementById('win-search');
        if (searchWin) closeWindow(searchWin);
      });
      roverResults.appendChild(div);
    });
  }

  function runRoverSearch() {
    const q = roverInput?.value.trim().toLowerCase();
    if (!roverResults) return;

    if (!q) {
      const promptText = currentLang === 'id'
        ? 'Tulis kata kunci pencarian, saya akan mencarikannya untukmu!'
        : 'Type a keyword and I will search for you!';
      if (roverSpeech) roverSpeech.innerText = promptText;
      renderRoverResults([]);
      return;
    }

    const speechText = currentLang === 'id'
      ? `Woof! Menemukan dokumen & proyek terkait "${roverInput.value}"!`
      : `Woof! Found documents & projects related to "${roverInput.value}"!`;
    if (roverSpeech) roverSpeech.innerText = speechText;

    const results = roverIndex.filter(item => {
      const hay = `${item.title} ${item.titleId || ''} ${item.desc} ${item.descId || ''} ${item.keywords}`.toLowerCase();
      return hay.includes(q);
    });
    renderRoverResults(results);
  }

  roverBtn?.addEventListener('click', runRoverSearch);
  roverInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') runRoverSearch();
