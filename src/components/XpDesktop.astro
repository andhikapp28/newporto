---

<div 
  id="xp-desktop-container" 
  class="fixed inset-0 z-30 w-screen h-screen hidden flex-col select-none overflow-hidden font-sans"
  style={`background-image: url('${blissImg}'); background-size: cover; background-position: center; background-repeat: no-repeat;`}
  data-base-url={base}
>
  <!-- Desktop Workspace Area -->
  <div id="xp-desktop-space" class="relative flex-1 w-full h-[calc(100vh-30px)] overflow-hidden">

    <!-- Desktop Icons Grid (Left column) -->
    <div id="xp-desktop-icons-grid" class="relative z-10 p-3 grid grid-flow-col grid-rows-8 gap-y-2.5 gap-x-5 w-max pointer-events-auto">
      <!-- Custom desktop icon tooltip -->
      <div id="xp-icon-tooltip" class="fixed z-[10001] hidden pointer-events-none max-w-[220px]">
        <div class="px-2 py-1.5 rounded border border-[#0a246a] bg-[#ffffe1] text-slate-900 shadow-lg text-[11px]">
          <div id="xp-icon-tooltip-title" class="font-bold"></div>
          <div id="xp-icon-tooltip-desc" class="text-slate-700 leading-tight mt-0.5"></div>
        </div>
      </div>

      
      <!-- Icon 1: Welcome.doc -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-welcome"
           title="Welcome.doc"
           data-tooltip-title="Welcome.doc"
           data-tooltip-desc="Buka profil singkat dan tiga pilar keahlian Andhika. | Open a brief profile and the three pillars of Andhika's expertise.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-white/95 border border-slate-300 shadow-md group-hover:scale-105 transition-transform">
          <FileText class="w-6 h-6 text-blue-600" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Welcome.doc" data-id="Welcome.doc">Welcome.doc</span>
      </div>

      <!-- Icon 2: Resume.doc -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-resume"
           title="Resume.doc"
           data-tooltip-title="Resume.doc"
           data-tooltip-desc="Lihat CV lengkap, pendidikan, pengalaman kerja, dan publikasi. | View full CV, education, work experience, and publications.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-white/95 border border-slate-300 shadow-md group-hover:scale-105 transition-transform">
          <Briefcase class="w-6 h-6 text-indigo-600" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Resume.doc" data-id="Resume.doc">Resume.doc</span>
      </div>

      <!-- Icon 2b: CV_ATS.pdf (Adobe Reader in Windows XP) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-pdf-viewer"
           title="CV_ATS.pdf"
           data-tooltip-title="CV_ATS.pdf (Adobe Reader)"
           data-tooltip-desc="Buka CV format PDF standar ATS di dalam Adobe Reader Windows XP. | Open ATS-friendly CV PDF inside Windows XP Adobe Reader.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-white border border-red-300 shadow-md group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 fill-red-600" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9.5 8.5h-1v2h1c.55 0 1-.45 1-1s-.45-1-1-1zm5 0h-1v3h1c.55 0 1-.45 1-1v-1c0-.55-.45-1-1-1zm-6-2.5h-2v7h2c1.1 0 2-.9 2-2v-3c0-1.1-.9-2-2-2zm5 0h-2v7h2c1.1 0 2-.9 2-2v-3c0-1.1-.9-2-2-2zm5.5 0h-3v7h1.5v-2.5h1.5v-1.5h-1.5v-1.5h1.5v-1.5z"/></svg>
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="CV_ATS.pdf" data-id="CV_ATS.pdf">CV_ATS.pdf</span>
      </div>

      <!-- Icon 3: Dokumen Pribadi (Folder Dokumen & Hasil Kerja) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-docs-folder"
           title="Dokumen Kerja"
           data-tooltip-title="Dokumen Kerja / Work Docs"
           data-tooltip-desc="Folder dokumen teknis dan CV ATS. | Folder of technical documents and ATS-friendly CV.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-amber-100 border border-amber-300 shadow-md group-hover:scale-105 transition-transform">
          <Folder class="w-6 h-6 text-amber-500 fill-amber-400" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Work Docs" data-id="Dokumen Kerja">Work Docs</span>
      </div>

      <!-- Icon 4: Galeri Sertifikat (Windows Picture & Fax Viewer) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-gallery"
           title="Certificates"
           data-tooltip-title="Certificates / Sertifikat"
           data-tooltip-desc="Lihat dan unduh sertifikat akademik & kompetensi. | View and download academic & competency certificates.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-gradient-to-br from-emerald-100 to-teal-200 border border-teal-400 shadow-md group-hover:scale-105 transition-transform">
          <Award class="w-6 h-6 text-teal-700" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Certificates" data-id="Sertifikat">Certificates</span>
      </div>

      <!-- Icon 5: My Computer -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-explorer"
           title="My Computer"
           data-tooltip-title="My Computer / Komputer Saya"
           data-tooltip-desc="Akses drive, folder, dan perangkat sistem portofolio. | Access drives, folders, and portfolio system devices.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-slate-100 border border-slate-300 shadow-md group-hover:scale-105 transition-transform">
          <Laptop class="w-6 h-6 text-blue-700" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="My Computer" data-id="Komputer Saya">My Computer</span>
      </div>

      <!-- Icon 6: SDLC_Lens.exe -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-sdlc"
           title="SDLC_Lens.exe"
           data-tooltip-title="SDLC_Lens.exe"
           data-tooltip-desc="Lihat studi kasus PUMK dan Push Request dari sudut Analyst, Dev, dan QA. | View PUMK and Push Request case studies through Analyst, Dev, and QA lenses.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-slate-900 border border-cyan-400 shadow-md group-hover:scale-105 transition-transform">
          <Layers class="w-5 h-5 text-cyan-400" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="SDLC_Lens.exe" data-id="SDLC_Lens.exe">SDLC_Lens.exe</span>
      </div>

      <!-- Icon 7: Windows Media Player -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-media-player"
           title="Media Player"
           data-tooltip-title="Windows Media Player"
           data-tooltip-desc="Dengarkan playlist Lo-Fi Chill Beats. | Listen to the Lo-Fi Chill Beats playlist.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-gradient-to-br from-slate-200 to-slate-400 border border-slate-400 shadow-md group-hover:scale-105 transition-transform">
          <Play class="w-5 h-5 text-blue-800 fill-blue-800 ml-0.5" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Media Player" data-id="Media Player">Media Player</span>
      </div>

      <!-- Icon 8: cmd.exe (Fixed!) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-cmd"
           title="cmd.exe"
           data-tooltip-title="cmd.exe"
           data-tooltip-desc="Jalankan perintah cepat seperti andhika, projects, skills, contact, dan clear. | Run quick commands like andhika, projects, skills, contact, and clear.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-black border border-slate-600 shadow-md group-hover:scale-105 transition-transform">
          <Terminal class="w-5 h-5 text-emerald-400" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="cmd.exe" data-id="cmd.exe">cmd.exe</span>
      </div>
      <!-- Icon 9: Search Companion (Rover) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-search"
           title="Search Companion"
           data-tooltip-title="Search Companion"
           data-tooltip-desc="Cari jendela, keahlian, proyek, sertifikat, atau perintah dengan bantuan Rover. | Search windows, skills, projects, certificates, or commands with Rover.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-blue-50 border border-blue-300 shadow-md group-hover:scale-105 transition-transform">
          <Dog class="w-6 h-6 text-blue-700" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Search" data-id="Pencarian">Search</span>
      </div>

      <!-- Icon 10: Notepad (Sticky Notes) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-notepad"
           title="Notepad"
           data-tooltip-title="Notepad"
           data-tooltip-desc="Catatan bebas yang tersimpan otomatis di peramban. | Freeform notes automatically saved in your browser.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-white border border-slate-300 shadow-md group-hover:scale-105 transition-transform">
          <StickyNote class="w-6 h-6 text-yellow-500" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Notepad" data-id="Catatan">Notepad</span>
      </div>

      <!-- Icon 11: Recycle Bin -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-recycle-bin"
           title="Recycle Bin"
           data-tooltip-title="Recycle Bin"
           data-tooltip-desc="Lihat jendela yang baru saja ditutup dan pulihkan (hiasan). | View recently closed windows and restore them (cosmetic).">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-slate-100 border border-slate-300 shadow-md group-hover:scale-105 transition-transform">
          <Trash2 class="w-6 h-6 text-slate-600" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Recycle Bin" data-id="Tempat Sampah">Recycle Bin</span>
      </div>

      <!-- Icon 12: Task Manager -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-taskmgr"
           title="Task Manager"
           data-tooltip-title="Windows Task Manager"
           data-tooltip-desc="Monitor performa CPU, load System Analyst, dan status aplikasi. | Monitor CPU performance, System Analyst load, and app statuses.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-emerald-950 border border-emerald-500 shadow-md group-hover:scale-105 transition-transform">
          <Activity class="w-6 h-6 text-emerald-400" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Taskmgr.exe" data-id="Taskmgr.exe">Taskmgr.exe</span>
      </div>

      <!-- Icon 13: Paint -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-paint"
           title="Paint"
           data-tooltip-title="Paint"
           data-tooltip-desc="Kanvas coret-coret interaktif untuk HR & pengunjung. | Interactive doodle canvas for HR & visitors.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-white border border-slate-300 shadow-md group-hover:scale-105 transition-transform">
          <Palette class="w-6 h-6 text-amber-500" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Paint.exe" data-id="Paint.exe">Paint.exe</span>
      </div>

      <!-- Icon 14: Minesweeper -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
           data-open="win-minesweeper"
           title="Minesweeper"
           data-tooltip-title="Minesweeper"
           data-tooltip-desc="Game klasik legendaris Windows XP 9x9 kotak. | Legendary classic Windows XP 9x9 grid game.">
        <div class="w-10 h-10 mb-0.5 rounded flex items-center justify-center bg-slate-200 border border-slate-400 shadow-md group-hover:scale-105 transition-transform">
          <Bomb class="w-6 h-6 text-red-600" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1 i18n" data-en="Minesweeper" data-id="Minesweeper">Minesweeper</span>
      </div>
    </div>

    <!-- ==================== DRAGGABLE & RESIZABLE WINDOWS ==================== -->

    <!-- WINDOW 1: Welcome.doc (WordPad) -->
    <div
      id="win-welcome"
      class="xp-window absolute top-6 left-28 w-[92vw] sm:w-[580px] rounded-t-lg shadow-2xl border-[3px] border-[#0055ea] bg-[#ece9d8] text-slate-800 z-20 flex flex-col overflow-hidden"
      style="display: flex;"
    >
      <div class="xp-titlebar h-7 px-2 flex items-center justify-between cursor-move select-none text-white shadow-inner">
        <div class="flex items-center gap-2 font-bold text-xs tracking-wide drop-shadow-[1px_1px_1px_rgba(0,0,0,0.7)] truncate">
          <FileText class="w-3.5 h-3.5 text-blue-200 shrink-0" />
          <span>Welcome.doc - Microsoft WordPad</span>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button class="win-btn-minimize" title="Minimize"><Minus class="w-2.5 h-2.5" /></button>
          <button class="win-btn-maximize" title="Maximize"><Square class="w-2 h-2" /></button>
          <button class="win-btn-close" title="Close"><X class="w-2.5 h-2.5" /></button>
