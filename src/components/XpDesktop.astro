    animation: xpShake 0.3s ease-in-out;
  }

  /* Ensure notepad textarea uses fixed font stack and no chrome */
  #notepad-textarea {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
