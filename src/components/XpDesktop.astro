        </span>
      </div>

      <!-- Icon 8: cmd.exe (Fixed!) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-cmd">
