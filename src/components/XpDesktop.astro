          AP
        </div>
      </div>
      <div class="font-bold text-sm drop-shadow">
        Andhika Putra Pratama
      </div>
    </div>

    <div class="flex bg-[#d3e5fa] text-xs">
      <!-- Left Column -->
      <div class="w-1/2 bg-white p-2 space-y-1 border-r border-[#95bdee]">
        <div class="p-1.5 rounded hover:bg-blue-100 flex items-center gap-2 cursor-pointer" onclick="document.querySelector('[data-open=\'win-welcome\']').click(); document.getElementById('xp-start-menu').classList.add('hidden');">
          <FileText class="w-4 h-4 text-blue-600" />
          <span class="font-bold text-slate-800">Welcome Doc</span>
        </div>
        <div class="p-1.5 rounded hover:bg-blue-100 flex items-center gap-2 cursor-pointer" onclick="document.querySelector('[data-open=\'win-resume\']').click(); document.getElementById('xp-start-menu').classList.add('hidden');">
          <Briefcase class="w-4 h-4 text-indigo-600" />
          <span class="font-bold text-slate-800 i18n" data-en="Curriculum Vitae" data-id="Resume / CV">Resume / CV</span>
        </div>
        <div class="p-1.5 rounded hover:bg-blue-100 flex items-center gap-2 cursor-pointer" onclick="document.querySelector('[data-open=\'win-explorer\']').click(); document.getElementById('xp-start-menu').classList.add('hidden');">
          <Laptop class="w-4 h-4 text-blue-700" />
          <span class="font-bold text-slate-800 i18n" data-en="My Computer" data-id="Komputer Saya">My Computer</span>
        </div>
        <div class="p-1.5 rounded hover:bg-blue-100 flex items-center gap-2 cursor-pointer" onclick="document.querySelector('[data-open=\'win-projects\']').click(); document.getElementById('xp-start-menu').classList.add('hidden');">
          <Folder class="w-4 h-4 text-amber-500" />
          <span class="font-bold text-slate-800 i18n" data-en="Case Studies" data-id="Studi Kasus">Case Studies</span>
        </div>
        <div class="p-1.5 rounded hover:bg-blue-100 flex items-center gap-2 cursor-pointer" onclick="document.querySelector('[data-open=\'win-media-player\']').click(); document.getElementById('xp-start-menu').classList.add('hidden');">
          <Play class="w-4 h-4 text-blue-800 fill-blue-800" />
          <span class="font-bold text-slate-800">Media Player</span>
        </div>
        <div class="p-1.5 rounded hover:bg-blue-100 flex items-center gap-2 cursor-pointer" onclick="document.querySelector('[data-open=\'win-search\']').click(); document.getElementById('xp-start-menu').classList.add('hidden');">
          <Search class="w-4 h-4 text-yellow-600" />
          <span class="font-bold text-slate-800 i18n" data-en="Search (Rover)" data-id="Cari Berkas">Search (Rover)</span>
        </div>
        <div class="p-1.5 rounded hover:bg-blue-100 flex items-center gap-2 cursor-pointer" onclick="document.querySelector('[data-open=\'win-cmd\']').click(); document.getElementById('xp-start-menu').classList.add('hidden');">
          <Terminal class="w-4 h-4 text-emerald-600" />
          <span class="font-bold text-slate-800">cmd.exe</span>
        </div>
