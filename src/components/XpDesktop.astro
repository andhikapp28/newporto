  function updateTaskmgrApps() {
    if (!taskmgrAppRows) return;
    const wins = Array.from(document.querySelectorAll<HTMLElement>('.xp-window'))
      .filter(w => !w.classList.contains('hidden') && w.style.display !== 'none' && w.id !== 'win-taskmgr');

    if (wins.length === 0) {
      taskmgrAppRows.innerHTML = `<tr><td colspan="2" class="p-3 text-slate-400 italic i18n" data-en="No other applications are running." data-id="Tidak ada aplikasi lain yang aktif.">No other applications are running.</td></tr>`;
      selectedTaskmgrWinId = '';
      return;
    }

    taskmgrAppRows.innerHTML = wins.map(w => {
      const title = w.querySelector('.xp-titlebar span')?.textContent || w.id;
      const isSel = w.id === selectedTaskmgrWinId;
      return `
        <tr class="cursor-pointer hover:bg-blue-100 ${isSel ? 'bg-[#316ac5] text-white hover:bg-[#316ac5]' : 'text-slate-800'}" data-win-id="${w.id}">
          <td class="p-1.5 flex items-center gap-1.5 border-r border-[#7f9db9] truncate">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500 shrink-0 inline-block"></span>
            <span class="truncate font-semibold">${title}</span>
          </td>
          <td class="p-1.5 text-emerald-600 font-bold ${isSel ? 'text-emerald-200' : ''}">Running</td>
        </tr>
      `;
    }).join('');

    taskmgrAppRows.querySelectorAll('tr').forEach(tr => {
      tr.addEventListener('click', () => {
        selectedTaskmgrWinId = tr.getAttribute('data-win-id') || '';
        updateTaskmgrApps();
      });
      tr.addEventListener('dblclick', () => {
        const wid = tr.getAttribute('data-win-id');
        if (wid) (window as any).openWindow(wid);
      });
    });
  }
  (window as any).updateTaskmgrApps = updateTaskmgrApps;

  taskmgrBtnEnd?.addEventListener('click', () => {
    if (!selectedTaskmgrWinId) return;
    const win = document.getElementById(selectedTaskmgrWinId);
    if (win) {
      closeWindow(win);
      playXpSound('click');
      selectedTaskmgrWinId = '';
      updateTaskmgrApps();
    }
  });

  taskmgrBtnSwitch?.addEventListener('click', () => {
    if (!selectedTaskmgrWinId) return;
    (window as any).openWindow(selectedTaskmgrWinId);
  });

  taskmgrBtnNew?.addEventListener('click', () => {
    (window as any).openWindow('win-run');
  });

  // Real-time Oscilloscope Graphs for Task Manager
  const canvasCpuGauge = document.getElementById('canvas-cpu-gauge') as HTMLCanvasElement;
  const canvasCpuGraph = document.getElementById('canvas-cpu-graph') as HTMLCanvasElement;
  const canvasMemGraph = document.getElementById('canvas-mem-graph') as HTMLCanvasElement;
  const cpuHistory: number[] = new Array(30).fill(30);
  const memHistory: number[] = new Array(50).fill(65);

  function renderTaskmgrCanvas() {
    const taskmgrWin = document.getElementById('win-taskmgr');
    if (!taskmgrWin || taskmgrWin.classList.contains('hidden')) return;

    const cpuValEl = document.getElementById('taskmgr-cpu-val');
    const cpuSbEl = document.getElementById('taskmgr-sb-cpu');

    const currentCpu = Math.floor(25 + Math.random() * 35 + (Math.sin(Date.now() / 1500) * 15));
    cpuHistory.push(currentCpu);
    if (cpuHistory.length > 30) cpuHistory.shift();

    const currentMem = Math.floor(62 + Math.random() * 8);
    memHistory.push(currentMem);
    if (memHistory.length > 50) memHistory.shift();

    if (cpuValEl) cpuValEl.innerText = `${currentCpu}%`;
    if (cpuSbEl) cpuSbEl.innerText = `${currentCpu}%`;

    // 1. Draw Gauge
    if (canvasCpuGauge) {
      const ctx = canvasCpuGauge.getContext('2d');
      if (ctx) {
        ctx.fillStyle = '#001100';
        ctx.fillRect(0, 0, canvasCpuGauge.width, canvasCpuGauge.height);
        const bars = 14;
        const activeBars = Math.floor((currentCpu / 100) * bars);
        const barH = (canvasCpuGauge.height - 4) / bars;
        for (let i = 0; i < bars; i++) {
          const y = canvasCpuGauge.height - (i + 1) * barH;
          ctx.fillStyle = i < activeBars ? '#00ff00' : '#003300';
          ctx.fillRect(4, y, canvasCpuGauge.width - 8, barH - 1.5);
        }
      }
    }

    // 2. Draw CPU Graph
    if (canvasCpuGraph) {
      const ctx = canvasCpuGraph.getContext('2d');
      if (ctx) {
        const w = canvasCpuGraph.width;
        const h = canvasCpuGraph.height;
        ctx.fillStyle = '#001100';
        ctx.fillRect(0, 0, w, h);

        ctx.strokeStyle = '#003300';
        ctx.lineWidth = 1;
        for (let x = 0; x < w; x += 15) {
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
        }
        for (let y = 0; y < h; y += 12) {
          ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
        }

        ctx.strokeStyle = '#00ff00';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        const step = w / (cpuHistory.length - 1);
        cpuHistory.forEach((val, i) => {
          const x = i * step;
          const y = h - (val / 100) * (h - 6) - 3;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        });
        ctx.stroke();
      }
    }

    // 3. Draw Mem Graph
    if (canvasMemGraph) {
      const ctx = canvasMemGraph.getContext('2d');
      if (ctx) {
        const w = canvasMemGraph.width;
        const h = canvasMemGraph.height;
        ctx.fillStyle = '#001100';
        ctx.fillRect(0, 0, w, h);

        ctx.strokeStyle = '#003300';
        ctx.lineWidth = 1;
        for (let x = 0; x < w; x += 20) {
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
        }
        for (let y = 0; y < h; y += 12) {
          ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
        }

        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        const step = w / (memHistory.length - 1);
        memHistory.forEach((val, i) => {
          const x = i * step;
          const y = h - (val / 100) * (h - 6) - 3;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        });
        ctx.stroke();
      }
    }
  }

  setInterval(renderTaskmgrCanvas, 1000);

  // ==========================================================================
  // 17. MS PAINT (mspaint.exe)
  // ==========================================================================
  const paintCanvas = document.getElementById('paint-canvas') as HTMLCanvasElement;
  const paintCtx = paintCanvas ? paintCanvas.getContext('2d') : null;
  const paintPalette = document.getElementById('paint-palette');
  const paintCurrColor = document.getElementById('paint-curr-color');
  const paintCoords = document.getElementById('paint-coords');
  const toolPencil = document.getElementById('tool-pencil');
  const toolBrush = document.getElementById('tool-brush');
  const toolEraser = document.getElementById('tool-eraser');
  const toolClear = document.getElementById('tool-clear');
  const paintSizeSelect = document.getElementById('paint-size') as HTMLSelectElement;
  const paintBtnSave = document.getElementById('paint-btn-save');
  const paintMenuSave = document.getElementById('paint-menu-save');
  const paintMenuClear = document.getElementById('paint-menu-clear');

  let activePaintTool = 'pencil';
  let activePaintColor = '#000000';
  let activePaintSize = 5;
  let isPainting = false;

  const xp16Colors = [
    '#000000', '#808080', '#800000', '#808000', '#008000', '#008080', '#000080', '#800080',
    '#ffffff', '#c0c0c0', '#ff0000', '#ffff00', '#00ff00', '#00ffff', '#0000ff', '#ff00ff'
  ];

  if (paintPalette) {
    paintPalette.innerHTML = xp16Colors.map(c => `
      <div class="w-3.5 h-3.5 border border-slate-700 cursor-pointer" style="background: ${c};" data-color="${c}"></div>
    `).join('');
    paintPalette.querySelectorAll('div').forEach(swatch => {
      swatch.addEventListener('click', () => {
        const c = swatch.getAttribute('data-color') || '#000000';
        activePaintColor = c;
        if (paintCurrColor) paintCurrColor.style.background = c;
        playXpSound('click');
      });
    });
  }

  function initPaintCanvas() {
    if (!paintCanvas || !paintCtx) return;
    paintCtx.fillStyle = '#ffffff';
    paintCtx.fillRect(0, 0, paintCanvas.width, paintCanvas.height);
  }
  initPaintCanvas();

  function selectTool(tool: string) {
    activePaintTool = tool;
    [toolPencil, toolBrush, toolEraser].forEach(b => b?.classList.remove('active'));
    if (tool === 'pencil') toolPencil?.classList.add('active');
    if (tool === 'brush') toolBrush?.classList.add('active');
    if (tool === 'eraser') toolEraser?.classList.add('active');
  }

  toolPencil?.addEventListener('click', () => selectTool('pencil'));
  toolBrush?.addEventListener('click', () => selectTool('brush'));
  toolEraser?.addEventListener('click', () => selectTool('eraser'));
  toolClear?.addEventListener('click', initPaintCanvas);
  paintMenuClear?.addEventListener('click', initPaintCanvas);
  paintSizeSelect?.addEventListener('change', () => {
    activePaintSize = parseInt(paintSizeSelect.value, 10) || 5;
  });

  function getCanvasCoords(e: MouseEvent | TouchEvent): { x: number; y: number } {
    if (!paintCanvas) return { x: 0, y: 0 };
    const rect = paintCanvas.getBoundingClientRect();
    const clientX = 'touches' in e ? e.touches[0].clientX : (e as MouseEvent).clientX;
    const clientY = 'touches' in e ? e.touches[0].clientY : (e as MouseEvent).clientY;
    return {
      x: Math.round((clientX - rect.left) * (paintCanvas.width / rect.width)),
      y: Math.round((clientY - rect.top) * (paintCanvas.height / rect.height))
    };
  }

  function startDrawing(e: MouseEvent | TouchEvent) {
    if (!paintCtx) return;
    isPainting = true;
    const { x, y } = getCanvasCoords(e);
    paintCtx.beginPath();
    paintCtx.moveTo(x, y);
    paintCtx.lineCap = 'round';
    paintCtx.lineJoin = 'round';
    paintCtx.lineWidth = activePaintTool === 'pencil' ? 2 : activePaintTool === 'eraser' ? activePaintSize * 2.5 : activePaintSize;
    paintCtx.strokeStyle = activePaintTool === 'eraser' ? '#ffffff' : activePaintColor;
    drawMove(e);
  }

  function drawMove(e: MouseEvent | TouchEvent) {
    const { x, y } = getCanvasCoords(e);
    if (paintCoords) paintCoords.innerText = `${x}, ${y} px`;
    if (!isPainting || !paintCtx) return;
    paintCtx.lineTo(x, y);
    paintCtx.stroke();
  }

  function stopDrawing() {
    isPainting = false;
  }

  paintCanvas?.addEventListener('mousedown', startDrawing);
  paintCanvas?.addEventListener('mousemove', drawMove);
  window.addEventListener('mouseup', stopDrawing);
  paintCanvas?.addEventListener('touchstart', (e) => { e.preventDefault(); startDrawing(e); });
  paintCanvas?.addEventListener('touchmove', (e) => { e.preventDefault(); drawMove(e); });
  window.addEventListener('touchend', stopDrawing);

  function downloadPaint() {
    if (!paintCanvas) return;
    const link = document.createElement('a');
    link.download = 'andhika_xp_doodle.png';
    link.href = paintCanvas.toDataURL('image/png');
    link.click();
    playXpSound('click');
  }

  paintBtnSave?.addEventListener('click', downloadPaint);
  paintMenuSave?.addEventListener('click', downloadPaint);

  // ==========================================================================
  // 18. MINESWEEPER (winmine.exe)
  // ==========================================================================
  const msBoard = document.getElementById('ms-board');
  const msCounter = document.getElementById('ms-counter');
  const msTimer = document.getElementById('ms-timer');
  const msSmiley = document.getElementById('ms-smiley');
  const msMenuNew = document.getElementById('ms-menu-new');

  const MS_ROWS = 9;
  const MS_COLS = 9;
  const MS_MINES = 10;
  let msGrid: Array<Array<{ mine: boolean; revealed: boolean; flagged: boolean; count: number }>> = [];
  let msGameStarted = false;
  let msGameOver = false;
  let msTimerInterval: any = null;
  let msSeconds = 0;
  let msFlagsRemaining = MS_MINES;
  let msTouchFlagMode = false;
  const msModeToggle = document.getElementById('ms-mode-toggle');
  const msModeIcon = document.getElementById('ms-mode-icon');
  const msModeLabel = document.getElementById('ms-mode-label');

  if (msModeToggle) {
    msModeToggle.addEventListener('click', () => {
      msTouchFlagMode = !msTouchFlagMode;
      if (msModeIcon) msModeIcon.innerText = msTouchFlagMode ? '🚩' : '⛏️';
      if (msModeLabel) {
        msModeLabel.setAttribute('data-en', msTouchFlagMode ? 'Mode: Flag 🚩' : 'Mode: Dig ⛏️');
        msModeLabel.setAttribute('data-id', msTouchFlagMode ? 'Mode: Bendera 🚩' : 'Mode: Buka ⛏️');
        msModeLabel.innerText = msTouchFlagMode ? 'Mode: Flag 🚩' : 'Mode: Dig ⛏️';
      }
    });
  }

  function initMinesweeper() {
    clearInterval(msTimerInterval);
    msTimerInterval = null;
    msSeconds = 0;
    msGameStarted = false;
    msGameOver = false;
    msFlagsRemaining = MS_MINES;
    if (msCounter) msCounter.innerText = '010';
    if (msTimer) msTimer.innerText = '000';
    if (msSmiley) msSmiley.innerText = '🙂';

    msGrid = [];
    for (let r = 0; r < MS_ROWS; r++) {
      const row = [];
      for (let c = 0; c < MS_COLS; c++) {
        row.push({ mine: false, revealed: false, flagged: false, count: 0 });
      }
      msGrid.push(row);
    }
    renderMsBoard();
  }

  function renderMsBoard() {
    if (!msBoard) return;
    msBoard.innerHTML = '';
    const table = document.createElement('table');
    table.className = 'border-collapse';
    for (let r = 0; r < MS_ROWS; r++) {
      const tr = document.createElement('tr');
      for (let c = 0; c < MS_COLS; c++) {
        const td = document.createElement('td');
        const cell = msGrid[r][c];
        const btn = document.createElement('div');
        btn.className = 'ms-cell';
        btn.dataset.r = r.toString();
        btn.dataset.c = c.toString();

        if (cell.revealed) {
          btn.classList.add('revealed');
          if (cell.mine) {
            btn.innerText = '💣';
          } else if (cell.count > 0) {
            btn.innerText = cell.count.toString();
            const colors = ['', 'text-blue-600', 'text-green-600', 'text-red-600', 'text-blue-900', 'text-red-900', 'text-teal-700', 'text-black', 'text-slate-500'];
            btn.classList.add(colors[cell.count] || 'text-black');
          }
        } else if (cell.flagged) {
          btn.innerText = '🚩';
        }

        btn.addEventListener('mousedown', (e) => {
          if (msGameOver) return;
          if (e.button === 0 && msSmiley) msSmiley.innerText = '😮';
        });

        btn.addEventListener('mouseup', () => {
          if (!msGameOver && msSmiley) msSmiley.innerText = '🙂';
        });

        btn.addEventListener('click', () => handleMsCellClick(r, c));
        btn.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          handleMsCellRightClick(r, c);
        });

        td.appendChild(btn);
        tr.appendChild(td);
      }
      table.appendChild(tr);
    }
    msBoard.appendChild(table);
  }

  function startMsTimer() {
    if (msTimerInterval) return;
    msTimerInterval = setInterval(() => {
      msSeconds++;
      if (msSeconds > 999) msSeconds = 999;
      if (msTimer) msTimer.innerText = msSeconds.toString().padStart(3, '0');
    }, 1000);
  }

  function handleMsCellClick(r: number, c: number) {
    if (msGameOver) return;
    const cell = msGrid[r][c];
    if (cell.flagged || cell.revealed) return;

    if (!msGameStarted) {
      msGameStarted = true;
      startMsTimer();
      let placed = 0;
      while (placed < MS_MINES) {
        const randR = Math.floor(Math.random() * MS_ROWS);
        const randC = Math.floor(Math.random() * MS_COLS);
        if ((randR !== r || randC !== c) && !msGrid[randR][randC].mine) {
          msGrid[randR][randC].mine = true;
          placed++;
        }
      }
      for (let i = 0; i < MS_ROWS; i++) {
        for (let j = 0; j < MS_COLS; j++) {
          if (msGrid[i][j].mine) continue;
          let cnt = 0;
          for (let dr = -1; dr <= 1; dr++) {
            for (let dc = -1; dc <= 1; dc++) {
              const nr = i + dr;
              const nc = j + dc;
              if (nr >= 0 && nr < MS_ROWS && nc >= 0 && nc < MS_COLS && msGrid[nr][nc].mine) {
                cnt++;
              }
            }
          }
          msGrid[i][j].count = cnt;
        }
      }
    }

    if (cell.mine) {
      msGameOver = true;
      clearInterval(msTimerInterval);
      if (msSmiley) msSmiley.innerText = '😵';
      playXpSound('error');
      for (let i = 0; i < MS_ROWS; i++) {
        for (let j = 0; j < MS_COLS; j++) {
          if (msGrid[i][j].mine) msGrid[i][j].revealed = true;
        }
      }
      renderMsBoard();
      const hitBtn = msBoard?.querySelector(`[data-r="${r}"][data-c="${c}"]`);
      hitBtn?.classList.add('mine-hit');
      return;
    }

    revealCell(r, c);
    renderMsBoard();
    playXpSound('click');

    let unrevealedSafe = 0;
    for (let i = 0; i < MS_ROWS; i++) {
      for (let j = 0; j < MS_COLS; j++) {
        if (!msGrid[i][j].mine && !msGrid[i][j].revealed) unrevealedSafe++;
      }
    }
    if (unrevealedSafe === 0) {
      msGameOver = true;
      clearInterval(msTimerInterval);
      if (msSmiley) msSmiley.innerText = '😎';
      playXpSound('tada');
    }
  }

  function revealCell(r: number, c: number) {
    if (r < 0 || r >= MS_ROWS || c < 0 || c >= MS_COLS) return;
    const cell = msGrid[r][c];
    if (cell.revealed || cell.flagged || cell.mine) return;
    cell.revealed = true;
    if (cell.count === 0) {
      for (let dr = -1; dr <= 1; dr++) {
        for (let dc = -1; dc <= 1; dc++) {
          revealCell(r + dr, c + dc);
        }
      }
    }
  }

  function handleMsCellRightClick(r: number, c: number) {
    if (msGameOver) return;
    if (!msGameStarted) {
      msGameStarted = true;
      startMsTimer();
    }
    const cell = msGrid[r][c];
    if (cell.revealed) return;
    cell.flagged = !cell.flagged;
    msFlagsRemaining += cell.flagged ? -1 : 1;
    if (msCounter) msCounter.innerText = Math.max(0, msFlagsRemaining).toString().padStart(3, '0');
    renderMsBoard();
    playXpSound('click');
  }

  msSmiley?.addEventListener('click', initMinesweeper);
  msMenuNew?.addEventListener('click', initMinesweeper);
  initMinesweeper();

  // ==========================================================================
  // 19. TRAY BALLOON NOTIFICATION
  // ==========================================================================
  const trayBalloon = document.getElementById('xp-tray-balloon');
  const balloonClose = document.getElementById('balloon-close');
  const balloonBody = document.getElementById('balloon-body');

  setTimeout(() => {
    if (trayBalloon && !desktopContainer?.classList.contains('hidden')) {
      trayBalloon.classList.remove('hidden');
      playXpSound('balloon');
      setTimeout(() => trayBalloon?.classList.add('hidden'), 18000);
    }
  }, 4500);

  balloonClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    trayBalloon?.classList.add('hidden');
    playXpSound('click');
  });

  balloonBody?.addEventListener('click', () => {
    trayBalloon?.classList.add('hidden');
    (window as any).openWindow('win-fasttrack');
  });

  // ==========================================================================
  // 20. DESKTOP RIGHT-CLICK CONTEXT MENU
  // ==========================================================================
  const desktopContextMenu = document.getElementById('xp-desktop-context-menu');
  const desktopSpace = document.getElementById('xp-desktop-space');

  function closeContextMenu() {
    if (desktopContextMenu) desktopContextMenu.classList.add('hidden');
  }

  desktopSpace?.addEventListener('contextmenu', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.xp-window') || target.closest('#xp-start-menu') || target.closest('#xp-taskbar')) {
      return;
    }
    e.preventDefault();
    if (!desktopContextMenu) return;
    desktopContextMenu.style.left = `${Math.min(e.clientX, window.innerWidth - 180)}px`;
    desktopContextMenu.style.top = `${Math.min(e.clientY, window.innerHeight - 200)}px`;
    desktopContextMenu.classList.remove('hidden');
    playXpSound('click');
  });

  window.addEventListener('click', (e) => {
    if (desktopContextMenu && !desktopContextMenu.contains(e.target as Node)) {
      closeContextMenu();
    }
  });

  document.getElementById('ctx-disp-props')?.addEventListener('click', () => {
    (window as any).openWindow('win-display-props');
    closeContextMenu();
  });
  document.getElementById('ctx-taskmgr')?.addEventListener('click', () => {
    (window as any).openWindow('win-taskmgr');
    closeContextMenu();
  });
  document.getElementById('ctx-paint')?.addEventListener('click', () => {
    (window as any).openWindow('win-paint');
    closeContextMenu();
  });
  document.getElementById('ctx-minesweeper')?.addEventListener('click', () => {
    (window as any).openWindow('win-minesweeper');
    closeContextMenu();
  });
  document.getElementById('ctx-notepad')?.addEventListener('click', () => {
    (window as any).openWindow('win-notepad');
    closeContextMenu();
  });
  document.getElementById('ctx-refresh')?.addEventListener('click', () => {
    closeContextMenu();
    desktopContainer?.classList.add('xp-shake');
    playXpSound('click');
    setTimeout(() => desktopContainer?.classList.remove('xp-shake'), 300);
  });

  // ==========================================================================
  // 21. SCREENSAVER (3D FLOATING TEXT) & IDLE DETECTION
  // ==========================================================================
  const screensaverEl = document.getElementById('xp-screensaver');
  let idleTimer = 0;

  function showScreensaver() {
    if (screensaverEl && !desktopContainer?.classList.contains('hidden')) {
      screensaverEl.classList.remove('hidden');
      screensaverEl.classList.add('flex');
    }
  }

  function hideScreensaver() {
    if (screensaverEl) {
      screensaverEl.classList.add('hidden');
      screensaverEl.classList.remove('flex');
    }
    idleTimer = 0;
  }

  (window as any).triggerScreensaver = showScreensaver;

  setInterval(() => {
    idleTimer++;
    if (idleTimer >= 80) showScreensaver();
  }, 1000);

  ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll'].forEach(evt => {
    window.addEventListener(evt, (e) => {
      if (evt === 'keydown' && ((e.target as HTMLElement)?.tagName === 'INPUT' || (e.target as HTMLElement)?.tagName === 'TEXTAREA')) {
        return;
      }
      if (screensaverEl && !screensaverEl.classList.contains('hidden')) {
        hideScreensaver();
      }
      idleTimer = 0;
    });
  });

  // ==========================================================================
  // 22. BLUE SCREEN OF DEATH (BSOD) EASTER EGG
  // ==========================================================================
  const bsodEl = document.getElementById('xp-bsod');

  function triggerBsod() {
    if (!bsodEl) return;
    bsodEl.classList.remove('hidden');
    bsodEl.classList.add('flex');
    playXpSound('error');
  }

  function hideBsod() {
    if (!bsodEl) return;
    bsodEl.classList.add('hidden');
    bsodEl.classList.remove('flex');
    playXpSound('ding');
  }

  (window as any).triggerBsod = triggerBsod;

  bsodEl?.addEventListener('click', hideBsod);
  window.addEventListener('keydown', (e) => {
    if (e.target === cmdInput || (e.target as HTMLElement)?.tagName === 'INPUT' || (e.target as HTMLElement)?.tagName === 'TEXTAREA') {
      return;
    }
    if (bsodEl && !bsodEl.classList.contains('hidden')) {
      hideBsod();
    }
    if (e.ctrlKey && e.shiftKey && e.key === 'Escape') {
      e.preventDefault();
      (window as any).openWindow('win-taskmgr');
    }
  });
</script>
