<style>
  @keyframes tailWag {
    0% { transform: rotate(0deg); }
    50% { transform: rotate(18deg); }
    100% { transform: rotate(0deg); }
  }
  .rover-tail {
    animation: tailWag 0.6s ease-in-out infinite;
    transform-origin: 74px 65px;
  }
</style>

<script>
  // 2. Language Switcher (ID <-> EN)
  let currentLang = 'id'; // Default Indonesian as requested
  const langBtn = document.getElementById('lang-toggle-btn');

  function applyLanguage(lang: string) {
    currentLang = lang;
    const elements = document.querySelectorAll<HTMLElement>('.i18n');
    elements.forEach(el => {
      const text = el.getAttribute(`data-${lang}`);
      if (text) el.innerHTML = text;
    });
    if (langBtn) {
      langBtn.innerText = lang.toUpperCase();
    }
  }

  langBtn?.addEventListener('click', () => {
    const nextLang = currentLang === 'id' ? 'en' : 'id';
    applyLanguage(nextLang);
  });
  // Initial set to Indonesian
  applyLanguage('id');

  // 3. Start Menu Toggle
  const startBtn = document.getElementById('xp-start-btn');
  const startMenu = document.getElementById('xp-start-menu');

  startBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    startMenu?.classList.toggle('hidden');
    startMenu?.classList.toggle('flex');
  });

  document.addEventListener('click', (e) => {
    if (startMenu && !startMenu.contains(e.target as Node) && e.target !== startBtn) {
      startMenu.classList.add('hidden');
      startMenu.classList.remove('flex');
    }
  });

  // 4. System Tray Clock
  function updateClock() {
    const clockEl = document.getElementById('xp-clock');
    if (!clockEl) return;
    const now = new Date();
    let hours = now.getHours();
    const minutes = now.getMinutes().toString().padStart(2, '0');
    const ampm = hours >= 12 ? 'PM' : 'AM';
    hours = hours % 12 || 12;
    clockEl.innerText = `${hours}:${minutes} ${ampm}`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // 5. Draggable Windows Logic & Active Z-Index
  let highestZIndex = 30;

  function bringToFront(win: HTMLElement) {
    highestZIndex += 1;
    win.style.zIndex = highestZIndex.toString();
  }

  const windows = document.querySelectorAll<HTMLElement>('.xp-window');
  windows.forEach((win) => {
    win.addEventListener('mousedown', () => bringToFront(win));

    const titlebar = win.querySelector<HTMLElement>('.xp-titlebar');
    if (titlebar) {
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let initialLeft = 0;
      let initialTop = 0;

      titlebar.addEventListener('mousedown', (e) => {
        isDragging = true;
        bringToFront(win);
        startX = e.clientX;
        startY = e.clientY;
        initialLeft = win.offsetLeft;
        initialTop = win.offsetTop;

        function onMouseMove(moveEvent: MouseEvent) {
          if (!isDragging) return;
          const dx = moveEvent.clientX - startX;
          const dy = moveEvent.clientY - startY;
          win.style.left = `${Math.max(0, initialLeft + dx)}px`;
          win.style.top = `${Math.max(0, initialTop + dy)}px`;
        }

        function onMouseUp() {
          isDragging = false;
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
        }

        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      });
    }

    // Window controls
    const btnClose = win.querySelector('.win-btn-close');
    btnClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      win.classList.add('hidden');
      win.style.display = 'none';
      updateTaskbar();
    });

    const btnMinimize = win.querySelector('.win-btn-minimize');
    btnMinimize?.addEventListener('click', (e) => {
      e.stopPropagation();
      win.classList.add('hidden');
      win.style.display = 'none';
      updateTaskbar();
    });

    const btnMaximize = win.querySelector('.win-btn-maximize');
    btnMaximize?.addEventListener('click', () => {
      if (win.dataset.maximized === 'true') {
        win.style.width = win.dataset.prevWidth || '580px';
        win.style.height = win.dataset.prevHeight || 'auto';
        win.style.top = win.dataset.prevTop || '40px';
        win.style.left = win.dataset.prevLeft || '80px';
        win.dataset.maximized = 'false';
      } else {
        win.dataset.prevWidth = win.style.width || `${win.offsetWidth}px`;
        win.dataset.prevHeight = win.style.height || `${win.offsetHeight}px`;
        win.dataset.prevTop = `${win.offsetTop}px`;
        win.dataset.prevLeft = `${win.offsetLeft}px`;
        win.style.width = '100vw';
        win.style.height = 'calc(100vh - 30px)';
        win.style.top = '0px';
        win.style.left = '0px';
        win.dataset.maximized = 'true';
      }
    });
  });

  // 6. Desktop Icons Opening Windows
  const desktopIcons = document.querySelectorAll('.xp-desktop-icon');
  desktopIcons.forEach((icon) => {
    icon.addEventListener('click', () => {
      const targetId = icon.getAttribute('data-open');
      if (targetId) {
        const targetWin = document.getElementById(targetId);
        if (targetWin) {
          targetWin.classList.remove('hidden');
          targetWin.style.display = 'flex';
          bringToFront(targetWin);
          updateTaskbar();
        }
      }
    });
  });

  // 7. Case Study Explorer -> Open in Internet Explorer 6 Window!
  const projectRows = document.querySelectorAll('.xp-project-row');
  const ieReader = document.getElementById('win-ie-reader');
  const ieAddressBar = document.getElementById('ie-address-bar');
  const ieTitlebar = document.getElementById('ie-titlebar-text');

  projectRows.forEach((row) => {
    row.addEventListener('click', () => {
      const projectId = row.getAttribute('data-project-id');
      if (!projectId || !ieReader) return;

      document.querySelectorAll('.ie-case-study-article').forEach(art => art.classList.add('hidden'));
      const targetArt = document.getElementById(`ie-article-${projectId}`);
      if (targetArt) {
        targetArt.classList.remove('hidden');
      }

      if (ieAddressBar) {
        ieAddressBar.innerText = `http://internal.damri.co.id/specs/${projectId}.html`;
      }
      if (ieTitlebar) {
        const title = row.querySelector('span')?.textContent || 'Case Study';
        ieTitlebar.innerText = `Microsoft Internet Explorer - ${title}`;
      }

      ieReader.classList.remove('hidden');
      ieReader.style.display = 'flex';
      bringToFront(ieReader);
      updateTaskbar();
    });
  });

  // 8. Strict Taskbar Sync: ONLY OPEN WINDOWS ARE DISPLAYED!
  function updateTaskbar() {
    const taskbarContainer = document.getElementById('xp-taskbar-items');
    if (!taskbarContainer) return;
    taskbarContainer.innerHTML = '';

    windows.forEach((win) => {
      const isVisible = win.style.display === 'flex' || (!win.classList.contains('hidden') && win.style.display !== 'none');
      if (!isVisible) return; // STRICT FILTER: Do not show closed windows!

      const title = win.querySelector('.xp-titlebar span')?.textContent || 'Window';

      const btn = document.createElement('button');
      btn.className = 'h-6 px-2.5 rounded text-[11px] font-bold flex items-center gap-1.5 cursor-pointer max-w-[140px] truncate shadow-inner bg-[#1b3f94] text-white border border-[#0d2358]';
      btn.innerText = title.split(' - ')[0];

      btn.addEventListener('click', () => {
        if (win.style.display === 'none' || win.classList.contains('hidden')) {
          win.classList.remove('hidden');
          win.style.display = 'flex';
          bringToFront(win);
        } else {
          win.classList.add('hidden');
          win.style.display = 'none';
        }
        updateTaskbar();
      });

      taskbarContainer.appendChild(btn);
    });
  }

  // Boot event listener from 3D stage
  window.addEventListener('xp:boot-desktop', () => {
    const desktop = document.getElementById('xp-desktop-container');
    if (desktop) {
      desktop.classList.remove('hidden');
      desktop.classList.add('flex');
    }
    const welcome = document.getElementById('win-welcome');
    if (welcome) {
      welcome.classList.remove('hidden');
      welcome.style.display = 'flex';
      bringToFront(welcome);
    }
    updateTaskbar();
  });

  // 9. Windows Media Player Logic
  const wmpPlayBtn = document.getElementById('wmp-play-toggle');
  const wmpPlayIcon = document.getElementById('wmp-play-icon');
  const wmpPauseIcon = document.getElementById('wmp-pause-icon');
  const wmpProgressBar = document.getElementById('wmp-progress-bar');
  const wmpTimeCurr = document.getElementById('wmp-time-curr');
  let isPlaying = false;
  let wmpAudio: HTMLAudioElement | null = null;
  let wmpInterval: any = null;

  wmpPlayBtn?.addEventListener('click', () => {
    if (!isPlaying) {
      isPlaying = true;
      wmpPlayIcon?.classList.add('hidden');
      wmpPauseIcon?.classList.remove('hidden');

      if (!wmpAudio) {
        wmpAudio = new Audio('/sounds/xp-startup.wav');
        wmpAudio.addEventListener('ended', () => {
          isPlaying = false;
          wmpPlayIcon?.classList.remove('hidden');
          wmpPauseIcon?.classList.add('hidden');
          if (wmpProgressBar) wmpProgressBar.style.width = '0%';
          clearInterval(wmpInterval);
        });
      }
      wmpAudio.play().catch(e => console.warn(e));

      // Visualizer animation
      wmpInterval = setInterval(() => {
        const bars = document.querySelectorAll('#wmp-bars div');
        bars.forEach(b => {
          const h = Math.floor(Math.random() * 80) + 10;
          (b as HTMLElement).style.height = `${h}px`;
        });
      }, 150);
    } else {
      isPlaying = false;
      wmpPlayIcon?.classList.remove('hidden');
      wmpPauseIcon?.classList.add('hidden');
      wmpAudio?.pause();
      clearInterval(wmpInterval);
    }
  });

  // 10. Rover the Search Dog Companion Logic
  const roverInput = document.getElementById('rover-search-input') as HTMLInputElement;
  const roverBtn = document.getElementById('rover-search-btn');
  const roverSpeech = document.getElementById('rover-speech');
  const roverResults = document.getElementById('rover-results-list');

  function runRoverSearch() {
    const q = roverInput?.value.trim().toLowerCase();
    if (!roverResults) return;

    if (!q) {
      if (roverSpeech) roverSpeech.innerText = 'Tulis kata kunci pencarian, saya akan mencarikannya untukmu!';
      return;
    }

    if (roverSpeech) {
      roverSpeech.innerText = `Woof! Menemukan hasil terkait "${q}" di dokumen & proyek DAMRI!`;
    }

    const items = roverResults.querySelectorAll('div.p-2\\.5');
    items.forEach(item => {
      const text = (item as HTMLElement).innerText.toLowerCase();
      if (text.includes(q)) {
        (item as HTMLElement).style.display = 'block';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  }

  roverBtn?.addEventListener('click', runRoverSearch);
  roverInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') runRoverSearch();
  });

  // 11. Authentic Windows XP Shutdown Dialog
  const openShutdownBtn = document.getElementById('xp-open-shutdown-btn');
  const shutdownModal = document.getElementById('xp-shutdown-modal');
  const modalTurnOff = document.getElementById('modal-btn-turn-off');
  const shutdownScreen = document.getElementById('xp-shutdown-screen');

  openShutdownBtn?.addEventListener('click', () => {
    startMenu?.classList.add('hidden');
    if (shutdownModal) {
      shutdownModal.classList.remove('hidden');
      shutdownModal.classList.add('flex');
    }
  });

  modalTurnOff?.addEventListener('click', () => {
    shutdownModal?.classList.add('hidden');
    shutdownModal?.classList.remove('flex');

    // Show "Windows is shutting down..." blue screen
    if (shutdownScreen) {
      shutdownScreen.classList.remove('hidden');
      shutdownScreen.classList.add('flex');
    }

    // Play real shutdown audio
    try {
      const audio = new Audio('/sounds/xp-shutdown.wav');
      audio.play().catch(e => console.warn(e));
    } catch (e) {
      console.error(e);
    }

    // After 2.5s return cleanly to 3D workstation
    setTimeout(() => {
      if (shutdownScreen) {
        shutdownScreen.classList.add('hidden');
        shutdownScreen.classList.remove('flex');
      }
      const desktop = document.getElementById('xp-desktop-container');
      if (desktop) {
        desktop.classList.add('hidden');
        desktop.classList.remove('flex');
      }
      window.dispatchEvent(new CustomEvent('xp:shutdown-to-3d'));
    }, 2500);
  });

  // 12. Command Prompt
  const cmdInput = document.getElementById('cmd-input') as HTMLInputElement;
  const cmdOutput = document.getElementById('cmd-output');
  const cmdScreen = document.getElementById('cmd-screen');

  cmdInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const val = cmdInput.value.trim().toLowerCase();
      if (!val) return;

      const line = document.createElement('div');
      line.innerHTML = `<span class="text-slate-400">E:\\KERJA\\DAMRI&gt;</span> <span class="text-white">${cmdInput.value}</span>`;
      cmdOutput?.appendChild(line);

      const resp = document.createElement('div');
      resp.className = 'text-emerald-300 pl-2';

      if (val === 'help') {
        resp.innerHTML = `
          Perintah yang tersedia:<br/>
          &bull; <span class="text-yellow-300">damri</span>    - Informasi sistem kerja Perum DAMRI<br/>
          &bull; <span class="text-yellow-300">pumk</span>     - Detail arsitektur aplikasi PUMK<br/>
          &bull; <span class="text-yellow-300">push</span>     - Detail aplikasi Push Request & GitHub Tracker<br/>
          &bull; <span class="text-yellow-300">skills</span>   - Matriks keahlian SA, Dev & QA<br/>
          &bull; <span class="text-yellow-300">contact</span>  - Email & saluran komunikasi<br/>
          &bull; <span class="text-yellow-300">clear</span>    - Bersihkan layar terminal
        `;
      } else if (val === 'damri' || val === 'pumk') {
        resp.innerHTML = `
          [PUMK DAMRI]: Sistem Pembinaan & Pembiayaan UMKM BUMN.<br/>
          - Validasi NIK 16 digit & Penomoran unik via lockForUpdate<br/>
          - Integrasi Shadow User ke database SSO DAMRI<br/>
          - Kamus data komprehensif & penyesuaian format PO Excel
        `;
      } else if (val === 'push') {
        resp.innerHTML = `
          [PUSH REQUEST DAMRI]: Sistem Audit Commit & Manajemen Proyek IT.<br/>
          - Webhook GitHub API & diff audit ke production<br/>
          - Kanban board task & target SLA insiden lintas unit
        `;
      } else if (val === 'skills') {
        resp.innerHTML = `
          [SA]: BRD/SRS, BPMN 2.0, Kamus Data, Skema Relasional, SSO Auth<br/>
          [DEV]: Laravel 12, PostgreSQL, Concurrency Locks, GitHub API, REST<br/>
          [QA]: Boundary Testing, Test Cases Matrix, Postman API Testing
        `;
      } else if (val === 'contact') {
        resp.innerHTML = `Email: analyst.dipa@example.com | Perum DAMRI`;
      } else if (val === 'clear') {
        if (cmdOutput) cmdOutput.innerHTML = '';
        cmdInput.value = '';
        return;
      } else {
        resp.innerHTML = `'${val}' tidak dikenali. Ketik 'help' untuk panduan.`;
      }

      cmdOutput?.appendChild(resp);
      cmdInput.value = '';
      if (cmdScreen) cmdScreen.scrollTop = cmdScreen.scrollHeight;
    }
  });

  // 13. Copy Email
  const copyBtn = document.getElementById('xp-copy-email-btn');
  const copyIcon = document.getElementById('xp-copy-icon');
  const copiedIcon = document.getElementById('xp-copied-icon');
  const copyText = document.getElementById('xp-copy-text');

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText('analyst.dipa@example.com').then(() => {
      copyIcon?.classList.add('hidden');
      copiedIcon?.classList.remove('hidden');
      if (copyText) copyText.innerText = 'Tersalin!';
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        copiedIcon?.classList.add('hidden');
        if (copyText) copyText.innerText = 'Copy Address';
      }, 2000);
    });
  });
</script>
