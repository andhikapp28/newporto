<!-- Load YouTube IFrame API for Windows Media Player -->
<script is:inline src="https://www.youtube.com/iframe_api"></script>

<style>
  @keyframes tailWag {
    0% { transform: rotate(0deg); }
    50% { transform: rotate(18deg); }
    100% { transform: rotate(0deg); }
  }
  .rover-tail {
    animation: tailWag 0.6s ease-in-out infinite;
    transform-origin: 74px 65px;
  }

  @keyframes xpShake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    50% { transform: translateX(6px); }
    75% { transform: translateX(-6px); }
  }
  .xp-shake {
    animation: xpShake 0.3s ease-in-out;
  }

  /* Ensure notepad textarea uses fixed font stack and no chrome */
  #notepad-textarea {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
</style>

<script>
  import { audioManager } from '../scripts/audioManager';
  import { animate } from 'animejs';

  // 1. Window Management & Taskbar Sync
  let highestZIndex = 30;
  let recycleBinItems: Array<{ id: string; title: string; closedAt: string }> = [];

  function bringToFront(win: HTMLElement) {
    highestZIndex += 1;
    win.style.zIndex = highestZIndex.toString();
    windows.forEach(w => w.classList.remove('active-window'));
    win.classList.add('active-window');
  }

  // Expose openWindow to window so inline onclick handlers work without fail
  (window as any).openWindow = function(winId: string) {
    const win = document.getElementById(winId);
    if (!win) return;

    // Mobile-adaptive positioning and sizing
    const isMobile = window.innerWidth <= 640;
    if (isMobile) {
      win.style.left = '4px';
      win.style.top = '6px';
      win.style.width = `${window.innerWidth - 8}px`;
      win.style.maxWidth = `${window.innerWidth - 8}px`;
      win.style.maxHeight = `${window.innerHeight - 38}px`;
    } else {
      // Desktop: clamp bounds so windows don't spill off-screen
      const curLeft = win.offsetLeft;
      const curWidth = win.offsetWidth || 560;
      if (curLeft + curWidth > window.innerWidth) {
        win.style.left = `${Math.max(10, window.innerWidth - curWidth - 20)}px`;
      }
      if (win.offsetTop + 100 > window.innerHeight) {
        win.style.top = '40px';
      }
    }

    win.classList.remove('hidden');
    win.style.display = 'flex';
    animateWindowOpen(win);
    win.dataset.state = 'open';
    bringToFront(win);
    updateTaskbar();

    // If opening cmd, focus the input
    if (winId === 'win-cmd') {
      setTimeout(() => {
        document.getElementById('cmd-input')?.focus();
      }, 100);
    }

    // If opening run dialog, focus input
    if (winId === 'win-run') {
      setTimeout(() => {
        document.getElementById('run-input')?.focus();
      }, 100);
    }

    // If opening notepad, focus textarea
    if (winId === 'win-notepad') {
      setTimeout(() => {
        document.getElementById('notepad-textarea')?.focus();
      }, 100);
    }

    // If opening search, focus input
    if (winId === 'win-search') {
      setTimeout(() => {
        document.getElementById('rover-search-input')?.focus();
      }, 100);
    }

    // If opening taskmgr, refresh application list
    if (winId === 'win-taskmgr') {
      try {
        if (typeof (window as any).updateTaskmgrApps === 'function') {
          (window as any).updateTaskmgrApps();
        }
      } catch (e) {}
    }
  };
  (window as any).closeWindow = closeWindow;

  // Close window helper used by keyboard shortcuts & recycle tracking
  function closeWindow(winOrId: HTMLElement | string) {
    const win = typeof winOrId === 'string' ? document.getElementById(winOrId) as HTMLElement : winOrId;
    if (!win) return;
    const id = win.id;
    try {
      // Add to recycle bin if it was a real application window (not dialogs)
      if (id && id.startsWith('win-') && !['win-run', 'win-shutdown-modal', 'xp-shutdown-modal', 'xp-shutdown-screen'].includes(id)) {
        if (typeof addToRecycleBin === 'function') {
          addToRecycleBin(id);
        }
      }
    } catch (err) {
      console.warn('Recycle tracking error:', err);
    }
    // Stop WMP if closing media player
    if (id === 'win-media-player') {
      try {
        (window as any).stopWmp?.();
      } catch (e) {}
    }
    win.dataset.state = 'closed';
    win.classList.add('hidden');
    win.style.display = 'none';
    updateTaskbar();
  }

  function minimizeWindow(win: HTMLElement) {
    if (!win) return;
    win.dataset.state = 'minimized';
    win.classList.add('hidden');
    win.style.display = 'none';
    updateTaskbar();
  }

  const windows = document.querySelectorAll<HTMLElement>('.xp-window');
  windows.forEach((win) => {
    win.addEventListener('mousedown', () => bringToFront(win));

    // Titlebar drag (Pointer Events for Full Mobile Touch & Desktop Mouse Support)
    const titlebar = win.querySelector<HTMLElement>('.xp-titlebar');
    if (titlebar) {
      titlebar.style.touchAction = 'none';
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let initialLeft = 0;
      let initialTop = 0;

      const onDragStart = (e: PointerEvent) => {
        if (e.button !== 0 && e.pointerType === 'mouse') return;
        if ((e.target as HTMLElement).closest('.win-btn-minimize, .win-btn-maximize, .win-btn-close')) {
          return;
        }
        isDragging = true;
        bringToFront(win);
        startX = e.clientX;
        startY = e.clientY;
        initialLeft = win.offsetLeft;
        initialTop = win.offsetTop;

        try {
          titlebar.setPointerCapture(e.pointerId);
        } catch (_) {}

        const onPointerMove = (moveEvent: PointerEvent) => {
          if (!isDragging) return;
          const dx = moveEvent.clientX - startX;
          const dy = moveEvent.clientY - startY;

          // Bounds clamping: ensure window titlebar remains visible and reachable
          const maxLeft = Math.max(0, window.innerWidth - 60);
          const maxTop = Math.max(0, window.innerHeight - 50);
          const newLeft = Math.max(-win.offsetWidth + 80, Math.min(maxLeft, initialLeft + dx));
          const newTop = Math.max(0, Math.min(maxTop, initialTop + dy));

          win.style.left = `${newLeft}px`;
          win.style.top = `${newTop}px`;
        };

        const onPointerUp = (upEvent: PointerEvent) => {
          if (!isDragging) return;
          isDragging = false;
          try {
            titlebar.releasePointerCapture(upEvent.pointerId);
          } catch (_) {}
          window.removeEventListener('pointermove', onPointerMove);
          window.removeEventListener('pointerup', onPointerUp);
          window.removeEventListener('pointercancel', onPointerUp);
        };

        window.addEventListener('pointermove', onPointerMove);
        window.addEventListener('pointerup', onPointerUp);
        window.addEventListener('pointercancel', onPointerUp);
      };

      titlebar.addEventListener('pointerdown', onDragStart);
    }

    // Window Resizing via bottom-right grip handle (Pointer Events for Touch & Mouse)
    const resizeHandle = win.querySelector<HTMLElement>('.win-resize-handle');
    if (resizeHandle) {
      resizeHandle.style.touchAction = 'none';
      let isResizing = false;
      let startW = 0;
      let startH = 0;
      let startX = 0;
      let startY = 0;

      const onResizeStart = (e: PointerEvent) => {
        if (e.button !== 0 && e.pointerType === 'mouse') return;
        e.stopPropagation();
        isResizing = true;
        bringToFront(win);
        startX = e.clientX;
        startY = e.clientY;
        startW = win.offsetWidth;
        startH = win.offsetHeight;

        try {
          resizeHandle.setPointerCapture(e.pointerId);
        } catch (_) {}

        const onResizeMove = (moveEvent: PointerEvent) => {
          if (!isResizing) return;
          const dw = moveEvent.clientX - startX;
          const dh = moveEvent.clientY - startY;
          const maxW = window.innerWidth - win.offsetLeft - 4;
          const maxH = window.innerHeight - 34 - win.offsetTop - 4;

          win.style.width = `${Math.max(240, Math.min(maxW, startW + dw))}px`;
          win.style.height = `${Math.max(140, Math.min(maxH, startH + dh))}px`;
        };

        const onResizeUp = (upEvent: PointerEvent) => {
          if (!isResizing) return;
          isResizing = false;
          try {
            resizeHandle.releasePointerCapture(upEvent.pointerId);
          } catch (_) {}
          window.removeEventListener('pointermove', onResizeMove);
          window.removeEventListener('pointerup', onResizeUp);
          window.removeEventListener('pointercancel', onResizeUp);
        };

        window.addEventListener('pointermove', onResizeMove);
        window.addEventListener('pointerup', onResizeUp);
        window.addEventListener('pointercancel', onResizeUp);
      };

      resizeHandle.addEventListener('pointerdown', onResizeStart);
    }

    // Window controls
    const btnClose = win.querySelector('.win-btn-close');
    btnClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeWindow(win);
    });

    const btnMinimize = win.querySelector('.win-btn-minimize');
    btnMinimize?.addEventListener('click', (e) => {
      e.stopPropagation();
      win.dataset.state = 'minimized';
      win.classList.add('hidden');
      win.style.display = 'none';
      updateTaskbar();
    });

    const btnMaximize = win.querySelector('.win-btn-maximize');
    btnMaximize?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (win.dataset.maximized === 'true') {
        win.style.width = (win.dataset.prevWidth && win.dataset.prevWidth !== '0px') ? win.dataset.prevWidth : '580px';
        win.style.height = (win.dataset.prevHeight && win.dataset.prevHeight !== '0px') ? win.dataset.prevHeight : 'auto';
        win.style.top = win.dataset.prevTop || '40px';
        win.style.left = win.dataset.prevLeft || '80px';
        win.dataset.maximized = 'false';
      } else {
        const currentW = win.style.width || `${win.offsetWidth || 580}px`;
        const currentH = win.style.height || `${win.offsetHeight || 420}px`;
        win.dataset.prevWidth = (currentW === '0px' || !currentW) ? '580px' : currentW;
        win.dataset.prevHeight = (currentH === '0px' || !currentH) ? '420px' : currentH;
        win.dataset.prevTop = `${win.offsetTop}px`;
        win.dataset.prevLeft = `${win.offsetLeft}px`;
        win.style.width = '100vw';
        win.style.height = 'calc(100vh - 30px)';
        win.style.top = '0px';
        win.style.left = '0px';
        win.dataset.maximized = 'true';
      }
    });
  });

  // Desktop Icons Opening Windows + tooltip helpers
  const desktopIcons = document.querySelectorAll('.xp-desktop-icon');
  const iconTooltip = document.getElementById('xp-icon-tooltip');
  const iconTooltipTitle = document.getElementById('xp-icon-tooltip-title');
  const iconTooltipDesc = document.getElementById('xp-icon-tooltip-desc');

  desktopIcons.forEach((icon) => {
    icon.addEventListener('click', (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      const targetId = icon.getAttribute('data-open');
      if (targetId) {
        (window as any).openWindow(targetId);
      }
    });

    icon.addEventListener('mouseenter', () => {
      if (!iconTooltip || !iconTooltipTitle || !iconTooltipDesc) return;
      const title = icon.getAttribute('data-tooltip-title') || icon.getAttribute('title') || '';
      const desc = icon.getAttribute('data-tooltip-desc') || '';
      const langIdx = currentLang === 'id' ? 0 : 1;
      const titleLine = title.split(' | ')[langIdx] || title.split(' | ')[0] || title;
      const descLine = desc.split(' | ')[langIdx] || desc.split(' | ')[0] || desc;
      iconTooltipTitle.innerText = titleLine;
      iconTooltipDesc.innerText = descLine;
      iconTooltip.classList.remove('hidden');
    });

    icon.addEventListener('mousemove', (e: MouseEvent) => {
      if (!iconTooltip) return;
      iconTooltip.style.left = `${e.clientX + 12}px`;
      iconTooltip.style.top = `${e.clientY + 12}px`;
    });

    icon.addEventListener('mouseleave', () => {
      iconTooltip?.classList.add('hidden');
    });
  });

  // Strict Taskbar Sync: only OPEN or MINIMIZED windows appear. CLOSED windows are removed.
  function updateTaskbar() {
    const taskbarContainer = document.getElementById('xp-taskbar-items');
    if (!taskbarContainer) return;
    taskbarContainer.innerHTML = '';

    windows.forEach((win) => {
      const isVisible = win.style.display === 'flex' || (!win.classList.contains('hidden') && win.style.display !== 'none');

      // First-run: any window that is hidden and has no state is treated as closed
      if (!win.dataset.state) {
        win.dataset.state = isVisible ? 'open' : 'closed';
      }

      const state = win.dataset.state;
      // Closed window should never appear in taskbar
      if (state === 'closed') return;

      // Normalize minimized state
      const isMinimized = state === 'minimized' || (!isVisible && state !== 'closed');
      if (!isVisible && state !== 'closed') {
        win.dataset.state = 'minimized';
      }

      const title = win.querySelector('.xp-titlebar span')?.textContent || 'Window';

      const btn = document.createElement('button');
      const activeClass = isVisible ? 'active bg-[#1b3f94] text-white border border-[#0d2358]' : 'bg-[#3a6edc] text-white/80 border border-[#2b58c0]';
      btn.className = `xp-task-btn h-6 px-2.5 rounded text-[11px] font-bold flex items-center gap-1.5 cursor-pointer max-w-[140px] truncate shadow-inner ${activeClass}`;
      btn.setAttribute('data-window', win.id);
      btn.innerText = title.split(' - ')[0];

      btn.addEventListener('click', () => {
        if (win.dataset.state === 'minimized' || win.classList.contains('hidden') || win.style.display === 'none') {
          win.classList.remove('hidden');
          win.style.display = 'flex';
          win.dataset.state = 'open';
          bringToFront(win);
        } else if (win.classList.contains('active-window')) {
          win.classList.add('hidden');
          win.style.display = 'none';
          win.dataset.state = 'minimized';
          win.classList.remove('active-window');
        } else {
          bringToFront(win);
        }
        updateTaskbar();
      });

      taskbarContainer.appendChild(btn);
    });
  }

  // Boot event listener from 3D stage
  window.addEventListener('xp:boot-desktop', (e: any) => {
    const desktop = document.getElementById('xp-desktop-container');
    if (desktop) {
      desktop.classList.remove('hidden');
      desktop.classList.add('flex');
    }
    
    if (e?.detail?.openFastTrack) {
      const fasttrack = document.getElementById('win-fasttrack');
      if (fasttrack) {
        fasttrack.classList.remove('hidden');
        fasttrack.style.display = 'flex';
        bringToFront(fasttrack);
      }
    } else {
      const welcome = document.getElementById('win-welcome');
      if (welcome) {
        welcome.classList.remove('hidden');
        welcome.style.display = 'flex';
        bringToFront(welcome);
      }
    }
    updateTaskbar();
  });

  // 2. Language Switcher (ID <-> EN)
  const savedLang = (typeof localStorage !== 'undefined' && localStorage.getItem('xp_porto_lang')) || 'en';
  let currentLang = savedLang;
  const langBtn = document.getElementById('lang-toggle-btn');

  function applyLanguage(lang: string) {
    currentLang = lang;
    try {
      localStorage.setItem('xp_porto_lang', lang);
    } catch (e) {}
    const elements = document.querySelectorAll<HTMLElement>('.i18n');
    elements.forEach(el => {
      const text = el.getAttribute(`data-${lang}`);
      if (text) el.innerHTML = text;
    });
    // Update input placeholders
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-en-placeholder],[data-id-placeholder]').forEach((el) => {
      const ph = el.getAttribute(`data-${lang}-placeholder`);
      if (ph) el.placeholder = ph;
    });
    document.documentElement.lang = lang;
    if (langBtn) {
      langBtn.innerHTML = lang.toUpperCase() === 'EN' ? 'EN &bull; ID' : 'ID &bull; EN';
    }
    // Update start button text
    const startSpan = document.querySelector('#xp-start-btn .i18n');
    if (startSpan) {
      startSpan.innerHTML = lang === 'id' ? 'mulai' : 'start';
    }
    // Update taskbar labels
    updateTaskbar();
    // Refresh Rover results if any
    try {
      if (typeof runRoverSearch === 'function' && roverInput && roverInput.value.trim()) {
        runRoverSearch();
      }
    } catch (e) {}
    // Refresh Recycle Bin labels
    try {
      if (typeof renderRecycleBin === 'function') {
        renderRecycleBin();
      }
    } catch (e) {}
  }

  (window as any).applyLanguage = applyLanguage;

  langBtn?.addEventListener('click', () => {
    const nextLang = currentLang === 'id' ? 'en' : 'id';
    applyLanguage(nextLang);
  });
  applyLanguage(savedLang);

  // 3. Start Menu Toggle
  const startBtn = document.getElementById('xp-start-btn');
  const startMenu = document.getElementById('xp-start-menu');

  startBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    startMenu?.classList.toggle('hidden');
    startMenu?.classList.toggle('flex');
  });

  document.addEventListener('click', (e) => {
    if (startMenu && !startMenu.contains(e.target as Node) && e.target !== startBtn) {
      startMenu.classList.add('hidden');
      startMenu.classList.remove('flex');
    }
  });

  // 3b. Keyboard Shortcuts
  document.addEventListener('keydown', (e) => {
    const isMeta = e.metaKey || e.key === 'Meta';
    const targetTag = (e.target as HTMLElement)?.tagName?.toLowerCase();
    const isTyping = targetTag === 'input' || targetTag === 'textarea';

    // Win+R open Run dialog
    if (isMeta && e.key.toLowerCase() === 'r') {
      e.preventDefault();
      (window as any).openWindow('win-run');
      return;
    }

    // Win key alone toggles Start Menu
    if (isMeta) {
      e.preventDefault();
      startMenu?.classList.toggle('hidden');
      startMenu?.classList.toggle('flex');
      return;
    }

    // F11 fullscreen
    if (e.key === 'F11') {
      e.preventDefault();
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
      return;
    }

    // Ctrl+L toggle language
    if (e.ctrlKey && e.key.toLowerCase() === 'l') {
      e.preventDefault();
      const nextLang = currentLang === 'id' ? 'en' : 'id';
      applyLanguage(nextLang);
      return;
    }

    // Arrow keys navigate gallery when gallery viewport is focused / hovered
    const galleryWin = document.getElementById('win-gallery');
    if (galleryWin && !galleryWin.classList.contains('hidden') && galleryWin.style.display !== 'none') {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        showCertificate(currentCertIndex - 1);
        return;
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        showCertificate(currentCertIndex + 1);
        return;
      }
    }

    // Global window shortcuts (only when not typing)
    if (isTyping) return;

    if (e.key === 'Escape') {
      // Close topmost visible window
      const topWin = getTopmostWindow();
      if (topWin) closeWindow(topWin);
      return;
    }

    if (e.key.toLowerCase() === 'm') {
      // Minimize topmost visible window
      const topWin = getTopmostWindow();
      if (topWin) minimizeWindow(topWin);
      return;
    }
  });

  function getTopmostWindow(): HTMLElement | null {
    let top: HTMLElement | null = null;
    let maxZ = 0;
    document.querySelectorAll<HTMLElement>('.xp-window').forEach((win) => {
      if (win.classList.contains('hidden') || win.style.display === 'none') return;
      const z = parseInt(window.getComputedStyle(win).zIndex || '0', 10);
      if (z > maxZ) {
        maxZ = z;
        top = win;
      }
    });
    return top;
  }

  // 4. System Tray Clock
  function updateClock() {
    const clockEl = document.getElementById('xp-clock');
    if (!clockEl) return;
    const now = new Date();
    let hours = now.getHours();
    const minutes = now.getMinutes().toString().padStart(2, '0');
    const ampm = hours >= 12 ? 'PM' : 'AM';
    hours = hours % 12 || 12;
    clockEl.innerText = `${hours}:${minutes} ${ampm}`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // Fast-track helper: open a specific project article inside IE reader
  (window as any).openArticleInIE = function(articleId: string) {
    openWindow('win-ie-reader');
    document.querySelectorAll('.ie-case-study-article').forEach((el) => el.classList.add('hidden'));
    const target = document.getElementById('ie-article-' + articleId);
    if (target) {
      target.classList.remove('hidden');
      const title = target.querySelector('h1')?.textContent || articleId;
      const addr = document.getElementById('ie-address-bar');
      if (addr) addr.textContent = 'C:\\CASE_STUDIES\\' + articleId.replace(/-/g, '_') + '.html';
    }
  };

  // Fast-track helper: open SDLC Lens pre-filtered to a feature
  (window as any).openSDLC = function(featureKey: string) {
    openWindow('win-sdlc');
    const sel = document.getElementById('sdlc-feature-select') as HTMLSelectElement | null;
    if (sel) {
      sel.value = featureKey;
      sel.dispatchEvent(new Event('change'));
    }
  };

  // Fast-track helper: open the Work Docs folder and highlight relevant dossiers
  (window as any).openDocsBatch = function(docKeys: string) {
    openWindow('win-docs-folder');
    setTimeout(() => {
      const keys = docKeys.split(',');
      keys.forEach((key) => {
        const card = document.querySelector('[data-doc-key="' + key + '"]') as HTMLElement | null;
        if (card) {
          card.classList.add('ring-2', 'ring-amber-400', 'ring-offset-1');
          setTimeout(() => card.classList.remove('ring-2', 'ring-amber-400', 'ring-offset-1'), 1800);
        }
      });
    }, 250);
  };

  // Subtle anime.js window-open animation (transform-only, preserves XP feel)
  function animateWindowOpen(win: HTMLElement) {
    try {
      if (typeof animate === 'undefined') return;
      animate(win, {
        opacity: [0, 1],
        scale: [0.96, 1],
        duration: 200,
        ease: 'outQuad',
      });
    } catch (_) {}
  }

  // Fast-track icon gentle pulse (amber glow every 2s)
  function startFastTrackPulse() {
    try {
      if (typeof animate === 'undefined') return;
      animate('.xp-desktop-icon[data-open="win-fasttrack"] > div', {
        boxShadow: [
          '0 0 0 0 rgba(245, 158, 11, 0.4)',
          '0 0 0 8px rgba(245, 158, 11, 0)',
        ],
        duration: 2000,
        loop: true,
        ease: 'inOutSine',
      });
    } catch (_) {}
  }

  // 5. Case Study Explorer -> Open in Internet Explorer 6 Window
  const projectRows = document.querySelectorAll('.xp-project-row');
  const ieAddressBar = document.getElementById('ie-address-bar');
  const ieTitlebar = document.getElementById('ie-titlebar-text');

  projectRows.forEach((row) => {
    row.addEventListener('click', () => {
      const projectId = row.getAttribute('data-project-id');
      if (!projectId) return;

      document.querySelectorAll('.ie-case-study-article').forEach(art => art.classList.add('hidden'));
      const targetArt = document.getElementById(`ie-article-${projectId}`);
      if (targetArt) {
