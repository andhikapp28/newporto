      img: `${document.getElementById('xp-desktop-container')?.dataset.baseUrl || ''}/certificates/certificate_8.jpg`
    }
  ];

  let currentCertIndex = 0;

  function showCertificate(idx: number) {
    if (idx < 0) idx = certsList.length - 1;
    if (idx >= certsList.length) idx = 0;
    currentCertIndex = idx;
    const cert = certsList[idx];

    const imgEl = document.getElementById('gallery-main-img') as HTMLImageElement;
    const titleEl = document.getElementById('gallery-cert-title');
    const issuerEl = document.getElementById('gallery-cert-issuer');
    const noEl = document.getElementById('gallery-cert-no');
    const counterEl = document.getElementById('gallery-counter');
    const dlLink = document.getElementById('gallery-cert-dl') as HTMLAnchorElement;

    if (imgEl) imgEl.src = cert.img;
    if (titleEl) titleEl.innerText = cert.title;
    if (issuerEl) issuerEl.innerText = `Penerbit: ${cert.issuer} • Tanggal: ${cert.date}`;
    if (noEl) noEl.innerText = `No: ${cert.certNo}`;
    if (counterEl) counterEl.innerText = `${idx + 1} / ${certsList.length}`;
    if (dlLink) dlLink.href = cert.img;

    document.querySelectorAll('.cert-thumb-card').forEach((card, cIdx) => {
      if (cIdx === idx) {
        card.classList.add('border-blue-600', 'ring-2', 'ring-blue-400');
      } else {
        card.classList.remove('border-blue-600', 'ring-2', 'ring-blue-400');
