---

<div 
  id="xp-desktop-container" class="fixed inset-0 z-30 w-full h-full h-screen h-[100dvh] hidden flex-col select-none overflow-hidden font-sans"
  style={`background-image: url('${blissImg}'); background-size: cover; background-position: center; background-repeat: no-repeat;`}
  data-base-url={base}
>
  <!-- Desktop Workspace Area -->
  <div id="xp-desktop-space" class="relative flex-1 w-full h-[calc(100vh-30px)] h-[calc(100dvh-30px)] overflow-hidden">

    <!-- Desktop Icons (Left Column, Classic Windows XP Style - All Aligned to the Left) -->
    <div id="xp-desktop-icons-grid" class="relative z-10 p-2 sm:p-2.5 flex flex-col gap-1 sm:gap-1.5 w-24 items-start pointer-events-auto select-none">
      <!-- Custom desktop icon tooltip -->
      <div id="xp-icon-tooltip" class="fixed z-[10001] hidden pointer-events-none max-w-[220px]">
        <div class="px-2 py-1.5 rounded border border-[#0a246a] bg-[#ffffe1] text-slate-900 shadow-lg text-[11px]">
          <div id="xp-icon-tooltip-title" class="font-bold"></div>
          <div id="xp-icon-tooltip-desc" class="text-slate-700 leading-tight mt-0.5"></div>
        </div>
      </div>

      <!-- Icon 0: Executive_Summary.exe (Recruiter Fast-Track) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-amber-600/30 active:bg-amber-600/50 relative"
           data-open="win-fasttrack"
           title="Executive_Summary.exe"
           data-tooltip-title="Executive_Summary.exe (⚡ Recruiter Fast-Track)"
           data-tooltip-desc="⚡ Jalur Cepat Recruiter: Metrik kepemimpinan, 40+ sistem, 14d -> <48h speedup, dan kapabilitas 3-in-1. | ⚡ Recruiter Fast-Track: Leadership metrics, 40+ systems, 14d -> <48h speedup, and 3-in-1 capability.">
