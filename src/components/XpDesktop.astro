  <!-- Shutdown Message Screen -->
  <div id="xp-shutdown-screen" class="fixed inset-0 z-[25000] bg-[#001333] hidden flex-col items-center justify-center select-none">
    <div class="flex items-center gap-3.5 mb-4">
      <svg class="w-10 h-10" viewBox="0 0 24 24">
        <rect x="2" y="2" width="9" height="9" fill="#f44336" rx="1" />
        <rect x="13" y="2" width="9" height="9" fill="#4caf50" rx="1" />
        <rect x="2" y="13" width="9" height="9" fill="#2196f3" rx="1" />
        <rect x="13" y="13" width="9" height="9" fill="#ffeb3b" rx="1" />
      </svg>
      <div class="text-2xl font-bold text-white tracking-tight">
        Windows<span class="text-amber-500 italic font-black">xp</span>
      </div>
    </div>
    <div class="text-sm font-sans text-slate-300 tracking-wider i18n" data-en="Windows is shutting down..." data-id="Windows sedang dimatikan...">
      Windows is shutting down...
    </div>
  </div>

  <!-- ==================== WINDOWS XP START MENU ==================== -->
  <div
    id="xp-start-menu"
    class="absolute bottom-[30px] left-0 w-80 rounded-t-lg bg-white border-2 border-[#0055ea] shadow-2xl z-[10000] flex-col overflow-hidden hidden"
  >
    <div class="h-12 px-3 flex items-center gap-3 bg-gradient-to-r from-[#0058ee] to-[#3593ff] text-white shadow-inner">
      <div class="w-8 h-8 rounded bg-white p-0.5 border border-white shadow">
