      <div class="w-[1px] h-4 bg-white/40"></div>
      <button
        id="xp-open-shutdown-btn"
        class="flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-[#c75050] hover:bg-[#e04343] border border-white/50 text-xs font-bold shadow cursor-pointer active:scale-95"
      >
        <Power class="w-3 h-3" />
        <span class="i18n" data-en="Turn Off Computer" data-id="Matikan Komputer">Turn Off Computer</span>
      </button>
    </div>
  </div>

  <!-- ==================== TASKBAR ==================== -->
  <div 
    id="xp-taskbar" 
    class="fixed bottom-0 left-0 right-0 z-[9999] h-[30px] w-full bg-gradient-to-b from-[#245edb] via-[#3f8cf3] to-[#1941a5] border-t border-[#468df2] flex items-center justify-between select-none shadow-lg shrink-0"
  >
    <div class="flex items-center h-full">
      <button
        id="xp-start-btn"
        class="h-full px-3.5 rounded-r-xl bg-gradient-to-b from-[#388e3c] via-[#4caf50] to-[#2e7d32] hover:brightness-110 active:brightness-90 border-r border-[#1b5e20] shadow-[inset_1px_1px_1px_rgba(255,255,255,0.7)] flex items-center gap-1.5 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 drop-shadow" viewBox="0 0 24 24">
          <rect x="2" y="2" width="9" height="9" fill="#f44336" rx="1" />
          <rect x="13" y="2" width="9" height="9" fill="#4caf50" rx="1" />
          <rect x="2" y="13" width="9" height="9" fill="#2196f3" rx="1" />
          <rect x="13" y="13" width="9" height="9" fill="#ffeb3b" rx="1" />
        </svg>
        <span id="xp-start-text" class="font-black italic text-white text-xs drop-shadow-[1px_1px_2px_rgba(0,0,0,0.8)] i18n" data-en="start" data-id="mulai">start</span>
      </button>

      <div id="xp-taskbar-items" class="flex items-center gap-1 px-1.5 h-full overflow-x-auto">
      </div>
    </div>

    <div id="xp-tray-area" class="h-full px-2.5 bg-gradient-to-b from-[#0f388a] via-[#16439e] to-[#0d2f78] border-l border-[#194bb5] shadow-inner flex items-center gap-2.5 text-xs text-white font-mono">
      <button 
        id="lang-toggle-btn"
        class="px-1.5 py-0.5 rounded bg-blue-950/80 border border-blue-400/40 text-[10px] font-bold text-amber-300 hover:bg-blue-900 cursor-pointer"
        title="Switch Language (EN / ID)"
      >
        EN &bull; ID
      </button>

      <div class="relative flex items-center gap-1">
        <button id="xp-volume-btn" class="p-0.5 rounded hover:bg-blue-900 cursor-pointer flex items-center justify-center" title="Volume">
          <svg id="xp-volume-icon" class="w-3 h-3 text-blue-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path id="xp-volume-wave" d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
        </button>
        <div id="xp-volume-popup" class="hidden absolute bottom-7 right-0 w-32 bg-[#ece9d8] border border-[#7f9db9] rounded shadow-lg p-2 z-[100000]">
          <div class="text-[10px] font-bold text-slate-700 mb-1">Volume</div>
          <input 
            id="xp-volume-slider" 
            type="range" 
            min="0" 
            max="100" 
            value="85" 
            class="w-full h-1.5 bg-[#9bb0d6] rounded-lg appearance-none cursor-pointer accent-blue-700"
          />
          <div class="text-[10px] text-right text-slate-600 mt-0.5" id="xp-volume-value">85%</div>
        </div>
      </div>

      <button 
        id="xp-tray-shutdown-btn" 
        class="p-0.5 rounded hover:bg-red-600/80 cursor-pointer flex items-center justify-center text-red-200 hover:text-white"
        title="Turn Off Computer / Matikan Komputer"
      >
        <Power class="w-3.5 h-3.5" />
      </button>

      <span id="xp-clock" class="text-[11px]">12:00 PM</span>
