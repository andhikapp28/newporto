      </div>

      <div class="flex-1 p-5 bg-white overflow-y-auto max-h-[64vh] text-slate-900 leading-relaxed font-sans text-xs">
        <div class="border-b-2 border-blue-600 pb-3 mb-3.5">
          <div class="text-[10px] font-mono uppercase tracking-widest text-blue-700 font-bold i18n" data-en="SYSTEM ANALYST &bull; SOLUTION ARCHITECT &bull; DEV/QA" data-id="SYSTEM ANALYST &bull; SOLUTION ARCHITECT &bull; DEV/QA">
            SYSTEM ANALYST &bull; SOLUTION ARCHITECT &bull; DEV/QA
