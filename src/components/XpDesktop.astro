  function updateTaskmgrApps() {
    if (!taskmgrAppRows) return;
    const wins = Array.from(document.querySelectorAll<HTMLElement>('.xp-window'))
      .filter(w => !w.classList.contains('hidden') && w.style.display !== 'none' && w.id !== 'win-taskmgr');

    if (wins.length === 0) {
      taskmgrAppRows.innerHTML = `<tr><td colspan="2" class="p-3 text-slate-400 italic i18n" data-en="No other applications are running." data-id="Tidak ada aplikasi lain yang aktif.">No other applications are running.</td></tr>`;
      selectedTaskmgrWinId = '';
      return;
    }

    taskmgrAppRows.innerHTML = wins.map(w => {
      const title = w.querySelector('.xp-titlebar span')?.textContent || w.id;
      const isSel = w.id === selectedTaskmgrWinId;
      return `
        <tr class="cursor-pointer hover:bg-blue-100 ${isSel ? 'bg-[#316ac5] text-white hover:bg-[#316ac5]' : 'text-slate-800'}" data-win-id="${w.id}">
          <td class="p-1.5 flex items-center gap-1.5 border-r border-[#7f9db9] truncate">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500 shrink-0 inline-block"></span>
            <span class="truncate font-semibold">${title}</span>
          </td>
          <td class="p-1.5 text-emerald-600 font-bold ${isSel ? 'text-emerald-200' : ''}">Running</td>
        </tr>
      `;
    }).join('');

    taskmgrAppRows.querySelectorAll('tr').forEach(tr => {
      tr.addEventListener('click', () => {
        selectedTaskmgrWinId = tr.getAttribute('data-win-id') || '';
        updateTaskmgrApps();
      });
      tr.addEventListener('dblclick', () => {
        const wid = tr.getAttribute('data-win-id');
        if (wid) (window as any).openWindow(wid);
      });
    });
  }
  (window as any).updateTaskmgrApps = updateTaskmgrApps;

  taskmgrBtnEnd?.addEventListener('click', () => {
    if (!selectedTaskmgrWinId) return;
    const win = document.getElementById(selectedTaskmgrWinId);
    if (win) {
      closeWindow(win);
      playXpSound('click');
      selectedTaskmgrWinId = '';
      updateTaskmgrApps();
