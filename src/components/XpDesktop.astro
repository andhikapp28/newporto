    document.querySelectorAll<HTMLElement>('.xp-window').forEach((win) => {
      if (win.classList.contains('hidden') || win.style.display === 'none') return;
      const z = parseInt(window.getComputedStyle(win).zIndex || '0', 10);
      if (z > maxZ) {
