<script>
  // 1. Listen for boot event from 3D computer stage
  window.addEventListener('xp:boot-desktop', () => {
    const desktop = document.getElementById('xp-desktop-container');
    if (desktop) {
      desktop.classList.remove('hidden');
      desktop.classList.add('flex');
    }
  });

  // 2. Start Menu Toggle
  const startBtn = document.getElementById('xp-start-btn');
  const startMenu = document.getElementById('xp-start-menu');

  startBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    startMenu?.classList.toggle('hidden');
    startMenu?.classList.toggle('flex');
  });

  document.addEventListener('click', (e) => {
    if (startMenu && !startMenu.contains(e.target as Node) && e.target !== startBtn) {
      startMenu.classList.add('hidden');
      startMenu.classList.remove('flex');
    }
  });

  // 3. System Tray Clock
  function updateClock() {
    const clockEl = document.getElementById('xp-clock');
    if (!clockEl) return;
    const now = new Date();
    let hours = now.getHours();
    const minutes = now.getMinutes().toString().padStart(2, '0');
    const ampm = hours >= 12 ? 'PM' : 'AM';
    hours = hours % 12 || 12;
    clockEl.innerText = `${hours}:${minutes} ${ampm}`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // 4. Draggable Windows Logic & Active Z-Index
  let highestZIndex = 30;

  function bringToFront(win: HTMLElement) {
    highestZIndex += 1;
    win.style.zIndex = highestZIndex.toString();
  }

  const windows = document.querySelectorAll<HTMLElement>('.xp-window');
  windows.forEach((win) => {
    win.addEventListener('mousedown', () => bringToFront(win));

    const titlebar = win.querySelector<HTMLElement>('.xp-titlebar');
    if (titlebar) {
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let initialLeft = 0;
      let initialTop = 0;

      titlebar.addEventListener('mousedown', (e) => {
        isDragging = true;
        bringToFront(win);
        startX = e.clientX;
        startY = e.clientY;
        initialLeft = win.offsetLeft;
        initialTop = win.offsetTop;

        function onMouseMove(moveEvent: MouseEvent) {
          if (!isDragging) return;
          const dx = moveEvent.clientX - startX;
          const dy = moveEvent.clientY - startY;
          win.style.left = `${Math.max(0, initialLeft + dx)}px`;
          win.style.top = `${Math.max(0, initialTop + dy)}px`;
        }

        function onMouseUp() {
          isDragging = false;
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
        }

        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      });
    }

    // Window controls
    const btnClose = win.querySelector('.win-btn-close');
    btnClose?.addEventListener('click', () => {
      win.style.display = 'none';
      updateTaskbar();
    });

    const btnMinimize = win.querySelector('.win-btn-minimize');
    btnMinimize?.addEventListener('click', () => {
      win.style.display = 'none';
      updateTaskbar();
    });

    const btnMaximize = win.querySelector('.win-btn-maximize');
    btnMaximize?.addEventListener('click', () => {
      if (win.dataset.maximized === 'true') {
        win.style.width = win.dataset.prevWidth || '580px';
        win.style.height = win.dataset.prevHeight || 'auto';
        win.style.top = win.dataset.prevTop || '60px';
        win.style.left = win.dataset.prevLeft || '80px';
        win.dataset.maximized = 'false';
      } else {
        win.dataset.prevWidth = win.style.width || `${win.offsetWidth}px`;
        win.dataset.prevHeight = win.style.height || `${win.offsetHeight}px`;
        win.dataset.prevTop = `${win.offsetTop}px`;
        win.dataset.prevLeft = `${win.offsetLeft}px`;
        win.style.width = '100vw';
        win.style.height = 'calc(100vh - 36px)';
        win.style.top = '0px';
        win.style.left = '0px';
        win.dataset.maximized = 'true';
      }
    });
  });

  // 5. Desktop Icons Opening Windows
  const desktopIcons = document.querySelectorAll('.xp-desktop-icon');
  desktopIcons.forEach((icon) => {
    icon.addEventListener('click', () => {
      const targetId = icon.getAttribute('data-open');
      if (targetId) {
        const targetWin = document.getElementById(targetId);
        if (targetWin) {
          targetWin.style.display = 'flex';
          bringToFront(targetWin);
          updateTaskbar();
        }
      }
    });
  });

  // 6. Update Taskbar open window items
  function updateTaskbar() {
    const taskbarContainer = document.getElementById('xp-taskbar-items');
    if (!taskbarContainer) return;
    taskbarContainer.innerHTML = '';

    windows.forEach((win) => {
      const isVisible = win.style.display !== 'none';
      const title = win.querySelector('.xp-titlebar span')?.textContent || 'Window';
      const id = win.id;

      const btn = document.createElement('button');
      btn.className = `h-7 px-3 rounded text-xs font-bold flex items-center gap-1.5 cursor-pointer max-w-[150px] truncate shadow-inner ${
        isVisible
          ? 'bg-[#1b3f94] text-white border border-[#0d2358]'
          : 'bg-[#2c7cfc]/40 hover:bg-[#2c7cfc]/70 text-blue-100 border border-blue-400/30'
      }`;
      btn.innerText = title.split(' - ')[0];

      btn.addEventListener('click', () => {
        if (win.style.display === 'none') {
          win.style.display = 'flex';
          bringToFront(win);
        } else {
          // Toggle minimize
          win.style.display = 'none';
        }
        updateTaskbar();
      });

      taskbarContainer.appendChild(btn);
    });
  }
  updateTaskbar();

  // 7. Interactive SDLC Switcher inside Windows XP
  const sdlcTabs = document.querySelectorAll('.xp-lens-tab');
  sdlcTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const view = tab.getAttribute('data-view');
      sdlcTabs.forEach((t) => {
        t.classList.remove('active', 'bg-white', 'border-t-2', 'border-l-2', 'border-r-2', 'text-blue-900');
        t.classList.add('bg-[#ece9d8]', 'text-slate-600');
      });
      tab.classList.add('active', 'bg-white', 'border-t-2', 'border-l-2', 'border-r-2', 'text-blue-900');
      tab.classList.remove('bg-[#ece9d8]', 'text-slate-600');

      document.getElementById('xp-view-analyst')?.classList.add('hidden');
      document.getElementById('xp-view-dev')?.classList.add('hidden');
      document.getElementById('xp-view-qa')?.classList.add('hidden');

      if (view === 'analyst') document.getElementById('xp-view-analyst')?.classList.remove('hidden');
      if (view === 'dev') document.getElementById('xp-view-dev')?.classList.remove('hidden');
      if (view === 'qa') document.getElementById('xp-view-qa')?.classList.remove('hidden');
    });
  });

  // 8. Interactive Architecture Node Flow inside Windows XP
  const flowButtons = document.querySelectorAll('.xp-flow-btn');
  const flowDetails = document.getElementById('xp-flow-details');

  const nodeDescriptions: Record<string, { title: string; sla: string; req: string; dev: string; qa: string }> = {
    client: {
      title: "Node 01: Client POS / Terminal",
      sla: "P99 UI Latency <100ms",
      req: "Offline-first local storage (SQLite/IndexedDB) allowing transactions to proceed during network partition.",
      dev: "Payload compression (gzip) for bulk batches; client-side UUIDv4 idempotency key attached to every button click.",
      qa: "Simulate airplane mode during checkout submission: assert zero data loss and background queue retry."
    },
    gateway: {
      title: "Node 02: API Gateway & Reverse Proxy",
      sla: "15,000 req/sec | Latency <5ms",
      req: "Strict rate limiting (100 req/min/IP) and mTLS/HMAC validation on third-party webhook payloads.",
      dev: "Redis token bucket rate limiter; correlation-id forwarding to all downstream microservices.",
      qa: "Assert HTTP 429 Too Many Requests with Retry-After header once rate threshold is crossed."
    },
    service: {
      title: "Node 03: Core Engine & State Machine",
      sla: "TAT <120ms | 99.95% SLA",
      req: "Deterministic finite state machine: DRAFT -> RESERVED -> CHARGED -> FULFILLED with 5-minute stock hold TTL.",
      dev: "Redis distributed locking (Redlock) on SKU ID + PostgreSQL row-level locks (FOR UPDATE).",
      qa: "Assert simultaneous requests with same Idempotency-Key return identical cached response body without duplicate charge."
    },
    queue: {
      title: "Node 04: Message Queue (RabbitMQ)",
      sla: "Delivery Guarantee: At-least-once",
      req: "Decouples synchronous checkout responses from slow notification dispatch and ERP syncing.",
      dev: "Dead Letter Queue (DLQ) retry policy with exponential backoff for poison-pill payloads.",
      qa: "Simulate consumer service crash midway through processing: verify message is re-queued without drop."
    },
    database: {
      title: "Node 05: Database (PostgreSQL + Redis)",
      sla: "Zero Data Loss (RPO = 0)",
      req: "3NF normalized schema with soft-delete audit history on all financial transactions.",
      dev: "Master-Slave cluster with read-write splitting and connection pooling via PgBouncer.",
      qa: "Assert simultaneous debit transactions respect ACID Serializable isolation without deadlocks."
    }
  };

  function renderFlowDetail(key: string) {
    if (!flowDetails) return;
    const d = nodeDescriptions[key] || nodeDescriptions.client;
    flowDetails.innerHTML = `
      <div class="p-3 bg-blue-50 border border-blue-200 rounded">
        <div class="flex items-center justify-between">
          <span class="font-bold text-blue-900 text-sm">${d.title}</span>
          <span class="font-mono text-[11px] text-emerald-700 font-bold">${d.sla}</span>
        </div>
      </div>
      <div class="space-y-2">
        <div class="p-2.5 rounded bg-slate-50 border border-slate-200">
          <strong class="text-blue-800 block mb-0.5">Analyst Requirement:</strong>
          <span class="text-slate-700">${d.req}</span>
        </div>
        <div class="p-2.5 rounded bg-slate-50 border border-slate-200">
          <strong class="text-indigo-800 block mb-0.5">Developer Implementation:</strong>
          <span class="text-slate-700">${d.dev}</span>
        </div>
        <div class="p-2.5 rounded bg-slate-50 border border-slate-200">
          <strong class="text-emerald-800 block mb-0.5">QA Edge-Case Assertion:</strong>
          <span class="text-slate-700">${d.qa}</span>
        </div>
      </div>
    `;
  }
  renderFlowDetail('client');

  flowButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const nodeKey = btn.getAttribute('data-node') || 'client';
      flowButtons.forEach((b) => {
        b.classList.remove('active', 'bg-white', 'text-blue-900', 'font-semibold');
        b.classList.add('bg-[#ece9d8]', 'text-slate-700');
      });
      btn.classList.add('active', 'bg-white', 'text-blue-900', 'font-semibold');
      btn.classList.remove('bg-[#ece9d8]', 'text-slate-700');
      renderFlowDetail(nodeKey);
    });
  });

  // 9. Command Prompt (cmd.exe) Interactive CLI
  const cmdInput = document.getElementById('cmd-input') as HTMLInputElement;
  const cmdOutput = document.getElementById('cmd-output');
  const cmdScreen = document.getElementById('cmd-screen');

  cmdInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const val = cmdInput.value.trim().toLowerCase();
      if (!val) return;

      const line = document.createElement('div');
      line.innerHTML = `<span class="text-slate-400">C:\\Users\\SystemAnalyst&gt;</span> <span class="text-white">${cmdInput.value}</span>`;
      cmdOutput?.appendChild(line);

      const resp = document.createElement('div');
      resp.className = 'text-emerald-300 pl-2';

      if (val === 'help') {
        resp.innerHTML = `
          Commands available:<br/>
          &bull; <span class="text-yellow-300">skills</span>   - List System Analyst, Dev & QA matrix<br/>
          &bull; <span class="text-yellow-300">projects</span> - View active architecture case studies<br/>
          &bull; <span class="text-yellow-300">contact</span>  - Show email and direct communication channels<br/>
          &bull; <span class="text-yellow-300">matrix</span>   - Launch SDLC Lens perspective<br/>
          &bull; <span class="text-yellow-300">clear</span>    - Clear the command prompt
        `;
      } else if (val === 'skills') {
        resp.innerHTML = `
          [CORE SA]: BRD/SRS, BPMN 2.0, ERD 3NF Modeling, OpenAPI 3.1<br/>
          [DEV FEASIBILITY]: PostgreSQL, SQL Tuning, REST APIs, Redis Redlock<br/>
          [QA RIGOR]: BDD Gherkin, Postman Automation, Chaos Fault Injection
        `;
      } else if (val === 'projects') {
        resp.innerHTML = `
          1. Omnichannel POS & Real-Time Sync (Discrepancy: 0.01%)<br/>
          2. Automated Loan Scoring Engine (Approval TAT: 45s)<br/>
          3. Hospital E-Prescription ERP (Dispensing Errors: 0)
        `;
      } else if (val === 'contact') {
        resp.innerHTML = `
          Email: analyst.dipa@example.com<br/>
          Status: Available for Fulltime & Strategic Architecture Projects
        `;
      } else if (val === 'matrix') {
        document.querySelector<HTMLElement>('[data-open="win-sdlc"]')?.click();
        resp.innerText = 'Launching SDLC_Lens.exe...';
      } else if (val === 'clear') {
        if (cmdOutput) cmdOutput.innerHTML = '';
        cmdInput.value = '';
        return;
      } else {
        resp.innerHTML = `'${val}' is not recognized as an internal or external command. Type 'help'.`;
      }

      cmdOutput?.appendChild(resp);
      cmdInput.value = '';
      if (cmdScreen) cmdScreen.scrollTop = cmdScreen.scrollHeight;
    }
  });

  // 10. Copy Email in Outlook Express
  const copyBtn = document.getElementById('xp-copy-email-btn');
  const copyIcon = document.getElementById('xp-copy-icon');
  const copiedIcon = document.getElementById('xp-copied-icon');
  const copyText = document.getElementById('xp-copy-text');

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText('analyst.dipa@example.com').then(() => {
      copyIcon?.classList.add('hidden');
      copiedIcon?.classList.remove('hidden');
      if (copyText) copyText.innerText = 'Copied!';
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        copiedIcon?.classList.add('hidden');
        if (copyText) copyText.innerText = 'Copy Address';
      }, 2000);
    });
  });

  // 11. Shut down button back to 3D computer stage
  const shutdownBtn = document.getElementById('xp-shutdown-btn');
  shutdownBtn?.addEventListener('click', () => {
    const confirmShutdown = confirm('Are you sure you want to shut down and return to the 3D Workstation?');
    if (confirmShutdown) {
      const desktop = document.getElementById('xp-desktop-container');
      if (desktop) {
        desktop.classList.add('hidden');
        desktop.classList.remove('flex');
      }
      startMenu?.classList.add('hidden');
      window.dispatchEvent(new CustomEvent('xp:shutdown-to-3d'));
    }
  });
</script>
