---
import { getCollection, render } from 'astro:content';
import { 
  FileText, 
  Folder, 
  Terminal, 
  Mail, 
  X, 
  Minus, 
  Square, 
  Layers, 
  Network, 
  Workflow, 
  ShieldCheck, 
  Code2, 
  Power, 
  Volume2, 
  VolumeX, 
  ExternalLink,
  Copy,
  Check,
  Globe,
  ArrowLeft,
  ArrowRight,
  RotateCw,
  Home,
  FileSpreadsheet,
  CheckCircle2
} from '@lucide/astro';

const allProjects = await getCollection('projects');

// Render markdown content for each project to embed in IE6 reader
const renderedProjects = await Promise.all(
  allProjects.map(async (p) => {
    const { Content } = await render(p);
    return {
      id: p.id,
      data: p.data,
      Content
    };
  })
);
---

<div 
  id="xp-desktop-container" 
  class="fixed inset-0 z-30 w-screen h-screen hidden flex-col select-none overflow-hidden font-sans"
  style="background-image: url('/images/bliss.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat;"
>
  <!-- Desktop Workspace Area (Occupies full height minus taskbar) -->
  <div id="xp-desktop-space" class="relative flex-1 w-full h-[calc(100vh-30px)] overflow-hidden">

    <!-- Desktop Icons Grid (Left column) -->
    <div class="relative z-10 p-4 grid grid-flow-col grid-rows-6 gap-y-3.5 gap-x-6 w-max pointer-events-auto">
      <!-- Icon 1: Welcome_SA.doc -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-welcome">
        <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-white/95 border border-slate-300 shadow-md group-hover:scale-105 transition-transform">
          <FileText class="w-7 h-7 text-blue-600" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1">
          Welcome_SA.doc
        </span>
      </div>

      <!-- Icon 2: C:\Case_Studies -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-projects">
        <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-amber-100 border border-amber-300 shadow-md group-hover:scale-105 transition-transform">
          <Folder class="w-7 h-7 text-amber-500 fill-amber-400" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1">
          Case_Studies
        </span>
      </div>

      <!-- Icon 3: SDLC_Lens.exe -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-sdlc">
        <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-slate-900 border border-cyan-400 shadow-md group-hover:scale-105 transition-transform">
          <Layers class="w-6 h-6 text-cyan-400" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1">
          SDLC_Lens.exe
        </span>
      </div>

      <!-- Icon 4: System_Flow.exe -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-flow">
        <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-indigo-950 border border-indigo-400 shadow-md group-hover:scale-105 transition-transform">
          <Network class="w-6 h-6 text-indigo-300" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1">
          System_Flow.exe
        </span>
      </div>

      <!-- Icon 5: cmd.exe -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-cmd">
        <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-black border border-slate-600 shadow-md group-hover:scale-105 transition-transform">
          <Terminal class="w-6 h-6 text-emerald-400" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1">
          cmd.exe
        </span>
      </div>

      <!-- Icon 6: Outlook Express -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-contact">
        <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-sky-100 border border-sky-400 shadow-md group-hover:scale-105 transition-transform">
          <Mail class="w-6 h-6 text-sky-600" />
        </div>
        <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.95)] font-semibold leading-tight px-1">
          Outlook_Express
        </span>
      </div>
    </div>

    <!-- ==================== DRAGGABLE WINDOWS ==================== -->

    <!-- WINDOW 1: Welcome_SA.doc (WordPad) -->
    <div
      id="win-welcome"
      class="xp-window absolute top-8 left-28 w-[92vw] sm:w-[560px] rounded-t-lg shadow-2xl border-[3px] border-[#0055ea] bg-[#ece9d8] text-slate-800 z-20 flex flex-col overflow-hidden"
      style="display: flex;"
    >
      <div class="xp-titlebar h-7 px-2 flex items-center justify-between cursor-move select-none bg-gradient-to-r from-[#0058ee] via-[#3593ff] to-[#0058ee] text-white shadow-inner">
        <div class="flex items-center gap-2 font-bold text-xs tracking-wide drop-shadow-[1px_1px_1px_rgba(0,0,0,0.7)] truncate">
          <FileText class="w-3.5 h-3.5 text-blue-200 shrink-0" />
          <span>Welcome_SA.doc - Microsoft WordPad</span>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button class="win-btn-minimize w-5 h-4.5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/70 flex items-center justify-center text-white font-bold" title="Minimize"><Minus class="w-2.5 h-2.5" /></button>
          <button class="win-btn-maximize w-5 h-4.5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/70 flex items-center justify-center text-white font-bold" title="Maximize"><Square class="w-2 h-2" /></button>
          <button class="win-btn-close w-5 h-4.5 rounded bg-[#e81123] hover:bg-[#f63847] border border-white/70 flex items-center justify-center text-white font-bold" title="Close"><X class="w-2.5 h-2.5" /></button>
        </div>
      </div>

      <div class="h-6 px-2 flex items-center gap-3 text-[11px] bg-[#ece9d8] border-b border-[#d8d4c2] text-slate-700">
        <span class="hover:underline cursor-pointer">File</span>
        <span class="hover:underline cursor-pointer">Edit</span>
        <span class="hover:underline cursor-pointer">View</span>
        <span class="hover:underline cursor-pointer">Insert</span>
        <span class="hover:underline cursor-pointer">Format</span>
        <span class="hover:underline cursor-pointer">Help</span>
      </div>

      <div class="p-5 bg-white overflow-y-auto max-h-[64vh] text-slate-800 leading-relaxed font-sans text-xs">
        <div class="border-b-2 border-blue-600 pb-3 mb-3">
          <div class="text-[10px] font-mono uppercase tracking-widest text-blue-700 font-bold">
            EXECUTIVE ARCHITECTURE BRIEF
          </div>
          <h2 class="text-lg sm:text-xl font-black text-slate-900 mt-1 leading-tight">
            System Analyst &bull; Dev Feasibility &bull; QA Rigor
          </h2>
          <div class="text-[11px] text-slate-500 mt-0.5">
            Bridging Business Requirements, Engineering Execution &amp; Defect Prevention
          </div>
        </div>

        <p class="text-slate-700 mb-3.5">
          Welcome to my workspace. Unlike theoretical analysts, my system designs are grounded in <strong>direct engineering feasibility</strong> (API idempotency, database indexing, latency budgets) and validated through <strong>defensive QA test suites</strong> (Gherkin BDD, boundary assertions, failure fallbacks).
        </p>

        <!-- 3-Pillar Capability Matrix Preview -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 my-3.5">
          <div class="p-2.5 rounded border border-blue-200 bg-blue-50/70">
            <div class="font-bold text-[11px] text-blue-900 mb-1 flex items-center gap-1.5">
              <Workflow class="w-3.5 h-3.5 text-blue-600" />
              <span>1. Analysis (Core)</span>
            </div>
            <p class="text-[10.5px] text-slate-600 leading-tight">
              BRD/SRS, BPMN 2.0 swimlanes, 3NF ERD modeling, and OpenAPI 3.1.
            </p>
          </div>

          <div class="p-2.5 rounded border border-indigo-200 bg-indigo-50/70">
            <div class="font-bold text-[11px] text-indigo-900 mb-1 flex items-center gap-1.5">
              <Code2 class="w-3.5 h-3.5 text-indigo-600" />
              <span>2. Dev Feasibility</span>
            </div>
            <p class="text-[10.5px] text-slate-600 leading-tight">
              SQL optimization, distributed locking (Redis Redlock), REST APIs.
            </p>
          </div>

          <div class="p-2.5 rounded border border-emerald-200 bg-emerald-50/70">
            <div class="font-bold text-[11px] text-emerald-900 mb-1 flex items-center gap-1.5">
              <ShieldCheck class="w-3.5 h-3.5 text-emerald-600" />
              <span>3. QA Rigor</span>
            </div>
            <p class="text-[10.5px] text-slate-600 leading-tight">
              BDD Given/When/Then, Postman automated tests &amp; edge cases.
            </p>
          </div>
        </div>

        <div class="pt-3 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-2">
            <button
              class="px-3 py-1 rounded text-xs font-semibold bg-[#ece9d8] border border-[#7f9db9] shadow-sm hover:bg-[#f7f5ec] active:bg-[#e0dccb] cursor-pointer"
              onclick="document.querySelector('[data-open=\'win-projects\']').click()"
            >
              Open Case Studies &rarr;
            </button>
            <button
              class="px-3 py-1 rounded text-xs font-semibold bg-[#ece9d8] border border-[#7f9db9] shadow-sm hover:bg-[#f7f5ec] active:bg-[#e0dccb] cursor-pointer"
              onclick="document.querySelector('[data-open=\'win-sdlc\']').click()"
            >
              Launch SDLC Switcher
            </button>
          </div>

          <span class="text-[10.5px] font-mono text-emerald-700 font-bold">
            &bull; Available for Roles
          </span>
        </div>
      </div>
    </div>

    <!-- WINDOW 2: Case Studies (Windows Explorer) -->
    <div
      id="win-projects"
      class="xp-window absolute top-14 left-44 w-[92vw] sm:w-[640px] rounded-t-lg shadow-2xl border-[3px] border-[#0055ea] bg-[#ece9d8] text-slate-800 z-10 flex flex-col overflow-hidden hidden"
    >
      <div class="xp-titlebar h-7 px-2 flex items-center justify-between cursor-move select-none bg-gradient-to-r from-[#0058ee] via-[#3593ff] to-[#0058ee] text-white shadow-inner">
        <div class="flex items-center gap-2 font-bold text-xs tracking-wide drop-shadow-[1px_1px_1px_rgba(0,0,0,0.7)] truncate">
          <Folder class="w-3.5 h-3.5 text-amber-300 fill-amber-300 shrink-0" />
          <span>C:\System_Projects\ - Windows Explorer</span>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button class="win-btn-minimize w-5 h-4.5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/70 flex items-center justify-center text-white font-bold"><Minus class="w-2.5 h-2.5" /></button>
          <button class="win-btn-maximize w-5 h-4.5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/70 flex items-center justify-center text-white font-bold"><Square class="w-2 h-2" /></button>
          <button class="win-btn-close w-5 h-4.5 rounded bg-[#e81123] hover:bg-[#f63847] border border-white/70 flex items-center justify-center text-white font-bold"><X class="w-2.5 h-2.5" /></button>
        </div>
      </div>

      <!-- Address Bar -->
      <div class="h-7 px-2 flex items-center gap-2 text-xs bg-[#ece9d8] border-b border-[#d8d4c2]">
        <span class="text-slate-600 font-medium">Address:</span>
        <div class="flex-1 px-2 py-0.5 bg-white border border-[#7f9db9] rounded-sm text-xs font-mono text-slate-800 flex items-center">
          C:\System_Projects\Case_Studies\
        </div>
      </div>

      <!-- Explorer Content Table -->
      <div class="bg-white overflow-y-auto max-h-[62vh] p-2">
        <table class="w-full text-left text-xs border-collapse font-sans">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500 bg-[#f7f7f7]">
              <th class="py-1.5 px-2 font-semibold">Name</th>
              <th class="py-1.5 px-2 font-semibold">Domain</th>
              <th class="py-1.5 px-2 font-semibold">Role</th>
              <th class="py-1.5 px-2 font-semibold">Key Metric</th>
              <th class="py-1.5 px-2 font-semibold text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {renderedProjects.map((project) => (
              <tr 
                class="hover:bg-blue-50 cursor-pointer group xp-project-row" 
                data-project-id={project.id}
              >
                <td class="py-2.5 px-2 font-semibold text-blue-900 flex items-center gap-2">
                  <FileText class="w-4 h-4 text-blue-600 shrink-0" />
                  <span class="group-hover:underline">{project.data.title}</span>
                </td>
                <td class="py-2.5 px-2 text-slate-600">{project.data.category}</td>
                <td class="py-2.5 px-2 text-slate-600">{project.data.role}</td>
                <td class="py-2.5 px-2 font-mono text-emerald-700 font-bold">
                  {project.data.metrics[0]?.value}
                </td>
                <td class="py-2.5 px-2 text-right">
                  <button
                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-[#ece9d8] border border-[#7f9db9] text-[11px] font-semibold text-slate-800 hover:bg-white active:scale-95 cursor-pointer shadow-sm"
                  >
                    <span>Read in IE</span>
                    <Globe class="w-3 h-3 text-blue-600" />
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- WINDOW 3: Internet Explorer 6 (The Full Case Study Reader!) -->
    <div
      id="win-ie-reader"
      class="xp-window absolute top-10 left-32 w-[94vw] sm:w-[720px] rounded-t-lg shadow-2xl border-[3px] border-[#0055ea] bg-[#ece9d8] text-slate-800 z-20 flex flex-col overflow-hidden hidden"
    >
      <!-- Titlebar -->
      <div class="xp-titlebar h-7 px-2 flex items-center justify-between cursor-move select-none bg-gradient-to-r from-[#0058ee] via-[#3593ff] to-[#0058ee] text-white shadow-inner">
        <div class="flex items-center gap-2 font-bold text-xs tracking-wide drop-shadow-[1px_1px_1px_rgba(0,0,0,0.7)] truncate">
          <Globe class="w-3.5 h-3.5 text-blue-200 shrink-0" />
          <span id="ie-titlebar-text">Microsoft Internet Explorer - Case Study Document</span>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button class="win-btn-minimize w-5 h-4.5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/70 flex items-center justify-center text-white font-bold"><Minus class="w-2.5 h-2.5" /></button>
          <button class="win-btn-maximize w-5 h-4.5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/70 flex items-center justify-center text-white font-bold"><Square class="w-2 h-2" /></button>
          <button class="win-btn-close w-5 h-4.5 rounded bg-[#e81123] hover:bg-[#f63847] border border-white/70 flex items-center justify-center text-white font-bold"><X class="w-2.5 h-2.5" /></button>
        </div>
      </div>

      <!-- IE6 Menu Bar -->
      <div class="h-6 px-2 flex items-center gap-3 text-[11px] bg-[#ece9d8] border-b border-[#d8d4c2] text-slate-700">
        <span class="hover:underline cursor-pointer">File</span>
        <span class="hover:underline cursor-pointer">Edit</span>
        <span class="hover:underline cursor-pointer">View</span>
        <span class="hover:underline cursor-pointer">Favorites</span>
        <span class="hover:underline cursor-pointer">Tools</span>
        <span class="hover:underline cursor-pointer">Help</span>
      </div>

      <!-- IE6 Toolbar Icons -->
      <div class="h-9 px-2 flex items-center gap-2 bg-[#ece9d8] border-b border-[#d8d4c2] text-xs">
        <button class="px-2 py-1 rounded hover:bg-white flex items-center gap-1 text-slate-700 cursor-pointer" onclick="document.getElementById('win-projects').style.display='flex';">
          <ArrowLeft class="w-3.5 h-3.5 text-blue-600" />
          <span>Back</span>
        </button>
        <button class="px-2 py-1 rounded hover:bg-white flex items-center gap-1 text-slate-700 cursor-pointer">
          <ArrowRight class="w-3.5 h-3.5 text-slate-400" />
          <span>Forward</span>
        </button>
        <button class="px-2 py-1 rounded hover:bg-white flex items-center gap-1 text-slate-700 cursor-pointer">
          <RotateCw class="w-3.5 h-3.5 text-emerald-600" />
          <span>Refresh</span>
        </button>
        <div class="h-5 w-[1px] bg-slate-400 mx-1"></div>
        <div class="flex items-center gap-1.5 flex-1">
          <span class="text-[11px] text-slate-600 font-semibold">Address:</span>
          <div class="flex-1 px-2 py-0.5 bg-white border border-[#7f9db9] rounded-sm text-xs font-mono text-slate-800 truncate" id="ie-address-bar">
            http://internal.analyst.corp/specs/
          </div>
        </div>
      </div>

      <!-- IE6 Browser Page Content (Full Markdown Case Study Document) -->
      <div class="p-6 bg-white overflow-y-auto max-h-[62vh] text-slate-800 font-sans text-xs">
        {renderedProjects.map((p) => {
          const ContentComponent = p.Content;
          return (
            <div id={`ie-article-${p.id}`} class="ie-case-study-article hidden space-y-4">
              <!-- Header Section -->
              <div class="border-b-2 border-blue-600 pb-4">
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-800 font-semibold text-[10px]">
                    {p.data.category}
                  </span>
                  <span class="text-slate-400">&bull;</span>
                  <span class="text-slate-500 font-mono text-[10px]">{p.data.period}</span>
                </div>
                <h1 class="text-xl sm:text-2xl font-black text-slate-900 leading-tight">
                  {p.data.title}
                </h1>
                <p class="text-slate-600 text-xs mt-2 leading-relaxed">
                  {p.data.description}
                </p>
                <div class="grid grid-cols-2 gap-3 mt-3 p-2.5 rounded bg-[#f5f8ff] border border-blue-200 text-[11px]">
                  <div><strong class="text-blue-950">Role:</strong> {p.data.role}</div>
                  <div><strong class="text-blue-950">Client/Domain:</strong> {p.data.client}</div>
                </div>
              </div>

              <!-- Metrics Row -->
              <div class="grid grid-cols-3 gap-2.5 p-3 rounded-lg bg-[#eaf2fd] border border-blue-300 text-center">
                {p.data.metrics.map(m => (
                  <div>
                    <div class="text-sm sm:text-base font-mono font-black text-blue-800">{m.value}</div>
                    <div class="text-[10px] text-slate-600 mt-0.5 truncate">{m.label}</div>
                  </div>
                ))}
              </div>

              <!-- Markdown Body -->
              <div class="markdown-spec text-slate-800 pt-2">
                <ContentComponent />
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- WINDOW 4: SDLC_Lens.exe -->
    <div
      id="win-sdlc"
      class="xp-window absolute top-16 left-36 w-[92vw] sm:w-[660px] rounded-t-lg shadow-2xl border-[3px] border-[#0055ea] bg-[#ece9d8] text-slate-800 z-10 flex flex-col overflow-hidden hidden"
    >
      <div class="xp-titlebar h-7 px-2 flex items-center justify-between cursor-move select-none bg-gradient-to-r from-[#0058ee] via-[#3593ff] to-[#0058ee] text-white shadow-inner">
        <div class="flex items-center gap-2 font-bold text-xs tracking-wide drop-shadow-[1px_1px_1px_rgba(0,0,0,0.7)] truncate">
          <Layers class="w-3.5 h-3.5 text-cyan-300 shrink-0" />
          <span>SDLC_Lens.exe - [Feature Spec #SA-104]</span>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button class="win-btn-minimize w-5 h-4.5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/70 flex items-center justify-center text-white font-bold"><Minus class="w-2.5 h-2.5" /></button>
          <button class="win-btn-maximize w-5 h-4.5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/70 flex items-center justify-center text-white font-bold"><Square class="w-2 h-2" /></button>
          <button class="win-btn-close w-5 h-4.5 rounded bg-[#e81123] hover:bg-[#f63847] border border-white/70 flex items-center justify-center text-white font-bold"><X class="w-2.5 h-2.5" /></button>
        </div>
      </div>

      <div class="p-2.5 bg-[#ece9d8] border-b border-[#d8d4c2] flex flex-wrap gap-1.5">
        <button class="xp-lens-tab active px-3 py-1 rounded-t text-xs font-bold bg-white border-t-2 border-l-2 border-r-2 border-[#7f9db9] text-blue-900 cursor-pointer" data-view="analyst">
          1. System Analyst Lens
        </button>
        <button class="xp-lens-tab px-3 py-1 rounded-t text-xs font-bold bg-[#ece9d8] border border-[#7f9db9] text-slate-600 hover:bg-white/50 cursor-pointer" data-view="dev">
          2. Developer Feasibility
        </button>
        <button class="xp-lens-tab px-3 py-1 rounded-t text-xs font-bold bg-[#ece9d8] border border-[#7f9db9] text-slate-600 hover:bg-white/50 cursor-pointer" data-view="qa">
          3. QA Test Rigor
        </button>
      </div>

      <div class="p-5 bg-white overflow-y-auto max-h-[60vh] font-sans text-xs">
        <div id="xp-view-analyst" class="space-y-3">
          <div class="p-3 rounded bg-blue-50 border border-blue-200">
            <div class="font-bold text-blue-900 text-sm mb-1">BRD &amp; Business Process Elicitation</div>
            <p class="text-slate-700 leading-relaxed">
              Eliminating double charges and ghost inventory during flash sales through an automated 5-minute stock reservation state machine.
