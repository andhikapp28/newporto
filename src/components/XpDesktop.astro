        e.preventDefault();
        showCertificate(currentCertIndex + 1);
        return;
      }
    }

    // Global window shortcuts (only when not typing)
    if (isTyping) return;

    if (e.key === 'Escape') {
      // Close topmost visible window
      const topWin = getTopmostWindow();
      if (topWin) closeWindow(topWin);
      return;
    }

    if (e.key.toLowerCase() === 'm') {
      // Minimize topmost visible window
      const topWin = getTopmostWindow();
      if (topWin) minimizeWindow(topWin);
      return;
    }
  });

  function getTopmostWindow(): HTMLElement | null {
    let top: HTMLElement | null = null;
