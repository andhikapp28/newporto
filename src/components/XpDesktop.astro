---
import { getCollection, render } from 'astro:content';
import { 
  FileText, 
  Folder, 
  Terminal, 
  Mail, 
  X, 
  Minus, 
  Square, 
  Layers, 
  Network, 
  Workflow, 
  ShieldCheck, 
  Code2, 
  Power, 
  Volume2, 
  VolumeX, 
  Play, 
  Square as StopIcon, 
  SkipForward, 
  SkipBack, 
  Search, 
  ExternalLink, 
  Copy, 
  Check, 
  Globe, 
  ArrowLeft, 
  ArrowRight, 
  RotateCw, 
  Home, 
  HardDrive, 
  Laptop, 
  Disc, 
  Save, 
  FileSpreadsheet, 
  UserCheck, 
  Briefcase, 
  GraduationCap, 
  HelpCircle,
  Download
} from '@lucide/astro';

const allProjects = await getCollection('projects');

const renderedProjects = await Promise.all(
  allProjects.map(async (p) => {
    const { Content } = await render(p);
    return {
      id: p.id,
      data: p.data,
      Content
    };
  })
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const blissImg = `${base}/images/bliss.jpg`;
