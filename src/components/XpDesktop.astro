        class="px-2 py-0.5 rounded text-[10px] font-bold hover:bg-white/20 cursor-pointer flex items-center gap-1"
        onclick="openWindow('win-run'); document.getElementById('xp-start-menu').classList.add('hidden');"
      >
        <Command class="w-3 h-3" />
        <span class="i18n" data-en="Run..." data-id="Jalankan...">Run...</span>
