  SkipForward, 
  SkipBack, 
  Search, 
  ExternalLink, 
  Copy, 
  Check, 
  Globe, 
  ArrowLeft, 
  ArrowRight, 
  RotateCw, 
  HardDrive, 
  Laptop, 
  Disc, 
  Save, 
  Briefcase, 
  Trash2, 
  Dog, 
  StickyNote, 
  Command, 
  Image as ImageIcon, 
  Award, 
  HelpCircle, 
  Download, 
  ZoomIn, 
  ZoomOut, 
  Music,
  Printer 
} from '@lucide/astro';

const allProjects = await getCollection('projects');

const renderedProjects = await Promise.all(
  allProjects.map(async (p) => {
    const { Content } = await render(p);
    return {
      id: p.id,
      data: p.data,
      Content
    };
  })
);

