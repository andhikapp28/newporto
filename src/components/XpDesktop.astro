          <Award class="w-6 h-6 text-amber-600" />
          <span class="absolute -top-1 -right-1 px-1 py-0.2 rounded-full bg-red-600 text-white font-mono text-[8px] font-black animate-pulse shadow">NEW</span>
        </div>
        <span class="text-[11px] font-sans text-yellow-300 drop-shadow-[1px_1px_2px_rgba(0,0,0,0.95)] font-bold leading-tight px-1 i18n" data-en="⚡ Fast-Track" data-id="⚡ Jalur Cepat">⚡ Fast-Track</span>
      </div>

      <!-- Icon 1: Case Studies (E:) -->
      <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1 rounded hover:bg-blue-600/30 active:bg-blue-600/50"
