---
import { getCollection } from 'astro:content';
import { 
  FileText, 
  Folder, 
  Terminal, 
  Mail, 
  Trash2, 
  X, 
  Minus, 
  Square, 
  Layers, 
  Network, 
  Workflow, 
  ShieldCheck, 
  Code2, 
  Power, 
  Volume2, 
  VolumeX, 
  ChevronRight,
  ExternalLink,
  Copy,
  Check,
  Search,
  ArrowRight
} from '@lucide/astro';

const allProjects = await getCollection('projects');
---

<div id="xp-desktop-container" class="fixed inset-0 z-30 hidden flex-col select-none overflow-hidden font-sans">
  <!-- Desktop Background: Classic Windows XP Bliss Landscape (Pure SVG & CSS) -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <svg class="w-full h-full object-cover" preserveAspectRatio="none" viewBox="0 0 1600 1000">
      <defs>
        <!-- Sky Gradient -->
        <linearGradient id="bliss-sky" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#196ee6" />
          <stop offset="45%" stop-color="#499af7" />
          <stop offset="85%" stop-color="#93c5fd" />
          <stop offset="100%" stop-color="#dbeafe" />
        </linearGradient>
        <!-- Rolling Hills Gradients -->
        <linearGradient id="hill-back" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#34a853" />
          <stop offset="60%" stop-color="#248a3d" />
          <stop offset="100%" stop-color="#166534" />
        </linearGradient>
        <linearGradient id="hill-front" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#4ade80" />
          <stop offset="40%" stop-color="#22c55e" />
          <stop offset="100%" stop-color="#15803d" />
        </linearGradient>
        <linearGradient id="hill-sunlight" x1="20%" y1="0%" x2="80%" y2="100%">
          <stop offset="0%" stop-color="#86efac" />
          <stop offset="50%" stop-color="#4ade80" />
          <stop offset="100%" stop-color="#16a34a" />
        </linearGradient>
        <!-- Soft Clouds Filter -->
        <filter id="cloud-blur" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="15" />
        </filter>
      </defs>

      <!-- Sky -->
      <rect width="1600" height="1000" fill="url(#bliss-sky)" />

      <!-- Fluffy White Clouds -->
      <g filter="url(#cloud-blur)" opacity="0.65">
        <ellipse cx="400" cy="180" rx="260" ry="70" fill="#ffffff" />
        <ellipse cx="600" cy="160" rx="190" ry="60" fill="#ffffff" />
        <ellipse cx="1100" cy="220" rx="350" ry="80" fill="#ffffff" />
        <ellipse cx="1350" cy="190" rx="200" ry="50" fill="#ffffff" />
      </g>

      <!-- Distant Hills -->
      <path d="M-100,680 Q300,500 800,600 T1700,650 L1700,1000 L-100,1000 Z" fill="url(#hill-back)" opacity="0.85" />
      <!-- Mid Hills -->
      <path d="M-100,720 Q450,560 1050,700 T1700,720 L1700,1000 L-100,1000 Z" fill="url(#hill-sunlight)" opacity="0.95" />
      <!-- Foreground Lush Green Hill (The iconic Bliss sweep) -->
      <path d="M-100,760 Q380,620 900,750 T1700,740 L1700,1000 L-100,1000 Z" fill="url(#hill-front)" />
    </svg>
  </div>

  <!-- Desktop Icons Grid (Left column) -->
  <div class="relative z-10 p-4 grid grid-flow-col grid-rows-6 gap-y-4 gap-x-6 w-max pointer-events-auto">
    <!-- Icon 1: Welcome_SA.doc -->
    <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-welcome">
      <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-white/90 border border-slate-300 shadow-md group-hover:scale-105 transition-transform">
        <FileText class="w-7 h-7 text-blue-600" />
      </div>
      <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.9)] font-medium leading-tight px-1">
        Welcome_SA.doc
      </span>
    </div>

    <!-- Icon 2: C:\Case_Studies -->
    <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-projects">
      <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-amber-100/90 border border-amber-300 shadow-md group-hover:scale-105 transition-transform">
        <Folder class="w-7 h-7 text-amber-500 fill-amber-400" />
      </div>
      <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.9)] font-medium leading-tight px-1">
        Case_Studies
      </span>
    </div>

    <!-- Icon 3: SDLC_Lens.exe -->
    <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-sdlc">
      <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-slate-900 border border-cyan-400 shadow-md group-hover:scale-105 transition-transform">
        <Layers class="w-6 h-6 text-cyan-400" />
      </div>
      <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.9)] font-medium leading-tight px-1">
        SDLC_Lens.exe
      </span>
    </div>

    <!-- Icon 4: System_Flow.exe -->
    <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-flow">
      <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-indigo-900 border border-indigo-400 shadow-md group-hover:scale-105 transition-transform">
        <Network class="w-6 h-6 text-indigo-300" />
      </div>
      <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.9)] font-medium leading-tight px-1">
        System_Flow.exe
      </span>
    </div>

    <!-- Icon 5: cmd.exe -->
    <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-cmd">
      <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-black border border-slate-600 shadow-md group-hover:scale-105 transition-transform">
        <Terminal class="w-6 h-6 text-emerald-400" />
      </div>
      <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.9)] font-medium leading-tight px-1">
        cmd.exe
      </span>
    </div>

    <!-- Icon 6: Outlook Express / Contact -->
    <div class="xp-desktop-icon group flex flex-col items-center w-20 text-center cursor-pointer p-1.5 rounded hover:bg-blue-600/30 active:bg-blue-600/50" data-open="win-contact">
      <div class="w-11 h-11 mb-1 rounded flex items-center justify-center bg-sky-100 border border-sky-400 shadow-md group-hover:scale-105 transition-transform">
        <Mail class="w-6 h-6 text-sky-600" />
      </div>
      <span class="text-[11px] font-sans text-white drop-shadow-[1px_1px_1px_rgba(0,0,0,0.9)] font-medium leading-tight px-1">
        Outlook_Express
      </span>
    </div>
  </div>

  <!-- ==================== DRAGGABLE WINDOWS ==================== -->

  <!-- WINDOW 1: Welcome_SA.doc (Hero / About) -->
  <div
    id="win-welcome"
    class="xp-window absolute top-12 left-28 w-[92vw] sm:w-[580px] rounded-t-lg shadow-2xl border-[3px] border-[#0055ea] bg-[#ece9d8] text-slate-800 z-20 flex flex-col overflow-hidden"
    style="display: flex;"
  >
    <!-- XP Luna Titlebar -->
    <div class="xp-titlebar h-8 px-2 flex items-center justify-between cursor-move select-none bg-gradient-to-r from-[#0058ee] via-[#3593ff] to-[#0058ee] text-white shadow-inner">
      <div class="flex items-center gap-2 font-bold text-xs tracking-wide drop-shadow-[1px_1px_1px_rgba(0,0,0,0.6)] truncate">
        <FileText class="w-4 h-4 text-blue-200 shrink-0" />
        <span>Welcome_SA.doc - Microsoft WordPad</span>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <button class="win-btn-minimize w-5 h-5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/60 flex items-center justify-center text-white text-xs font-bold leading-none" title="Minimize">
          <Minus class="w-3 h-3" />
        </button>
        <button class="win-btn-maximize w-5 h-5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/60 flex items-center justify-center text-white text-xs font-bold leading-none" title="Maximize">
          <Square class="w-2.5 h-2.5" />
        </button>
        <button class="win-btn-close w-5 h-5 rounded bg-[#e81123] hover:bg-[#f63847] border border-white/60 flex items-center justify-center text-white text-xs font-bold leading-none" title="Close">
          <X class="w-3 h-3" />
        </button>
      </div>
    </div>

    <!-- Menu bar -->
    <div class="h-6 px-2 flex items-center gap-3 text-xs bg-[#ece9d8] border-b border-[#d8d4c2] text-slate-700 select-none">
      <span class="hover:underline cursor-pointer">File</span>
      <span class="hover:underline cursor-pointer">Edit</span>
      <span class="hover:underline cursor-pointer">View</span>
      <span class="hover:underline cursor-pointer">Insert</span>
      <span class="hover:underline cursor-pointer">Format</span>
      <span class="hover:underline cursor-pointer">Help</span>
    </div>

    <!-- Window Body: WordPad Document -->
    <div class="p-6 bg-white overflow-y-auto max-h-[68vh] text-slate-800 leading-relaxed font-sans">
      <!-- Document Banner -->
      <div class="border-b-2 border-blue-600 pb-4 mb-4">
        <div class="text-[11px] font-mono uppercase tracking-widest text-blue-700 font-bold">
          EXECUTIVE TECHNICAL BRIEF &bull; SPECIFICATION SHEET
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 mt-1 leading-tight">
          System Analyst with Hands-on Dev & QA Rigor
        </h2>
        <div class="text-xs text-slate-500 mt-1">
          Bridging Business Requirements, Realistic Engineering & Zero-Defect Delivery
        </div>
      </div>

      <p class="text-xs sm:text-sm text-slate-700 mb-4">
        Welcome to my interactive workspace. Unlike theoretical analysts, my specifications are grounded in <strong>direct development feasibility</strong> (API idempotency, database indexing, latency budgets) and verified through <strong>defensive QA test suites</strong> (Gherkin BDD, boundary assertions, chaos failure cases).
      </p>

      <!-- 3-Pillar Capability Matrix Preview -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 my-4">
        <div class="p-3 rounded border border-blue-200 bg-blue-50/70">
          <div class="font-bold text-xs text-blue-800 mb-1 flex items-center gap-1.5">
            <Workflow class="w-3.5 h-3.5 text-blue-600" />
            <span>1. Analysis (Core)</span>
          </div>
          <p class="text-[11px] text-slate-600 leading-tight">
            BRD/SRS, BPMN 2.0 swimlanes, 3NF ERD database design, and OpenAPI specs.
          </p>
        </div>

        <div class="p-3 rounded border border-indigo-200 bg-indigo-50/70">
          <div class="font-bold text-xs text-indigo-800 mb-1 flex items-center gap-1.5">
            <Code2 class="w-3.5 h-3.5 text-indigo-600" />
            <span>2. Dev Feasibility</span>
          </div>
          <p class="text-[11px] text-slate-600 leading-tight">
            SQL optimization, distributed locking (Redis), REST contracts & rapid PoC.
          </p>
        </div>

        <div class="p-3 rounded border border-emerald-200 bg-emerald-50/70">
          <div class="font-bold text-xs text-emerald-800 mb-1 flex items-center gap-1.5">
            <ShieldCheck class="w-3.5 h-3.5 text-emerald-600" />
            <span>3. QA Rigor</span>
          </div>
          <p class="text-[11px] text-slate-600 leading-tight">
            BDD Given/When/Then scenarios, Postman API collections & negative test matrix.
          </p>
        </div>
      </div>

      <!-- Quick Action Buttons inside Doc -->
      <div class="pt-4 border-t border-slate-200 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <button
            class="xp-btn px-4 py-1.5 rounded text-xs font-semibold bg-[#ece9d8] border border-[#7f9db9] shadow-[inset_-1px_-1px_1px_rgba(0,0,0,0.2),inset_1px_1px_1px_#fff] hover:bg-[#f7f5ec] active:bg-[#e0dccb] cursor-pointer"
            onclick="document.querySelector('[data-open=\'win-projects\']').click()"
          >
            Open Case Studies Folder &rarr;
          </button>
          <button
            class="xp-btn px-4 py-1.5 rounded text-xs font-semibold bg-[#ece9d8] border border-[#7f9db9] shadow-[inset_-1px_-1px_1px_rgba(0,0,0,0.2),inset_1px_1px_1px_#fff] hover:bg-[#f7f5ec] active:bg-[#e0dccb] cursor-pointer"
            onclick="document.querySelector('[data-open=\'win-sdlc\']').click()"
          >
            Launch SDLC Switcher
          </button>
        </div>

        <span class="text-[11px] font-mono text-emerald-700 font-bold">
          &bull; Status: Available for Opportunities
        </span>
      </div>
    </div>
  </div>

  <!-- WINDOW 2: Case Studies (Windows Explorer) -->
  <div
    id="win-projects"
    class="xp-window absolute top-20 left-44 w-[92vw] sm:w-[640px] rounded-t-lg shadow-2xl border-[3px] border-[#0055ea] bg-[#ece9d8] text-slate-800 z-10 flex-col overflow-hidden hidden"
  >
    <div class="xp-titlebar h-8 px-2 flex items-center justify-between cursor-move select-none bg-gradient-to-r from-[#0058ee] via-[#3593ff] to-[#0058ee] text-white shadow-inner">
      <div class="flex items-center gap-2 font-bold text-xs tracking-wide drop-shadow-[1px_1px_1px_rgba(0,0,0,0.6)] truncate">
        <Folder class="w-4 h-4 text-amber-300 fill-amber-300 shrink-0" />
        <span>C:\System_Projects\ - Windows Explorer</span>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <button class="win-btn-minimize w-5 h-5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/60 flex items-center justify-center text-white text-xs font-bold leading-none"><Minus class="w-3 h-3" /></button>
        <button class="win-btn-maximize w-5 h-5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/60 flex items-center justify-center text-white text-xs font-bold leading-none"><Square class="w-2.5 h-2.5" /></button>
        <button class="win-btn-close w-5 h-5 rounded bg-[#e81123] hover:bg-[#f63847] border border-white/60 flex items-center justify-center text-white text-xs font-bold leading-none"><X class="w-3 h-3" /></button>
      </div>
    </div>

    <!-- Address Bar -->
    <div class="h-8 px-2 flex items-center gap-2 text-xs bg-[#ece9d8] border-b border-[#d8d4c2] select-none">
      <span class="text-slate-600 font-medium">Address:</span>
      <div class="flex-1 px-2 py-0.5 bg-white border border-[#7f9db9] rounded-sm text-xs font-mono text-slate-800 flex items-center">
        C:\System_Projects\Case_Studies\
      </div>
    </div>

    <!-- Explorer Content (List view) -->
    <div class="bg-white overflow-y-auto max-h-[65vh] p-2">
      <table class="w-full text-left text-xs border-collapse font-sans">
        <thead>
          <tr class="border-b border-slate-200 text-slate-500 bg-[#f7f7f7]">
            <th class="py-1.5 px-2 font-semibold">Name</th>
            <th class="py-1.5 px-2 font-semibold">Domain</th>
            <th class="py-1.5 px-2 font-semibold">Role</th>
            <th class="py-1.5 px-2 font-semibold">Key Metric</th>
            <th class="py-1.5 px-2 font-semibold text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {allProjects.map((project) => (
            <tr class="hover:bg-blue-50/80 cursor-pointer group">
              <td class="py-2.5 px-2 font-semibold text-blue-900 flex items-center gap-2">
                <FileText class="w-4 h-4 text-blue-600 shrink-0" />
                <a href={`/projects/${project.id}`} class="hover:underline">
                  {project.data.title}
                </a>
              </td>
              <td class="py-2.5 px-2 text-slate-600">{project.data.category}</td>
              <td class="py-2.5 px-2 text-slate-600">{project.data.role}</td>
              <td class="py-2.5 px-2 font-mono text-emerald-700 font-bold">
                {project.data.metrics[0]?.value} ({project.data.metrics[0]?.label})
              </td>
              <td class="py-2.5 px-2 text-right">
                <a
                  href={`/projects/${project.id}`}
                  class="inline-flex items-center gap-1 px-2 py-1 rounded bg-[#ece9d8] border border-[#7f9db9] text-[11px] font-semibold text-slate-800 hover:bg-white"
                >
                  <span>Open Spec</span>
                  <ExternalLink class="w-3 h-3" />
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- WINDOW 3: SDLC_Lens.exe (Interactive Perspective Switcher) -->
  <div
    id="win-sdlc"
    class="xp-window absolute top-16 left-36 w-[92vw] sm:w-[680px] rounded-t-lg shadow-2xl border-[3px] border-[#0055ea] bg-[#ece9d8] text-slate-800 z-10 flex-col overflow-hidden hidden"
  >
    <div class="xp-titlebar h-8 px-2 flex items-center justify-between cursor-move select-none bg-gradient-to-r from-[#0058ee] via-[#3593ff] to-[#0058ee] text-white shadow-inner">
      <div class="flex items-center gap-2 font-bold text-xs tracking-wide drop-shadow-[1px_1px_1px_rgba(0,0,0,0.6)] truncate">
        <Layers class="w-4 h-4 text-cyan-300 shrink-0" />
        <span>SDLC_Lens.exe - [Feature Spec #SA-104]</span>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <button class="win-btn-minimize w-5 h-5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/60 flex items-center justify-center text-white text-xs font-bold leading-none"><Minus class="w-3 h-3" /></button>
        <button class="win-btn-maximize w-5 h-5 rounded bg-[#2c7cfc] hover:bg-[#5294ff] border border-white/60 flex items-center justify-center text-white text-xs font-bold leading-none"><Square class="w-2.5 h-2.5" /></button>
        <button class="win-btn-close w-5 h-5 rounded bg-[#e81123] hover:bg-[#f63847] border border-white/60 flex items-center justify-center text-white text-xs font-bold leading-none"><X class="w-3 h-3" /></button>
      </div>
    </div>

    <!-- Subheader with 3 Tabs -->
    <div class="p-3 bg-[#ece9d8] border-b border-[#d8d4c2] flex flex-wrap gap-2">
      <button class="xp-lens-tab active px-3 py-1 rounded-t text-xs font-bold bg-white border-t-2 border-l-2 border-r-2 border-[#7f9db9] text-blue-900 cursor-pointer" data-view="analyst">
        1. System Analyst Lens
      </button>
      <button class="xp-lens-tab px-3 py-1 rounded-t text-xs font-bold bg-[#ece9d8] border border-[#7f9db9] text-slate-600 hover:bg-white/50 cursor-pointer" data-view="dev">
        2. Developer Feasibility
      </button>
      <button class="xp-lens-tab px-3 py-1 rounded-t text-xs font-bold bg-[#ece9d8] border border-[#7f9db9] text-slate-600 hover:bg-white/50 cursor-pointer" data-view="qa">
        3. QA Test Rigor
      </button>
    </div>

    <!-- Body Content Area -->
    <div class="p-5 bg-white overflow-y-auto max-h-[62vh] font-sans text-xs">
      <!-- Analyst View -->
      <div id="xp-view-analyst" class="space-y-3">
        <div class="p-3 rounded bg-blue-50 border border-blue-200">
          <div class="font-bold text-blue-900 text-sm mb-1">BRD &amp; Business Process Elicitation</div>
          <p class="text-slate-700 leading-relaxed">
            Eliminating double charges and ghost inventory during flash sales through an automated 5-minute stock reservation state machine.
          </p>
        </div>
        <div class="font-mono text-[11px] bg-slate-900 text-slate-200 p-3 rounded space-y-1">
          <div class="text-cyan-400 font-bold">STATE TRANSITION:</div>
          <div>DRAFT &rarr; RESERVED (5m TTL) &rarr; PAID &rarr; DEDUCTED &rarr; FULFILLED</div>
        </div>
        <ul class="space-y-1.5 text-slate-700 list-disc pl-4">
          <li><strong>Anti-Double Charge:</strong> Network retries from customer app within 60s window must resolve to existing payment transaction.</li>
          <li><strong>Reservation TTL:</strong> If payment is unconfirmed after 300s, automatic asynchronous event triggers stock restoration.</li>
        </ul>
      </div>

      <!-- Dev View -->
      <div id="xp-view-dev" class="space-y-3 hidden">
        <div class="p-3 rounded bg-indigo-50 border border-indigo-200">
          <div class="font-bold text-indigo-900 text-sm mb-1">API Contract &amp; Locking Mechanism</div>
          <p class="text-slate-700 leading-relaxed">
            Stateless REST endpoint with strictly enforced idempotency keys and Redis distributed locking.
          </p>
        </div>
        <pre class="font-mono text-[11px] bg-slate-900 text-indigo-300 p-3 rounded overflow-x-auto">POST /api/v1/checkout/charge
Header: X-Idempotency-Key: "uuid_98231a"
Lock: Redis Redlock "SET lock:order:8891 $UUID NX PX 4000"</pre>
        <ul class="space-y-1.5 text-slate-700 list-disc pl-4">
          <li><strong>ACID Concurrency:</strong> PostgreSQL transaction with <code>SELECT ... FOR UPDATE</code> on SKU table to prevent phantom inventory reads.</li>
          <li><strong>Circuit Breaker:</strong> Downstream payment gateway timeout fallback with exponential backoff retry.</li>
        </ul>
      </div>

      <!-- QA View -->
      <div id="xp-view-qa" class="space-y-3 hidden">
        <div class="p-3 rounded bg-emerald-50 border border-emerald-200">
          <div class="font-bold text-emerald-900 text-sm mb-1">BDD Gherkin &amp; Boundary Assertions</div>
          <p class="text-slate-700 leading-relaxed">
            Exhaustive acceptance criteria covering network drop during payment gateway callback.
          </p>
        </div>
        <pre class="font-mono text-[11px] bg-slate-900 text-emerald-300 p-3 rounded overflow-x-auto">Scenario: Duplicate checkout under unstable network
  Given order #8891 has stock reserved
  When client sends 2 identical POST requests concurrently
  Then only 1 ledger entry is written to 'transactions'
  And stock decreases by exactly 1 unit</pre>
        <ul class="space-y-1.5 text-slate-700 list-disc pl-4">
          <li><strong>Negative Test:</strong> Assert HTTP 409 Conflict if checkout is submitted at second 301.</li>
          <li><strong>Tampering Check:</strong> Assert HTTP 401 Unauthorized if webhook HMAC does not match SHA-256 secret.</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- WINDOW 4: System_Flow.exe (Interactive Diagram) -->
  <div
    id="win-flow"
