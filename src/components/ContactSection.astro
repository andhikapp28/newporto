---
import { Mail, Copy, Check, ArrowRight } from '@lucide/astro';
---

<section id="contact" class="py-16 md:py-24 border-t border-slate-800/80 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-cyan-500/30 bg-gradient-to-b from-cyan-950/20 via-slate-900/60 to-slate-950 p-8 sm:p-12 relative overflow-hidden shadow-2xl">
      <!-- Ambient light -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-950/40 text-emerald-400 text-xs font-mono mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Available for New Roles & Architecture Projects</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-100 tracking-tight leading-tight mb-4">
          Need a System Analyst who speaks both Business & Engineering?
        </h2>

        <p class="text-slate-400 text-sm sm:text-base leading-relaxed mb-8">
          Whether you need a full System Requirements Specification (SRS/BRD), an architecture redesign to eliminate bottlenecks, or a technical leader who bridges Dev and QA—let's talk.
        </p>

        <!-- Direct Email Card with Copy button -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-8">
          <div class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl border border-slate-800 bg-slate-950/80 text-xs sm:text-sm font-mono text-slate-200 flex-1">
            <div class="flex items-center gap-2.5 truncate">
              <Mail class="w-4 h-4 text-cyan-400 shrink-0" />
              <span id="email-text">analyst.dipa@example.com</span>
            </div>
            <button
              id="copy-email-btn"
              title="Copy email to clipboard"
              class="p-1.5 rounded-lg border border-slate-700 bg-slate-800/80 hover:bg-slate-700 text-slate-300 transition-colors"
            >
              <Copy class="w-3.5 h-3.5 block" id="copy-icon" />
              <Check class="w-3.5 h-3.5 hidden text-emerald-400" id="copied-icon" />
            </button>
          </div>

          <a
            href="mailto:analyst.dipa@example.com"
            class="px-6 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs sm:text-sm tracking-wide transition-all shadow-md shadow-cyan-500/20 flex items-center justify-center gap-2"
          >
            <span>Send Email</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>

        <!-- Social / External Profiles -->
        <div class="flex flex-wrap items-center gap-4 text-xs font-medium text-slate-400 pt-6 border-t border-slate-800/60">
          <span>Connect via:</span>
          
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-800 bg-slate-900/60 hover:text-cyan-300 hover:border-slate-700 transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current text-cyan-400" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.88 0-1.6.72-1.6 1.6 0 .89.72 1.6 1.6 1.6.89 0 1.6-.71 1.6-1.6 0-.88-.71-1.6-1.6-1.6Z"/>
            </svg>
            <span>LinkedIn Profile</span>
          </a>

          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-800 bg-slate-900/60 hover:text-cyan-300 hover:border-slate-700 transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current text-indigo-400" viewBox="0 0 24 24">
              <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/>
            </svg>
            <span>GitHub Repositories</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = document.getElementById('email-text');
  const copyIcon = document.getElementById('copy-icon');
  const copiedIcon = document.getElementById('copied-icon');

  copyBtn?.addEventListener('click', () => {
    const text = emailText?.innerText || 'analyst.dipa@example.com';
    navigator.clipboard.writeText(text).then(() => {
      copyIcon?.classList.add('hidden');
      copiedIcon?.classList.remove('hidden');

      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        copiedIcon?.classList.add('hidden');
      }, 2000);
    });
  });
</script>
